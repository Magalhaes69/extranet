@page "/list"
@using WebFrontEnd.Services.Auth
@attribute [Authorize]
<PageTitle>Home</PageTitle>


    <!--begin::App Content Header-->
    <div class="app-content-header bg-white pt-2 pb-1">
        <!--begin::Container-->
        <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Dashboard</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item">
                            <a href="#">
                                <i class="fa-regular fa-share-from-square"></i>
                            </a>
                        </li>
                    </ol>
                </div>
            </div>
            <!--end::Row-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::App Content Header-->
    <!-- Filter Section -->

    <div class="app-content">
        <div class="container-fluid">
            <div class="card mb-4 position-relative">
                @if (isOpen)
                {
                    <div class="card-body pb-4">
                        <form class="row g-3 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label">Nº do documento</label>
                                <input type="text" class="form-control" placeholder="Nº do documento">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Código do cliente</label>
                                <input type="text" class="form-control" placeholder="Código do cliente">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Nome do cliente</label>
                                <input type="text" class="form-control" placeholder="Nome do cliente">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Data de entrega</label>
                                <input type="date" class="form-control">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select class="form-select">
                                    <option selected>Em aberto</option>
                                    <option>Fechado</option>
                                    <option>Cancelado</option>
                                </select>
                            </div>
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-sm btn-primary">Ir</button>
                            </div>
                        </form>
                    </div>
                }

                <!-- Floating toggle button -->
                <div class="card-floating-btn">
                    <button type="button" class="btn btn-light shadow" @onclick="ToggleCard">
                        <i class="bi @(isOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
            </div>

            <!-- Top grid options -->
            <div class="mb-2 d-flex justify-content-start grid-options">
                <!-- Right aligned icons -->
                <div class="ms-auto d-flex">
                    <button class="btn btn-link btn-sm custom-btn text-decoration-none">Criar</button>
                    <button class="btn btn-link btn-sm custom-btn text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">Copiar para</button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Opção 1</a></li>
                        <li><a class="dropdown-item" href="#">Opção 2</a></li>
                    </ul>
                    <button class="btn btn-link btn-sm custom-btn text-decoration-none">Fechar</button>
                    <button class="btn btn-link btn-sm custom-btn text-decoration-none">Cancelar</button>
                    <button class="btn btn-link btn-sm custom-btn text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">Pré-visualização</button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Opção 1</a></li>
                    </ul>


                    <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-gear"></i></button>
                    <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-table-cells"></i></button>
                    <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-chart-column"></i></button>
                    <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-list"></i></button>
                </div>
            </div>


            <!-- Table -->
            <div class="card">
                <div class="card-body table-wrapper">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col"><input type="checkbox"></th>
                                <th scope="col">Nº do documento</th>
                                <th scope="col">Código do cliente</th>
                                <th scope="col">Nome do cliente</th>
                                <th scope="col">Nº referência</th>
                                <th scope="col">Data de lançamento</th>
                                <th scope="col">Data de entrega</th>
                                <th scope="col">Total do documento</th>
                                <th scope="col">Impresso</th>
                                <th scope="col">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input type="checkbox"></td>
                                <td>15</td>
                                <td>
                                    <a href="#" class="customer-link">
                                        <i class="bi bi-chevron-right" style="font-size:1rem!important;"></i> CL10002
                                    </a>
                                </td>
                                <td>Abdul Rasid Mamad K...</td>
                                <td>REF001</td>
                                <td>16/03/2026</td>
                                <td>15/03/2026</td>
                                <td>852,00 MZM</td>
                                <td>Original</td>
                                <td>
                                    <button class="btn btn-sm custom-btn"><i class="icon-list-custom bi bi-chevron-right"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td><input type="checkbox"></td>
                                <td>14</td>
                                <td>
                                    <a href="#" class="customer-link">
                                        <i class="bi bi-chevron-right"></i> CL10002
                                    </a>
                                </td>
                                <td>Abdul Rasid Mamad K...</td>
                                <td>REF002</td>
                                <td>16/03/2026</td>
                                <td>16/03/2026</td>
                                <td>881,80 MZM</td>
                                <td>Original</td>
                                <td>
                                    <button class="btn btn-sm custom-btn"><i class="icon-list-custom bi bi-chevron-right"></i></button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7" class="text-end">Total</td>
                                <td>15.079,48 MZM</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>





@code{
    private bool isOpen = true;

    private void ToggleCard()
    {
        isOpen = !isOpen;
    }
}