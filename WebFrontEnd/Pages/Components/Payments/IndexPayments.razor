@page "/payments"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Pagamentos</PageTitle>

<div class="@(ThemeService.CurrentTheme == "dark" ? "bg-dark" : "bg-white") mb-4">
    <div class="mb-4 position-relative">
        <AppContentHeader Title="Gestão de Pagamentos">
            <ButtonList>
                <span class="text-muted small">Consulte o histórico financeiro e faça download de documentos</span>
            </ButtonList>
        </AppContentHeader>

        <div class="app-content">
            <div class="container-fluid">
                <!-- Resumo Financeiro -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card border-success">
                            <div class="card-body">
                                <h6 class="text-muted mb-2">Total Pago</h6>
                                <h3 class="text-success mb-0">@totalPaid.ToString("N2") MZN</h3>
                                <small class="text-muted">@completedCount pagamentos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-warning">
                            <div class="card-body">
                                <h6 class="text-muted mb-2">Pagamentos Pendentes</h6>
                                <h3 class="text-warning mb-0">@totalPending.ToString("N2") MZN</h3>
                                <small class="text-muted">@pendingCount pagamentos</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="text-muted mb-2">Total Geral</h6>
                                <h3 class="mb-0">@((totalPaid + totalPending).ToString("N2")) MZN</h3>
                                <small class="text-muted">@payments.Count pagamentos</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filtros -->
                <div class="row g-3 align-items-end pb-2">
                    <div class="col-md-4">
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Pesquisar por referência..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" @bind="statusFilter">
                            <option value="">Todos os estados</option>
                            <option value="Confirmed">Confirmado</option>
                            <option value="Pending">Pendente</option>
                            <option value="Processing">A processar</option>
                            <option value="Failed">Falhado</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (isLoading)
        {
            <LoadingPage />
        }
        else
        {
            <AppTableComponent TItem="PaymentItem"
                               Items="FilteredPayments"
                               IsLoading="isLoading"
                               ColumnCount="7">

                <Header>
                    <tr class="total-row">
                        <th class="border-end">Referência</th>
                        <th class="border-end text-end">Valor</th>
                        <th class="border-end text-center">Método</th>
                        <th class="border-end text-center">Estado</th>
                        <th class="border-end">Data Vencimento</th>
                        <th class="border-end">Data Pagamento</th>
                        <th class="text-end">Documentos</th>
                    </tr>
                </Header>

                <RowTemplate Context="item">
                    <tr>
                        <td>
                            <code class="small">@item.PaymentReference</code>
                        </td>
                        <td class="text-end">
                            <strong>@item.Amount.ToString("N2")</strong> @item.Currency
                        </td>
                        <td class="text-center">@GetPaymentMethodLabel(item.PaymentMethod)</td>
                        <td class="text-center">
                            <span class="badge @GetStatusBadge(item.Status)">
                                @GetStatusLabel(item.Status)
                            </span>
                        </td>
                        <td>@item.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.PaidAt.HasValue)
                            {
                                @item.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.Status == "Confirmed")
                            {
                                <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light" : "btn-outline-primary")"
                                        @onclick="() => DownloadReceipt(item.Id)">
                                    <i class="bi bi-file-earmark-arrow-down"></i> Recibo
                                </button>
                                @if (!string.IsNullOrWhiteSpace(item.InvoiceUrl))
                                {
                                    <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light" : "btn-outline-success")"
                                            @onclick="() => DownloadInvoice(item.Id)">
                                        <i class="bi bi-receipt"></i> Factura
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                </RowTemplate>

                <LoadingTemplate>
                    <LoadingPage />
                </LoadingTemplate>

                <EmptyTemplate>
                    Ainda não tem pagamentos registados.
                </EmptyTemplate>
            </AppTableComponent>
        }
    </div>
</div>

@code {
    private List<PaymentItem> payments = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;

    private decimal totalPaid;
    private decimal totalPending;
    private int pendingCount;
    private int completedCount;

    private List<PaymentItem> FilteredPayments =>
        payments
            .Where(p => string.IsNullOrWhiteSpace(statusFilter) || p.Status == statusFilter)
            .Where(p => string.IsNullOrWhiteSpace(searchTerm) ||
                        (p.PaymentReference?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (p.TransactionReference?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderByDescending(p => p.DueDate)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Pagamentos");
        PageState.SetTitle("Pagamentos");
        await LoadPaymentsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LayoutState.SetSidebar(true);
    }

    private async Task LoadPaymentsAsync()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetAsync("client/Payments");
            if (response.IsSuccessStatusCode)
            {
                payments = await response.Content.ReadFromJsonAsync<List<PaymentItem>>() ?? new();

                totalPaid = payments.Where(p => p.Status == "Confirmed").Sum(p => p.Amount);
                totalPending = payments.Where(p => p.Status == "Pending").Sum(p => p.Amount);
                pendingCount = payments.Count(p => p.Status == "Pending");
                completedCount = payments.Count(p => p.Status == "Confirmed");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar pagamentos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadReceipt(Guid paymentId)
    {
        try
        {
            var response = await Http.GetAsync($"client/Payments/{paymentId}/receipt");
            if (response.IsSuccessStatusCode)
            {
                // TODO: Implementar download do ficheiro
                ToastService.ShowInfo("Download do recibo iniciado", ThemeService.CurrentTheme);
            }
            else
            {
                ToastService.ShowError("Recibo não disponível", ThemeService.CurrentTheme);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao fazer download: {ex.Message}");
            ToastService.ShowError("Erro ao fazer download", ThemeService.CurrentTheme);
        }
    }

    private async Task DownloadInvoice(Guid paymentId)
    {
        try
        {
            var response = await Http.GetAsync($"client/Payments/{paymentId}/invoice");
            if (response.IsSuccessStatusCode)
            {
                // TODO: Implementar download do ficheiro
                ToastService.ShowInfo("Download da factura iniciado", ThemeService.CurrentTheme);
            }
            else
            {
                ToastService.ShowError("Factura não disponível", ThemeService.CurrentTheme);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao fazer download: {ex.Message}");
            ToastService.ShowError("Erro ao fazer download", ThemeService.CurrentTheme);
        }
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Confirmed" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Processing" => "bg-info text-dark",
        "Failed" => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "Confirmed" => "Confirmado",
        "Pending" => "Pendente",
        "Processing" => "A processar",
        "Failed" => "Falhado",
        _ => status
    };

    private string GetPaymentMethodLabel(string method) => method switch
    {
        "BankTransfer" => "Transferência",
        "MBankWallet" => "M-Bank",
        "MPesa" => "M-Pesa",
        "Card" => "Cartão",
        _ => method
    };

    private class PaymentItem
    {
        public Guid Id { get; set; }
        public decimal Amount { get; set; }
        public string Currency { get; set; } = "MZN";
        public string Status { get; set; } = string.Empty;
        public string PaymentMethod { get; set; } = string.Empty;
        public string? TransactionReference { get; set; }
        public string? PaymentReference { get; set; }
        public DateTime DueDate { get; set; }
        public DateTime? PaidAt { get; set; }
        public string? ReceiptUrl { get; set; }
        public string? InvoiceUrl { get; set; }
    }
}
