@page "/delivery-details/{DocNum:int}"
@using WebFrontEnd.Services.DeliveryNotes.Dto

@attribute [Authorize]

@if (isLoading)
{
    <LoadingPage />
}
else
{
    <div class="bg-white">
        <div class="mb-4 position-relative">
            <AppContentHeader Title=@($"Minha guia de remessa {delivery.DocNum}") />

            <div class="app-content">
                <div class="container-fluid">
                    <!-- Filter Section -->
                    @if (isOpen)
                    {
                        <HeaderDetailsComponent CardCode="@delivery.CardCode"
                                                CardName="@delivery.CardName"
                                                DocCurrency="@delivery.DocCurrency"
                                                Cancelled="@delivery.Cancelled"
                                                DocTotal="@delivery.DocTotal"
                                                DocumentStatus="@delivery.DocumentStatus" />
                    }
                    <!-- Floating toggle button -->
                    <div class="card-floating-btn">
                        <button type="button" class="btn btn-light shadow" @onclick="ToggleCard">
                            <i class="bi @(isOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content-header bg-white pt-2 pb-1 mb-2">
        <div class="container-fluid">
            <div class="top-menu sticky-top bg-white">
                <ul class="nav custom-tabs">
                    <li class="nav-item">
                        <a class="nav-link fw-bold @(activeSection == "geral" ? "active" : "")" @onclick="@(() => ScrollTo("geral"))">Geral </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  fw-bold @(activeSection == "conteudo" ? "active" : "")"
                           @onclick="@(() => ScrollTo("conteudo"))">Conteúdo</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  fw-bold @(activeSection == "logisticaQuotation" ? "active" : "")"
                           @onclick="@(() => ScrollTo("logisticaQuotation"))">Logística</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link  fw-bold @(activeSection == "anexos" ? "active" : "")"
                           @onclick="@(() => ScrollTo("anexos"))">Anexos</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    
    <div class="app-content">
        <div class="container-fluid">

            <div id="geral" class="card mb-2">
                <div class="card-body pt-5">
                    <div class="row mb-3">

                        <label for="inputEmail3" class="col-sm-2 col-form-label">Cliente <span class="text-danger fw-bold">*</span>:</label>
                        <div class="col-sm-4">
                            <InputText class="form-control form-control form-control-sm" @bind-Value="delivery.CardCode" disabled />
                        </div>

                        <label for="inputEmail3" class="col-sm-2 col-form-label">Série/Nº:</label>
                        <div class="col-sm-4">
                            <InputNumber class="form-control form-control form-control-sm" @bind-Value="delivery.Series" disabled />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">Nome:</label>
                        <div class="col-sm-4">
                            <InputText class="form-control form-control-sm" @bind-Value="delivery.CardName" disabled />
                        </div>
                        <label for="inputEmail3" class="col-sm-2 col-form-label">Data de lançamento:</label>
                        <div class="col-sm-4">
                            <InputDate class="form-control form-control-sm" @bind-Value="delivery.DocDate" disabled />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">Pessoa de contacto:</label>
                        <div class="col-sm-4">
                            <div class="position-relative">
                                
                            </div>
                        </div>

                        <label for="inputEmail3" class="col-sm-2 col-form-label">Data de entrega <span class="text-danger fw-bold">*</span>:</label>
                        <div class="col-sm-4">
                            <InputDate class="form-control form-control-sm" @bind-Value="delivery.DocDueDate" disabled />
                        </div>
                    </div>
                </div>
            </div>
            <h5 class="mb-1 sapTitle">Conteúdo</h5>
            <div id="conteudo" class="card mb-5">
                <div class="card-body table-responsive">
                    <h5 class="mb-3 sapTitle-table ">Detalhes</h5>
                    <div class="row">
                        <div class="col-12">
                            <div style="height: 250px;max-height:300px; overflow:auto;">
                                <table class="table table-head-fixed table-hover align-middle text-nowrap">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col"><input type="checkbox"></th>
                                        <th scope="col">#</th>
                                        <th scope="col">Nº do artigo</th>
                                        <th scope="col">Descrição do antigo</th>
                                        <th scope="col">País/região</th>
                                        <th scope="col" class="text-end">Quantidade</th>
                                        <th scope="col" class="text-end">Preço unitário</th>
                                        <th scope="col" class="text-end">% do desconto</th>
                                        <th scope="col" class="text-end"> Preço após desconto</th>
                                        <th scope="col" class="text-end">Código de imposto</th>
                                        <th scope="col" class="text-end">Total(ML)</th>
                                        <th scope="col" class="text-end">Armazém</th>
                                    </tr>
                                </thead>
                                <tbody>
                                        @foreach (var item in delivery.DocumentLines!)
                                    {
                                        <tr>
                                            <td><input type="checkbox"></td>
                                            <td>@item.LineNum</td>
                                            <td>@item.ItemCode</td>
                                            <td>@item.ItemDescription</td>
                                            <td></td>
                                            <td class="text-end">@item.Quantity</td>
                                            <td class="text-end">@item.Price?.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @item.Currency</td>
                                            <td class="text-end"></td>
                                            <td class="text-end"></td>
                                            <td class="text-end">@item.VatGroup</td>
                                            <td class="text-end">@item.LineTotal?.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @item.Currency</td>
                                            <td class="text-end">@item.WarehouseCode</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                        </div>
                        <div class="col-md-6 mt-2">
                            <div class="">
                                <div class="card-header">
                                    <h5 class="card-title mb-0"><b>Resumo total</b></h5>
                                </div>

                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <span>Total antes do desconto:</span>
                                        <span>@totalBefore.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @delivery.DocCurrency</span>
                                    </div>

                                    <div class="d-flex justify-content-between mt-2">
                                        <span>Desconto:</span>
                                        <span>@delivery.DiscountPercent?.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) %</span>
                                        <span>@delivery.TotalDiscount?.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @delivery.DocCurrency</span>
                                    </div>

                                    <div class="d-flex justify-content-between mt-2">
                                        <span>Arrendondamento:</span>
                                        <span>0 MZN</span>
                                    </div>

                                   
                                    <div class="d-flex justify-content-between mt-2">
                                        <span>Imposto:</span>
                                        <span>@delivery.VatSum?.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @delivery.DocCurrency</span>
                                    </div>

                                    <hr />

                                    <div class="d-flex justify-content-between">
                                        <strong>Total:</strong>
                                        <strong>@delivery.DocTotal?.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @delivery.DocCurrency</strong>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <h5 class="mb-1 sapTitle">Logística</h5>
            <div id="logisticaQuotation">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <h5 class="mb-2 sapTitle-table ">Endereço do destinatário</h5>
                            <label for="inputEmail3" class="col-sm-2 col-form-label">Endereço do PN:</label>
                            <div class="col-sm-4">
                                <InputText class="form-control form-control form-control-sm" @bind-Value="delivery.ShipToCode" disabled />
                            </div>

                            <label for="inputEmail3" class="col-sm-2 col-form-label">Endereço do PN:</label>
                            <div class="col-sm-4">

                                <InputText class="form-control form-control form-control-sm" @bind-Value="delivery.PayToCode" disabled />
                            </div>
                        </div>
                        <div class="row">
                            <label for="inputEmail3" class="col-sm-2 col-form-label">Resumo do endereço:</label>
                            <div class="col-sm-4">
                                <InputText class="form-control form-control form-control-sm" @bind-Value="delivery.Address2" disabled />
                            </div>

                            <label for="inputEmail3" class="col-sm-2 col-form-label">Resumo do endereço:</label>
                            <div class="col-sm-4">
                                <InputText class="form-control form-control form-control-sm" @bind-Value="delivery.Address" disabled />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .custom-tabs li a {
        color: #1d2d3e !important;
        cursor: pointer;
    }

    .custom-tabs li a:hover {
            color: #0064d9 !important;
    }

    .custom-tabs .nav-item .active {
        color: #0064d9!important;
    }

    .sapTitle-table {
        color: #1d2d3e;
        font-size: .875rem;
        font-weight: bold;
    }
    
</style>
@code {
    private string activeSection = "geral";
    private bool isOpen = true;
    private bool isCollapsed = true;
    [Parameter]
    public int DocNum { get; set; }
    private bool isLoading;
    private DeliveryNotesDetailsDto delivery = new();

    private decimal totalBefore = 0;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("layoutHelper.toggleSidebar", isCollapsed);
            await js.InvokeVoidAsync("preventDropdownClose");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var CardCode = user.GetCardCode();
        isLoading = true;
        delivery = await DeliveryNotesService.GetByDocEntryDeliveryNotesAsync(CardCode, DocNum);


        totalBefore = delivery.DocumentLines?.Sum(x => x.LineTotal) ?? 0;
        isLoading = false;
    }
    private async Task ScrollTo(string id)
    {
        activeSection = id;
        await js.InvokeVoidAsync("scrollToSection", id);
    }
    private void ToggleCard()
    {
        isOpen = !isOpen;
    }
}
