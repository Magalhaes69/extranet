@implements IDisposable

<div class="card h-100 shadow-sm">
    <img src="@($"{ApiBaseUrl}{Product.ImageUrl}")" class="card-img-top" style="height:200px; object-fit:cover;" />

    <div class="card-body d-flex flex-column">
        <h6 class="card-title">@Product.ItemCode</h6>
        <p class="text-muted small">@Product.ItemName</p>

        <div class="mt-auto">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold small">@Product.ItemPrices.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @Product.Currency</span>

                <button class="btn btn-sm py-0  @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")"
                        @onclick="() => AddToCart()">
                    @LanGeneral["btnAddCart"]
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CatalogItemDto Product { get; set; }
    [Parameter] public EventCallback<CatalogItemDto> OnAddToCart { get; set; }
    [Parameter] public int TPriceBusiness { get; set; }
    private string ApiBaseUrl => Config["ApiSettings:BaseUrl"]!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeService.OnThemeChanged += StateHasChanged;
        }
    }


    private async Task AddToCart()
    {
        await OnAddToCart.InvokeAsync(Product);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}