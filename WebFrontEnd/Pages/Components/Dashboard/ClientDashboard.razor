@page "/dashboard"
@attribute [Authorize]
@inject HttpClient Http
@inject IStringLocalizer<App> L
@using WebFrontEnd.Services.Auth

<PageTitle>@Title</PageTitle>

<div class="@(ThemeService.CurrentTheme == "dark" ? "bg-dark" : "bg-white") mb-4">
    <div class="mb-4 position-relative">
        <AppContentHeader Title="@Title">
            <ButtonList>
                <span class="text-muted small">Bem-vindo ao Portal do Cliente</span>
            </ButtonList>
        </AppContentHeader>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (isLoading)
        {
            <LoadingPage />
        }
        else if (loadFailed)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                Erro ao carregar dashboard. Tente novamente mais tarde.
            </div>
        }
        else if (dashboard != null)
        {
            <!-- Informações do Cliente -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title mb-3">
                                <i class="bi bi-building"></i> @dashboard.CompanyName
                            </h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Código Cliente:</strong> @dashboard.CardCode</p>
                                </div>
                                <div class="col-md-6">
                                    @if (dashboard.IsTrial && dashboard.TrialEndDate.HasValue)
                                    {
                                        var daysLeft = (dashboard.TrialEndDate.Value - DateTime.UtcNow).Days;
                                        var badgeClass = daysLeft <= 7 ? "bg-danger" : "bg-warning text-dark";
                                        <span class="badge @badgeClass">
                                            <i class="bi bi-clock"></i>
                                            Trial - @daysLeft dias restantes
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cards de Métricas - Licenças -->
            <h6 class="mb-3">
                <i class="bi bi-key"></i> Licenças
            </h6>
            <div class="row g-3 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="card text-white bg-primary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2">Total de Licenças</h6>
                                    <h2 class="card-title mb-0">@dashboard.TotalLicenses</h2>
                                </div>
                                <i class="bi bi-grid-3x3-gap fs-1"></i>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-white">
                            <a href="/licenses" class="text-white text-decoration-none small">
                                Ver todas <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="card text-white bg-success">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2">Activas</h6>
                                    <h2 class="card-title mb-0">@dashboard.ActiveLicenses</h2>
                                </div>
                                <i class="bi bi-check-circle fs-1"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="card text-white bg-warning text-dark">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2">A Expirar</h6>
                                    <h2 class="card-title mb-0">@dashboard.ExpiringLicenses</h2>
                                </div>
                                <i class="bi bi-exclamation-triangle fs-1"></i>
                            </div>
                        </div>
                        @if (dashboard.ExpiringLicenses > 0)
                        {
                            <div class="card-footer bg-transparent border-dark">
                                <a href="/licenses?filter=expiring" class="text-dark text-decoration-none small">
                                    Ver detalhes <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="card text-white bg-danger">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2">Expiradas</h6>
                                    <h2 class="card-title mb-0">@dashboard.ExpiredLicenses</h2>
                                </div>
                                <i class="bi bi-x-circle fs-1"></i>
                            </div>
                        </div>
                        @if (dashboard.ExpiredLicenses > 0)
                        {
                            <div class="card-footer bg-transparent border-white">
                                <a href="/licenses?filter=expired" class="text-white text-decoration-none small">
                                    Renovar <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Cards de Métricas - Solicitações -->
            <h6 class="mb-3">
                <i class="bi bi-file-earmark-text"></i> Solicitações
            </h6>
            <div class="row g-3 mb-4">
                <div class="col-xl-4 col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted">Total</h6>
                                    <h3 class="card-title mb-0">@dashboard.TotalRequests</h3>
                                </div>
                                <i class="bi bi-inbox fs-2 text-primary"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-md-4">
                    <div class="card border-warning">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted">Pendentes</h6>
                                    <h3 class="card-title mb-0">@dashboard.PendingRequests</h3>
                                </div>
                                <i class="bi bi-hourglass-split fs-2 text-warning"></i>
                            </div>
                        </div>
                        @if (dashboard.PendingRequests > 0)
                        {
                            <div class="card-footer bg-transparent">
                                <a href="/requests?status=pending" class="text-decoration-none small">
                                    Acompanhar <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-xl-4 col-md-4">
                    <div class="card border-success">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted">Aprovadas</h6>
                                    <h3 class="card-title mb-0">@dashboard.ApprovedRequests</h3>
                                </div>
                                <i class="bi bi-check-circle fs-2 text-success"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cards de Métricas - Pagamentos -->
            <h6 class="mb-3">
                <i class="bi bi-credit-card"></i> Pagamentos
            </h6>
            <div class="row g-3 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Total Pago</h6>
                            <h4 class="card-title mb-0 text-success">
                                @dashboard.TotalPaid.ToString("N2") MZN
                            </h4>
                            <small class="text-muted">@dashboard.TotalPayments pagamentos</small>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="card border-warning">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">Pendentes</h6>
                            <h4 class="card-title mb-0 text-warning">
                                @dashboard.TotalPending.ToString("N2") MZN
                            </h4>
                            <small class="text-muted">@dashboard.PendingPayments pagamentos</small>
                        </div>
                        @if (dashboard.PendingPayments > 0)
                        {
                            <div class="card-footer bg-transparent">
                                <a href="/payments?status=pending" class="text-decoration-none small">
                                    Ver pendentes <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-xl-6 col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-3">Acções Rápidas</h6>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="/licenses" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-key"></i> Minhas Licenças
                                </a>
                                <a href="/requests/new" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-circle"></i> Nova Solicitação
                                </a>
                                <a href="/payments" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-wallet"></i> Histórico Financeiro
                                </a>
                                <a href="/profile" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-person"></i> Meu Perfil
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notificações -->
            @if (dashboard.UnreadNotifications > 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-bell"></i>
                    Você tem <strong>@dashboard.UnreadNotifications</strong> notificações não lidas.
                    <a href="/notifications" class="alert-link">Ver notificações</a>
                </div>
            }
        }
    </div>
</div>

@code {
    private string Title = "Dashboard";
    private bool isLoading = true;
    private bool loadFailed;
    private DashboardData? dashboard;

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle(Title);
        PageState.SetTitle(Title);
        await LoadDashboardAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LayoutState.SetSidebar(true);
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetAsync("client/Dashboard");
            if (response.IsSuccessStatusCode)
            {
                dashboard = await response.Content.ReadFromJsonAsync<DashboardData>();
                loadFailed = false;
            }
            else
            {
                loadFailed = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar dashboard: {ex.Message}");
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private class DashboardData
    {
        public int TotalLicenses { get; set; }
        public int ActiveLicenses { get; set; }
        public int ExpiredLicenses { get; set; }
        public int ExpiringLicenses { get; set; }
        public int PendingRequests { get; set; }
        public int ApprovedRequests { get; set; }
        public int TotalRequests { get; set; }
        public int TotalPayments { get; set; }
        public int PendingPayments { get; set; }
        public decimal TotalPaid { get; set; }
        public decimal TotalPending { get; set; }
        public int UnreadNotifications { get; set; }
        public string CompanyName { get; set; } = string.Empty;
        public string CardCode { get; set; } = string.Empty;
        public bool IsTrial { get; set; }
        public DateTime? TrialEndDate { get; set; }
    }
}
