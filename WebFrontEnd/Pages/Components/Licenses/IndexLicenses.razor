@page "/licenses"
@using WebFrontEnd.Services.Licenses
@inject IStringLocalizer<LicensesApp> L
@inject ILicensesService LicensesApi
@inject AccessService Access
@attribute [Authorize]

<div class="bg-body mb-4">
    <div class="mb-4 position-relative">
        <AppContentHeader Title="@L["titleList"]">
            <ButtonList>
                <a class="btn btn-outline-secondary btn-sm" href="/license-requests">
                    <i class="bi bi-inboxes me-1"></i>@L["btnMyRequests"]
                </a>
                @if (_isManager)
                {
                    <a class="btn btn-primary btn-sm" href="/licenses/request">
                        <i class="bi bi-plus-circle me-1"></i>@L["btnRequestLicense"]
                    </a>
                }
            </ButtonList>
        </AppContentHeader>

        <div class="app-content">
            <div class="container-fluid">

                @if (_loading)
                {
                    <LoadingPage />
                }
                else if (_overview is null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>@L["errLoad"]
                        <button class="btn btn-link btn-sm" @onclick="Load">@L["retry"]</button>
                    </div>
                }
                else
                {
                    <!-- Período de teste -->
                    @if (_overview.IsTrial && _overview.TrialEndDate.HasValue)
                    {
                        var trialDays = LicenseRules.DaysLeft(_overview.TrialEndDate);
                        <div class="alert @(trialDays <= 0 ? "alert-danger" : trialDays <= LicenseRules.ExpiringDays ? "alert-warning" : "alert-info") d-flex align-items-center" role="alert">
                            <i class="bi bi-hourglass-split fs-4 me-3"></i>
                            <div>
                                <strong>@L["trialTitle"]</strong>
                                <div class="small">
                                    @(trialDays <= 0
                                        ? string.Format(L["trialEnded"].Value, _overview.TrialEndDate.Value.ToLocalTime().ToString("dd/MM/yyyy"))
                                        : string.Format(L["trialEnds"].Value, _overview.TrialEndDate.Value.ToLocalTime().ToString("dd/MM/yyyy"), trialDays))
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Alertas de expiração -->
                    @if (_expiredCount > 0)
                    {
                        <div class="alert alert-danger d-flex justify-content-between align-items-center py-2" role="alert">
                            <span><i class="bi bi-x-octagon me-2"></i>@string.Format(L["alertExpired"].Value, _expiredCount)</span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => SetFilter(LicenseStatus.Expired)">@L["btnShow"]</button>
                        </div>
                    }
                    @if (_expiringCount > 0)
                    {
                        <div class="alert alert-warning d-flex justify-content-between align-items-center py-2" role="alert">
                            <span><i class="bi bi-exclamation-triangle me-2"></i>@string.Format(L["alertExpiring"].Value, _expiringCount, LicenseRules.ExpiringDays)</span>
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => SetFilter(LicenseStatus.Expiring)">@L["btnShow"]</button>
                        </div>
                    }

                    <!-- Resumo -->
                    <div class="row g-3 mb-3">
                        @SummaryCard("bi-patch-check", L["summaryTotal"], _overview.Licenses.Count, null, "text-primary")
                        @SummaryCard("bi-check-circle", L["summaryActive"], Count(LicenseStatus.Active), LicenseStatus.Active, "text-success")
                        @SummaryCard("bi-exclamation-triangle", L["summaryExpiring"], _expiringCount, LicenseStatus.Expiring, "text-warning")
                        @SummaryCard("bi-x-circle", L["summaryExpired"], _expiredCount, LicenseStatus.Expired, "text-danger")
                    </div>

                    <!-- Filtros -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm pe-4"
                                       placeholder="@L["search"]"
                                       @bind="_search" @bind:event="oninput" />
                                <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-2 text-muted"></i>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" @bind="_filterValue">
                                <option value="">@L["filterAll"]</option>
                                @foreach (var s in Enum.GetValues<LicenseStatus>())
                                {
                                    <option value="@s">@L[LicenseRules.StateKey(s)]</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5 text-md-end text-muted small pt-1">
                            @string.Format(L["totalLicenses"].Value, Filtered.Count)
                        </div>
                    </div>

                    <!-- Tabela -->
                    <div class="card">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["colLicense"]</th>
                                        <th>@L["colType"]</th>
                                        <th>@L["colStatus"]</th>
                                        <th>@L["colModules"]</th>
                                        <th>@L["colExpiry"]</th>
                                        <th class="text-end">@L["colActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var license in Filtered)
                                    {
                                        var state = LicenseRules.StateOf(license);
                                        var hasOpenRenewal = HasOpenRenewal(license.Id);
                                        <tr>
                                            <td>
                                                <a href="/licenses/details/@license.Id" class="fw-semibold text-decoration-none font-monospace">
                                                    <i class="bi bi-key me-1"></i>@license.MaskedKey
                                                </a>
                                            </td>
                                            <td>@L[LicenseRules.TypeKey(license.LicenseType)]</td>
                                            <td>
                                                <span class="badge @LicenseRules.BadgeClass(state)">@L[LicenseRules.StateKey(state)]</span>
                                                @if (hasOpenRenewal)
                                                {
                                                    <span class="badge text-bg-light border ms-1" title="@L["renewalOpenHint"]">
                                                        <i class="bi bi-arrow-repeat me-1"></i>@L["renewalOpen"]
                                                    </span>
                                                }
                                            </td>
                                            <td>@license.Modules.Count(m => m.IsEnabled) / @license.Modules.Count</td>
                                            <td><LicenseExpiry Date="@LicenseRules.NextExpiry(license)" /></td>
                                            <td class="text-end text-nowrap">
                                                <a class="btn btn-outline-secondary btn-sm py-0" href="/licenses/details/@license.Id" title="@L["btnView"]">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @if (_isManager && LicenseRules.CanRenew(license) && !hasOpenRenewal)
                                                {
                                                    <a class="btn btn-outline-primary btn-sm py-0" href="/licenses/renew/@license.Id" title="@L["btnRenew"]">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }

                                    @if (Filtered.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-5">
                                                <i class="bi bi-patch-check fs-2 d-block mb-2"></i>
                                                @(_overview.Licenses.Count == 0 ? L["noLicenses"] : L["noResults"])
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private LicenseOverviewDto? _overview;
    private List<LicenseRequestDto> _requests = new();
    private bool _loading = true;
    private bool _isManager;
    private string _search = string.Empty;
    private string _filterValue = string.Empty;

    private int _expiredCount => _overview?.Licenses.Count(l => LicenseRules.StateOf(l) == LicenseStatus.Expired) ?? 0;
    private int _expiringCount => _overview?.Licenses.Count(l => LicenseRules.StateOf(l) == LicenseStatus.Expiring) ?? 0;

    private int Count(LicenseStatus s) => _overview?.Licenses.Count(l => LicenseRules.StateOf(l) == s) ?? 0;

    private bool HasOpenRenewal(Guid licenseId) =>
        _requests.Any(r => r.Type == 2 && r.LicenseKeyId == licenseId && LicenseRules.IsOpen(r));

    private List<LicenseDto> Filtered =>
        (_overview?.Licenses ?? new())
            .Where(l => string.IsNullOrEmpty(_filterValue) || LicenseRules.StateOf(l).ToString() == _filterValue)
            .Where(l => string.IsNullOrWhiteSpace(_search)
                || l.MaskedKey.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || l.Modules.Any(m => (m.Name ?? m.Code).Contains(_search, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(l => LicenseRules.NextExpiry(l) ?? DateTime.MaxValue)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle(L["titleList"]);
        _isManager = await Access.IsManagerAsync();
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var overviewTask = LicensesApi.GetOverviewAsync();
        var requestsTask = LicensesApi.GetRequestsAsync();
        _overview = await overviewTask;
        _requests = await requestsTask ?? new();
        _loading = false;
    }

    private void SetFilter(LicenseStatus s) => _filterValue = s.ToString();

    private RenderFragment SummaryCard(string icon, string label, int value, LicenseStatus? filter, string color) => __builder =>
    {
        <div class="col-6 col-xl-3">
            <div class="card h-100 @(filter.HasValue ? "process-card" : "")" role="@(filter.HasValue ? "button" : null)"
                 @onclick="() => { if (filter.HasValue) SetFilter(filter.Value); else _filterValue = string.Empty; }">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi @icon fs-2 @color"></i>
                    <div>
                        <div class="fs-4 fw-semibold lh-1">@value</div>
                        <div class="text-muted small">@label</div>
                    </div>
                </div>
            </div>
        </div>
    };
}
