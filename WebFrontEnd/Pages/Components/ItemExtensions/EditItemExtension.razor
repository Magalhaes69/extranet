@page "/extensions/edit/{ItemId}"
@using WebFrontEnd.Services.ItemExtension.Dto
@implements IDisposable
@inject OrdersCartService CartService

@inject IStringLocalizer<ItemInvoiceModal> LanItem

<!--begin::App Content Header-->
<AppContentHeader Title="@Title" />
<!--end::App Content Header-->

<div class="app-content">
    <div class="container-fluid">

        <EditForm Model="itemExtensionDto" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="card mb-5">
                <div class="card-body">

                    <!-- Row 1 -->
                    <div class="row mb-3">

                        <label class="col-sm-2 col-form-label">
                            @LanItem["itemCode"] <span class="text-danger fw-bold">*</span>:
                        </label>

                        <div class="col-sm-4">
                            <div class="position-relative">
                                <InputText class="form-control form-control-sm" @bind-Value="itemExtensionDto.ItemCode" readonly="true"/>
                            </div>
                            <div class="text-danger">
                                <ValidationMessage For="@(() => itemExtensionDto.ItemCode)" />
                            </div>
                        </div>

                        <label class="col-sm-2 col-form-label">
                            @LanItem["itemDescription"]:
                        </label>

                        <div class="col-sm-4">
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="itemExtensionDto.ItemName" readonly="true" />
                            <div class="text-danger">
                                <ValidationMessage For="@(() => itemExtensionDto.ItemName)" />
                            </div>
                        </div>
                    </div>

                    <!-- Row 2 -->
                    <div class="row mb-3">

                        <label class="col-sm-2 col-form-label">
                            @LanItem["img"]:
                        </label>

                        <div class="col-sm-4">
                            <InputFile class="form-control form-control-sm"
                                       OnChange="HandleFileSelected" />
                        </div>
                    </div>

                    <div class="row">
                        <label class="col-sm-2 col-form-label">

                        </label>
                        <div class="col-sm-6">
                            @if (!string.IsNullOrEmpty(ImagePreview))
                            {
                                <img src="@ImagePreview"
                                     class="img-fluid rounded border"
                                     style="max-height:100px;" />
                            }
                            else if (!string.IsNullOrEmpty(itemExtensionDto.ImageUrl))
                            {
                                <img src="@($"{ApiBaseUrl}{itemExtensionDto.ImageUrl}")"
                                     class="img-fluid rounded border"
                                     style="max-height:100px;" />
                            }
                            else
                            {
                                <img src="@($"{ApiBaseUrl}/images/items/default.png")"
                                     class="img-fluid rounded border"
                                     style="max-height:100px;" />
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="position-fixed bottom-0 p-2 @(ThemeService.CurrentTheme == "dark" ? "bg-dark border border-white" : "border bg-light") shadow-sm rounded-1 mb-2"
                 style="z-index:1050; width:calc(100% - 250px); left:200px; right: 15px!important">

                <div class="d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light" : "btn-secondary")"
                    @onclick="Cancel">
                        @LanGeneral["btnCancel"]
                    </button>

                    @if (ToastService.ShowSaveButton)
                    {
                        <button type="submit"
                                class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light" : "btn-primary")">
                            @LanGeneral["btnSave"]
                        </button>
                    }

                    <BusyButtonComponent cssBtn=@($"btn-sm py-0 {GetWarningButtonClass()}")
                                         ShowBusyButton="@ToastService.ShowBusyButton" />
                </div>

            </div>

        </EditForm>
    </div>
</div>
@if (IsLoading)
{
    <LoadingPage />
}


@code {
    [Parameter] public string ItemId { get; set; }
    private string ItemCode = string.Empty;
    private IBrowserFile? selectedFile;
    private string? ImagePreview;
    private bool IsLoading = false;
    private bool isCollapsed = true;
    private EditItemExtensionDto itemExtensionDto = new();
    private string Title = string.Empty;
    private string GetWarningButtonClass()
    {
        return ThemeService.CurrentTheme == "dark"
            ? "btn-outline-warning text-white border-white"
            : "btn-warning";
    }
    private string TitleItem = string.Empty;
    private string ApiBaseUrl => Config["ApiSettings:BaseUrl"]!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LayoutState.SetSidebar(true);
            await js.InvokeVoidAsync("preventDropdownClose");
            await js.InvokeVoidAsync("initResizableTable");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle(LanGeneral["itemExtensionCreateNavBarTitleNavbar"]);
        Title = LanItem["itemTitle"];
        PageState.SetTitle(LanGeneral["itemExtensionCreateNavBarTitleNavbar"]);
        ThemeService.OnThemeChanged += StateHasChanged;
        IsLoading = true;
        var getItem = await ItemExtensionService.GetByItemId(ItemId);

        if (getItem == null)
            return;

        itemExtensionDto = new EditItemExtensionDto()
        {
            ItemId = getItem.ItemId,
            ItemCode = getItem.ItemCode,
            ItemName = getItem.ItemName!,
            ImageUrl = getItem.ImageUrl,
        };

        IsLoading = false;
    }


    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;

        // Preview
        using var stream = selectedFile.OpenReadStream(5 * 1024 * 1024);
        var buffer = new byte[selectedFile.Size];
        await stream.ReadAsync(buffer);

        ImagePreview = $"data:{selectedFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task HandleSave()
    {

        ToastService.ShowSaveButton = false;
        ToastService.ShowBusyButton = !ToastService.ShowSaveButton;

        var response = await ItemExtensionService.EditAsync(itemExtensionDto, selectedFile);

        if (response.Flag)
        {
            ItemId = response.Data!.ItemId.ToString();
            ToastService.ShowSuccess(LanGeneral["successMessage"], ThemeService.CurrentTheme);

            nav.NavigateTo($"/orders-details/{response.Data.ItemId.ToString()}");
        }
        else
            ToastService.ShowError(LanGeneral["errorMessage"], ThemeService.CurrentTheme);

        return;
    }
    private void Clear()
    {
        ItemCode = string.Empty;
        selectedFile = null;
        ImagePreview = null;
    }

    private void Cancel()
    {
        nav.NavigateTo($"/orders-details/{itemExtensionDto.ItemId.ToString()}");
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}