@page "/extensions/list-item-extension"
@using WebFrontEnd.Services.ItemExtension.Dto
@inject IStringLocalizer<ItemInvoiceModal> LanItem
@implements IDisposable
@attribute [Authorize]

<div class="@(ThemeService.CurrentTheme == "dark" ? "bg-dark" : "bg-white") mb-4 ">
    <div class="mb-4 position-relative">
        <AppContentHeader Title=@Title />

        <div class="app-content">
            <div class="container-fluid">
                <!-- Filter Section -->
                @if (isOpen)
                {
                    <div class="pb-4">
                        <EditForm Model="@Filter" OnValidSubmit="ExecuteFilter" class="row g-3 align-items-end">
                            <!-- Filtro ItemCode -->
                            <div class="col-md-2">
                                <label class="form-label">@LanItem["itemCode"]:</label>
                                <div class="position-relative">

                                    <div class="form-control form-control-sm d-flex align-items-center gap-1 pe-5 filter-input-container">
                                        <!-- Scrollable tags -->
                                        <div class="d-flex gap-1 flex-nowrap overflow-auto filter-tags">
                                            @if (Filter.DynamicFilters is not null)
                                            {
                                                @foreach (var f in Filter.DynamicFilters!.Where(x => x.Field == "ItemCode"))
                                                {
                                                    <span class="badge muilt-tag d-flex align-items-center pointer-filter" @onclick="ToggleItemCodeDropdown">
                                                        @DynamicFilterServices.RenderFilterText(f, AvailableFields)

                                                        <span class="ms-1"
                                                              style="cursor:pointer"
                                                              @onclick:stopPropagation
                                                              @onclick="() => RemoveFilterDynamic(f)">
                                                            <i class="bi bi-x-circle"></i>
                                                        </span>
                                                    </span>
                                                }
                                            }
                                            <!-- Input -->
                                            <input class="border-0 filter-input"
                                                   @bind="InputValue"
                                                   @onclick="ToggleItemCodeDropdown" />

                                            @if (ShowItemCodeDropdown)
                                            {
                                                <div class="dropdown-filter shadow-sm @(ThemeService.CurrentTheme == "dark" ? "bg-dark text-light" : "bg-light text-dark")">

                                                    @if (Filter.DynamicFilters?.Any(x => x.Field == "ItemCode") == true)
                                                    {
                                                        @foreach (var f in Filter.DynamicFilters.Where(x => x.Field == "ItemCode"))
                                                        {
                                                            <div class=" dropdown-item @(ThemeService.CurrentTheme == "dark" ? " dropdown-item-dark" : "") d-flex justify-content-between align-items-center"
                                                                 @onclick="ToggleItemCodeDropdown">

                                                                <span>@DynamicFilterServices.RenderFilterText(f, AvailableFields)</span>

                                                                <i class="bi bi-x-circle text-danger"
                                                                   style="cursor:pointer"
                                                                   @onclick="() => RemoveFilterDynamic(f)">
                                                                </i>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="dropdown-item @(ThemeService.CurrentTheme == "light" ? " text-muted" : "text-light  dropdown-item-dark")">
                                                            @LanGeneral["noFilter"]
                                                        </div>
                                                    }

                                                    <div class="dropdown-divider"></div>

                                                    <!-- Open modal -->
                                                    <div class="dropdown-item text-primary"
                                                         style="cursor:pointer"
                                                         @onclick="OpenItemCodeModal">
                                                        <i class="bi bi-funnel"></i> @LanGeneral["btnAddFilter"]
                                                    </div>

                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Button -->
                                    <button type="button"
                                            @onclick="OpenItemCodeModal"
                                            class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                            style="border: none; background: transparent;">
                                        <i class="bi bi-filter"></i>
                                    </button>
                                </div>
                            </div>
                            <!--Fim-->

                            <!-- Filtro ItemName -->
                            <div class="col-md-2">
                                <label class="form-label">@LanItem["itemCode"]:</label>
                                <div class="position-relative">

                                    <div class="form-control form-control-sm d-flex align-items-center gap-1 pe-5 filter-input-container">
                                        <!-- Scrollable tags -->
                                        <div class="d-flex gap-1 flex-nowrap overflow-auto filter-tags">
                                            @if (Filter.DynamicFilters is not null)
                                            {
                                                @foreach (var f in Filter.DynamicFilters!.Where(x => x.Field == "ItemName"))
                                                {
                                                    <span class="badge muilt-tag d-flex align-items-center pointer-filter" @onclick="ToggleItemNameDropdown">
                                                        @DynamicFilterServices.RenderFilterText(f, AvailableFields)

                                                        <span class="ms-1"
                                                              style="cursor:pointer"
                                                              @onclick:stopPropagation
                                                              @onclick="() => RemoveFilterDynamic(f)">
                                                            <i class="bi bi-x-circle"></i>
                                                        </span>
                                                    </span>
                                                }
                                            }
                                            <!-- Input -->
                                            <input class="border-0 filter-input"
                                                   @bind="InputValue"
                                                   @onclick="ToggleItemNameDropdown" />

                                            @if (ShowItemNameDropdown)
                                            {
                                                <div class="dropdown-filter shadow-sm @(ThemeService.CurrentTheme == "dark" ? "bg-dark text-light" : "bg-light text-dark")">

                                                    @if (Filter.DynamicFilters?.Any(x => x.Field == "ItemName") == true)
                                                    {
                                                        @foreach (var f in Filter.DynamicFilters.Where(x => x.Field == "ItemName"))
                                                        {
                                                            <div class=" dropdown-item @(ThemeService.CurrentTheme == "dark" ? " dropdown-item-dark" : "") d-flex justify-content-between align-items-center"
                                                                 @onclick="ToggleItemNameDropdown">

                                                                <span>@DynamicFilterServices.RenderFilterText(f, AvailableFields)</span>

                                                                <i class="bi bi-x-circle text-danger"
                                                                   style="cursor:pointer"
                                                                   @onclick="() => RemoveFilterDynamic(f)">
                                                                </i>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="dropdown-item @(ThemeService.CurrentTheme == "light" ? " text-muted" : "text-light  dropdown-item-dark")">
                                                            @LanGeneral["noFilter"]
                                                        </div>
                                                    }

                                                    <div class="dropdown-divider"></div>

                                                    <!-- Open modal -->
                                                    <div class="dropdown-item text-primary"
                                                         style="cursor:pointer"
                                                         @onclick="OpenItemNameModal">
                                                        <i class="bi bi-funnel"></i> @LanGeneral["btnAddFilter"]
                                                    </div>

                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Button -->
                                    <button type="button"
                                            @onclick="OpenItemNameModal"
                                            class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                            style="border: none; background: transparent;">
                                        <i class="bi bi-filter"></i>
                                    </button>
                                </div>
                            </div>
                            <!--Fim-->

                            <div class="col-md-1">
                                <button type="submit" class="btn btn-sm @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light" : "btn-primary")">
                                    @LanGeneral["btnSearch"]
                                </button>
                            </div>

                        </EditForm>
                    </div>
                }


                <!-- Floating toggle button -->
                <div class="card-floating-btn">
                    <button type="button" class="btn @(ThemeService.CurrentTheme == "dark" ? "btn-dark" : "btn-light") shadow" @onclick="ToggleCard">
                        <i class="bi @(isOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <GridOptionsComponent>
            <TotalFacturas>
                @DescpTotal (@allItemExtensions!.Where(x => x.Selected).Count()/@allItemExtensions!.Count())
            </TotalFacturas>

            <ButtonOptions>
                <button type="button" class="btn btn-sm text-decoration-none py-0 
                    @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")"
                    @onclick="CreateNew">
                    @LanGeneral["btnCreateNew"]
                </button>

                <button type="button" class="btn btn-sm text-decoration-none py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")"
                        @onclick="ConfirmDelete" disabled="@(!allItemExtensions!.Any(s => s.Selected))">
                    @LanGeneral["btnRemove"]
                </button>
               
                <button class="btn btn-sm text-decoration-none py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")"><i class="fa-solid fa-gear"></i></button>
               
            </ButtonOptions>
        </GridOptionsComponent>

        <!-- Table -->
        <AppTableComponent TItem="ViewItemExtensionDto"
                           Items="allItemExtensions"
                           IsLoading="IsLoading"
                           ColumnCount="10">

            <HeaderGroup>
                <colgroup>
                    <col style="width: 20px;" />
                    <col style="width: 200px;" />
                    <col style="width: 250px;" />
                    <col style="width: 150px;" />
                    <col style="width: 20px;" />
                </colgroup>
            </HeaderGroup>
            <Header>
            <tr>
                <th class="border-end sticky-left"><input type="checkbox" @bind="AllSelected" @bind:event="oninput"></th>
                <th class="border-end" style="position: relative;">@LanItem["itemCode"]<div class="resizer"></div></th>
                <th class="border-end" style="position: relative;">@LanItem["itemDescription"]<div class="resizer"></div></th>
                <th class="text-center border-end" style="position: relative;">@LanItem["itemImg"]<div class="resizer"></div></th>
                <th class="border-end text-end sticky-right"></th>
            </tr>
            </Header>

            <RowTemplate Context="item">
                <tr>
                    <td><InputCheckbox @bind-Value="item.Selected" /></td>

                    <td>@item.ItemCode</td>
                    <td>@item.ItemName</td>
                    <td class="img-col">
                        <img src="@($"{ApiBaseUrl}{item.ImageUrl}")"
                             class="table-img"
                             onerror="this.src='/images/no-image.png'" />
                    </td>
                    <td class="text-center">
                        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")"
                                @onclick="() => SelectItemExtension(item)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </td>
                </tr>
            </RowTemplate>

            <Footer>
            
            </Footer>

            <LoadingTemplate>
                <LoadingPage />
            </LoadingTemplate>

            <EmptyTemplate>
                @LanSales["noRegister"]
            </EmptyTemplate>

        </AppTableComponent>
    </div>
</div>
<!--Confirm delete -->
<ConfirmModal 
    @ref="ConfirmModalRef" 
    BorderColor="border-warning">
    <ModalHeader>
        <h6 class="modal-title fs-5 mx-auto" id="staticBackdropLabel"><i class="bi bi-exclamation-triangle-fill text-warning"></i> @LanGeneral["confirmationTitleItem"]</h6>
    </ModalHeader>
    <ModalBody>
        <p>@LanGeneral["confirmDeleteItemExtension"]</p>
    </ModalBody>
    <ModalFooter>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")" @onclick="ConfirmModalRef.Hide">@LanGeneral["btnCancel"]</button>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")" @onclick="RemoveExtension">@LanGeneral["btnConfirm"]</button>
    </ModalFooter>
</ConfirmModal>
<!--End-->
<!--Modal Filter-->
<ModelToFilter TITem="DynamicFilter"
               @ref="ModalDynamic"
               Title="@DynamicFilterServices.GetFieldLabel(CurrentField, AvailableFields)"
               ITems="@dynamicFilters">

    <Rows Context="item">
        <div class="d-flex gap-2 mb-2">

            <!-- Field -->
            <CustomSelect TItem="string"
                          Items="GetFieldOption(CurrentField!)"
                          @bind-SelectedValue="item.Field" />

            <!-- Operator -->
            <CustomSelect TItem="OperatorType"
                          Items="DynamicFilterServices.GetOperators(CurrentField!, AvailableFields)"
                          @bind-SelectedValue="item.Operator" />

            <!-- Value -->
            @if (RequiresTwoValues(item.Operator))
            {

                <input type="@DynamicFilterServices.GetInputType(AvailableFields.FirstOrDefault(x => x.Name == item.Field)!)"
                       class="form-control form-control-sm"
                       @bind="item.Value1" />


                <input type="@DynamicFilterServices.GetInputType(AvailableFields.FirstOrDefault(x => x.Name == item.Field)!)"
                       class="form-control form-control-sm"
                       @bind="item.Value2" />
            }
            else
            {

                <input type="@DynamicFilterServices.GetInputType(AvailableFields.FirstOrDefault(x => x.Name == item.Field)!)"
                       class="form-control form-control-sm"
                       @bind="item.Value1" />
            }
            <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-danger")"
                    @onclick="() => RemoveFilterOnDynamic(item)">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
    </Rows>

    <AddButton>
        <button class="btn btn-sm py-0  @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-success")" @onclick="() => AddFilterDynamic(CurrentField)">
            @LanGeneral["btnAddFilter"]
        </button>
    </AddButton>

    <Footer>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-secondary") rounded-1" @onclick="CloseModalDynamic">@LanGeneral["btnClose"]</button>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-primary") rounded-1" @onclick="ApplyFiltersDynamic">@LanGeneral["btnOkFilter"]</button>
    </Footer>

</ModelToFilter>
<!--Fim-->
@code {
    private string Title = string.Empty;
    private List<ViewItemExtensionDto> ItemExtensions = new();
    private List<ViewItemExtensionDto> allItemExtensions = new();
    private FilterRequest Filter = new();
    private bool isOpen = true;
    private bool IsLoading = false;
    private string DescpTotal = string.Empty;
    private string ApiBaseUrl => Config["ApiSettings:BaseUrl"]!;
    private ConfirmModal ConfirmModalRef;
    private string CurrentField = string.Empty;

    private bool AllSelected
    {
        get => allItemExtensions!.All(l => l.Selected);
        set
        {
            foreach (var line in allItemExtensions!)
            {
                line.Selected = value;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Title = LanItem["itemTitle"];
        PageState.SetTitle(LanGeneral["itemExtensionCreateNavBarTitleNavbar"]);
        DescpTotal = LanItem["descriptionTotItemExtension"];
        ThemeService.OnThemeChanged += StateHasChanged;

        AvailableFields = FilterMetadataBuilder.Build<ViewItemExtensionDto>();

        Filter = new FilterRequest
        {
            DynamicFilters = new List<DynamicFilter>()
        };

        await Load();
    }

    private async Task Load()
    {
        ItemExtensions = await ItemExtensionService.GetAll();
        allItemExtensions = ItemExtensions.ToList();
    }
    private void CreateNew()
    {
        nav.NavigateTo("/extensions/itemextension");
    }
    private void ToggleCard()
    {
        isOpen = !isOpen;
    }
    
    private void SelectItemExtension(ViewItemExtensionDto item)
    {
        nav.NavigateTo($"/orders-details/{item.ItemId.ToString()}");
    }

    private void ConfirmDelete()
    {
        ConfirmModalRef.Show();
    }
    private async Task RemoveExtension()
    {
        if(ItemExtensions != null)
        {
            if (ItemExtensions.Any(x => x.Selected))
            {
                var getAllSelected = ItemExtensions
                .Where(x => x.Selected)
                .Select(x => x.ItemCode)
                .ToList();



                var response = await ItemExtensionService.RemoveAsync(getAllSelected);
                if(response.Flag)
                {
                    ItemExtensions.RemoveAll(x => getAllSelected.Contains(x.ItemCode));
                    ConfirmModalRef.Hide();
                    StateHasChanged();
                    ToastService.ShowSuccess(LanGeneral["successMessage"], ThemeService.CurrentTheme);
                }
                else
                {
                    ToastService.ShowError(LanGeneral["errorMessage"], ThemeService.CurrentTheme);
                }
            }
        }

        return;
    }

    #region Filter
    private bool ShowItemCodeDropdown = false;
    private bool ShowItemNameDropdown = false;
    private List<FilterField> AvailableFields = new();

    private List<DynamicFilter> dynamicFilters = new()
        {
            new DynamicFilter()
        };

    private ModelToFilter<DynamicFilter>? ModalDynamic;
    private string? InputValue;

    private void ToggleItemCodeDropdown()
    {
        ShowItemCodeDropdown = !ShowItemCodeDropdown;
    }
    private void RemoveFilterDynamic(DynamicFilter item)
    {
        Filter.DynamicFilters!.Remove(item);

        if (!Filter.DynamicFilters.Any(x => x.Field == "ItemCode"))
            ShowItemCodeDropdown = false;

        StateHasChanged();
    }
    private void OpenItemCodeModal()
    {
        CurrentField = "ItemCode";
        try
        {
            dynamicFilters = Filter.DynamicFilters!
            .Where(f => f.Field == CurrentField)
                .Select(f => new DynamicFilter
                    {
                        Field = f.Field,
                        Operator = f.Operator,
                        Value1 = f.Value1,
                        Value2 = f.Value2,
                        Logic = f.Logic
                    })
                .ToList();

            if (!dynamicFilters.Any())
                dynamicFilters.Add(new DynamicFilter { Field = CurrentField });

            ShowItemCodeDropdown = false;
            ModalDynamic!.Show();
        }
        catch
        {
            
        }
    }
    private string GetNameOfField(string? field)
    {
        if (string.IsNullOrEmpty(field))
            return string.Empty;

        var selectedField = AvailableFields.FirstOrDefault(f => f.Name == field);

        if (selectedField == null)
            return string.Empty;

        return selectedField.Label;
    }

    private bool RequiresTwoValues(OperatorType op)
    {
        return op == OperatorType.Between;
    }

    private List<SelectItem<string>> GetFieldOption(string field)
    {
        var f = AvailableFields.FirstOrDefault(x => x.Name == field);

        if (f == null)
            return new();

        return new List<SelectItem<string>>
    {
        new SelectItem<string>
        {
            Value = f.Name,
            Text = f.Label
        }
    };
    }

    private void RemoveFilterOnDynamic(DynamicFilter f)
    {
        dynamicFilters.Remove(f);
    }
    private void AddFilterDynamic(string? field)
    {
        dynamicFilters.Add(new DynamicFilter { Field = field! });
    }
    private void CloseModalDynamic()
    {
        ModalDynamic!.CloseModal();
    }

    private void ApplyFiltersDynamic()
    {
        Filter.DynamicFilters!.RemoveAll(f => f.Field == CurrentField);

        foreach (var f in dynamicFilters)
        {
            f.Field = CurrentField!;
            Filter.DynamicFilters.Add(f);
        }

        ModalDynamic!.CloseModal();
    }

    private void ExecuteFilter()
    {
        allItemExtensions = DynamicFilterHelper.ApplyFilters(ItemExtensions, Filter.DynamicFilters).ToList();
        StateHasChanged();
    }

    private void ToggleItemNameDropdown()
    {
        ShowItemNameDropdown = !ShowItemNameDropdown;
    }
    private void OpenItemNameModal()
    {
        CurrentField = "ItemName";
        try
        {
            dynamicFilters = Filter.DynamicFilters!
            .Where(f => f.Field == CurrentField)
                .Select(f => new DynamicFilter
                {
                    Field = f.Field,
                    Operator = f.Operator,
                    Value1 = f.Value1,
                    Value2 = f.Value2,
                    Logic = f.Logic
                })
                .ToList();

            if (!dynamicFilters.Any())
                dynamicFilters.Add(new DynamicFilter { Field = CurrentField });

            ShowItemCodeDropdown = false;
            ModalDynamic!.Show();
        }
        catch
        {

        }
    }
    #endregion
    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

}
