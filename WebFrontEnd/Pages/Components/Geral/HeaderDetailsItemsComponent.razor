@inject IStringLocalizer<ItemInvoiceModal> LanItem

<div class="summary-flex">
    <div class="summary-item">
        <small class="text-muted d-block">@LanItem["itemCode"]</small>

        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-angle-right text-warning"></i>
            <span class="fw-semibold text-primary">@ItemCode</span>
        </div>

        <small class="text-muted">@LanItem["Description"]:  @ItemName</small>
    </div>

    
    <div class="summary-item">
        <small class="text-muted d-block">@LanItem["itemStock"]</small>
        <div class="fs-4 fw-semibold">
            @UiConverters.ToFormat(TotalStock ?? 0) <small class="text-muted"></small>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string ItemCode { get; set; } = string.Empty;
    [Parameter]
    public string ItemName { get; set; } = string.Empty;
    [Parameter]
    public decimal? TotalStock { get; set; }
}
