@using WebFrontEnd.Services.Auth
@using WebFrontEnd.Services.Items.DTO
@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content rounded-3">

            <!-- Body -->
            <div class="modal-body px-3">

                <!-- Filters/Header -->
                <div class="app-content-header bg-white pt-2 pb-1">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-sm-12">
                                <h4 class="mb-0">Artigos</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4 pb-4">
                    @if (isOpen)
                    {
                        <div class="card-body pb-2">
                            <form class="row g-3 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label">Nº do documento</label>
                                    <input type="text" class="form-control" placeholder="Nº do documento">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Código do cliente</label>
                                    <input type="text" class="form-control" placeholder="Código do cliente">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Nome do cliente</label>
                                    <input type="text" class="form-control" placeholder="Nome do cliente">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Data de entrega</label>
                                    <input type="date" class="form-control">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Status</label>
                                    <select class="form-select">
                                        <option selected>Em aberto</option>
                                        <option>Fechado</option>
                                        <option>Cancelado</option>
                                    </select>
                                </div>
                                <div class="col-md-1">
                                    <button type="submit" class="btn btn-sm btn-primary">Ir</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>

                <!-- Table with fixed height, scroll, and padding -->
                <div style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th scope="col"><input type="checkbox"></th>
                                <th scope="col">Nº do artigo</th>
                                <th scope="col">Descrição do artigo</th>
                                <th class ="text-end" scope="col">Stock disponível</th>
                                <th class="text-end" scope="col">Preço</th>
                                <th scope="col">Grupo de artigos</th>
                            </tr>
                        </thead>
                        <tbody>
                                @foreach (var item in Items)
                                {
                                    <tr>
                                        <td><InputCheckbox @bind-Value="item.Selected" /></td>
                                        <td style="cursor:pointer" @onclick="() => ToggleRow(item)">@item.ItemCode</td>
                                        <td style="cursor:pointer" @onclick="() => ToggleRow(item)">@item.ItemName</td>
                                        <td class="text-end" style="cursor:pointer" @onclick="() => ToggleRow(item)">@item.Quatity</td>
                                        <td class="text-end" style="cursor:pointer" @onclick="() => ToggleRow(item)">@item.ItemPrices!.FirstOrDefault(x => x.PriceList == Tprice)?.Price.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @item.ItemPrices!.FirstOrDefault(x => x.PriceList == 1)?.Currency</td>
                                        <td>@item.ItemsGroupCode</td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer py-1">
                <button class="btn btn-secondary btn-sm rounded-1" @onclick="CloseModal">Fechar</button>
                <button class="btn btn-danger btn-sm rounded-1 btn-select-modal" @onclick="Confirm">Selecionar</button>
            </div>

        </div>
    </div>
</div>
}

@code {

    [Parameter] public EventCallback<List<ItemsDto>> OnItemsSelected { get; set; }
    [Parameter]
    public int? Tprice { get; set; }

    private List<ItemsDto> Items;

    private bool isOpen = true;
    private bool IsVisible = false;

   
    public void Show(List<ItemsDto> items)
    {
        Items = items;

        foreach(var item in Items)
        {
            item.Selected = false;
        };

        IsVisible = true;
        StateHasChanged();
    }

    private void ToggleRow(ItemsDto item)
    {
        item.Selected = !item.Selected;
    }
    public void CloseModal()
    {
        IsVisible = false;
    }

    private async Task Confirm()
    {
        var selectedItems = Items.Where(i => i.Selected).ToList();
        await OnItemsSelected.InvokeAsync(selectedItems);
       
        CloseModal();
    }

    

}
