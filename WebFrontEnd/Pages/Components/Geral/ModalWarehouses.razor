@using WebFrontEnd.Services.Warehouses.Dto

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <div class="modal-content rounded-3">

                <!-- Body -->
                <div class="px-1">
                    <div class="modal-header">
                        <h1 class="modal-title fs-6 fw-bold" id="exampleModalLabel">Modal title</h1>
                    </div>

                    <div class="px-2 mb-4">
                        @if (isOpen)
                        {
                            <div class="pt-3 pb-1">
                                <form class="row g-3 align-items-end">
                                    <div class="col-md-2">
                                        <label class="form-label">Código do armazém</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="Código">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Nome do armazém</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="Nome do armazém">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Localição</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="Localição">
                                    </div>
                                    
                                    <div class="col-md-1">
                                        <button type="submit" class="btn btn-sm btn-primary">Iniciar</button>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                    
                    <div class="modal-body"  style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th scope="col">Código do armazém</th>
                                    <th scope="col">Nome</th>
                                    <th scope="col">Localização</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in warehouses)
                                {
                                    <tr>
                                        <td style="cursor:pointer" @onclick="() => Confirm(item)">@item.WarehouseCode</td>
                                        <td style="cursor:pointer" @onclick="() => Confirm(item)">@item.WarehouseName</td>
                                        <td style="cursor:pointer" @onclick="() => Confirm(item)">@item.Location</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer py-1">
                    <button class="btn btn-secondary btn-sm rounded-1" @onclick="CloseModal">Fechar</button>
                </div>

            </div>
        </div>
    </div>
}

@code {

    [Parameter] public EventCallback<WarehousesDto> OnWarehousesSelected { get; set; }
    private List<WarehousesDto> warehouses;

    private bool isOpen = true;
    private bool IsVisible = false;


    public void Show(List<WarehousesDto> items)
    {
        warehouses = items;
        IsVisible = true;
        StateHasChanged();
    }
    public void CloseModal()
    {
        IsVisible = false;
    }

    private async Task Confirm(WarehousesDto iva)
    {
        await OnWarehousesSelected.InvokeAsync(iva);

        CloseModal();
    }

}
