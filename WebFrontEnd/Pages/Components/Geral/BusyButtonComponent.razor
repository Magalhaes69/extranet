@using WebFrontEnd.Services.Auth
@if (ShowBusyButton)
{
    <button class="btn @cssBtn" type="button" disabled>
        <sapn class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></sapn>
      Wait...
    </button>
}
@code {
    [Parameter] public bool ShowBusyButton { get; set; }
    [Parameter] public string? cssBtn { get; set; }
}
