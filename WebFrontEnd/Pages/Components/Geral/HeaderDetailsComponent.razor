<div class="summary-flex">
    <!-- Cliente -->
    <div class="summary-item">
        <small class="text-muted d-block">Cliente</small>

        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-angle-right text-warning"></i>
            <span class="fw-semibold text-primary">@CardCode</span>
        </div>

        <small class="text-muted">@CardName</small>
    </div>

    <!-- Total -->
    <div class="summary-item">
        <small class="text-muted d-block">Total</small>
        <div class="fs-4 fw-semibold">
            @UiConverters.ToFormat(DocTotal ?? 0) <small class="text-muted">@DocCurrency</small>
        </div>
    </div>

    <!-- Status -->
    <div class="summary-item">
        <small class="text-muted d-block">Status</small>
        <div class="@UiConverters.ToDocStatusClass(DocumentStatus!, Cancelled!) fw-semibold">@UiConverters.ToDocStatus(DocumentStatus!, Cancelled!)</div>
    </div>

    <!-- Crédito -->
    <div class="summary-item flex-grow-1">
        <small class="text-muted d-block">Utilização limite de crédito</small>

        <div class="progress mt-1 rounded-4" style="height: 18px; width:150px;">
            <div class="progress-bar bg-success text-dark" style="width: 50%">
                50%
            </div>
        </div>
    </div>

</div>
<style>
    .summary-flex {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .summary-item {
        flex: 0 0 auto;
        min-width: 140px;
    }

        .summary-item:last-child {
            flex: 1;
        }

    .summary-flex small {
        font-size: 14px;
    }
</style>
@code {
    [Parameter]
    public string CardCode { get; set; } = string.Empty;
    [Parameter]
    public string CardName { get; set; } = string.Empty;


    [Parameter]
    public decimal? DocTotal { get; set; }
    [Parameter]
    public string DocCurrency { get; set; } = string.Empty;
    [Parameter]
    public string DocumentStatus { get; set; } = string.Empty;
    [Parameter]
    public string Cancelled { get; set; } = string.Empty;
}
