<div class="mb-1">
    <label class="col-sm-2 col-form-label">
        @Label
        @if (Required)
        {
            <span class="text-danger fw-bold">*</span>
        }
    </label>
    
    @ChildContent
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Required { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
