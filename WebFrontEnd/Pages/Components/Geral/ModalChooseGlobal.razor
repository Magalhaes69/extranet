@typeparam TITem
@implements IDisposable

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="@(ThemeService.CurrentTheme == "dark" ? "background: rgba(0,0,0,0.5);" : "")">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <div class="modal-content rounded-3 @(ThemeService.CurrentTheme == "dark" ? "modal-dark btn-outline-primary border border-white" : "")" style="position: relative">
                <div class="modal-header py-1">
                    <h5 class="modal-title">
                        Artigos
                    </h5>
                </div>
                <!-- Body -->
                <div class="modal-body">
                    <div class="card mb-4 pb-4">
                        @if (isOpen)
                        {
                            @FilterHeader
                        }
                    </div>

                    @Options
                    <!-- Table with fixed height, scroll, and padding -->
                    <div style="max-height: 400px; overflow-y: auto;">

                        <table class="table table-hover align-middle mb-0">
                            <thead class="sticky-top">
                                @Header
                            </thead>
                            <tbody>
                                @foreach (var item in Items)
                                {
                                   @RowTemplate(item)
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer py-1">
                    @Footer
                </div>

            </div>
        </div>
    </div>
    @if(IsLoding)
    {
        @LoadingTemplate
    }
}

@code {
    private bool IsVisible = false;
    private bool isOpen = true;

    [Parameter] public IEnumerable<TITem> Items { get; set; }
    [Parameter] public string TitleModal { get; set; }
    [Parameter] public bool IsLoding { get; set; }
    [Parameter] public RenderFragment Header { get; set; }
    [Parameter] public RenderFragment Options { get; set; }
    [Parameter] public RenderFragment<TITem> RowTemplate { get; set; }
    [Parameter] public RenderFragment Footer { get; set; }
    [Parameter] public RenderFragment? LoadingTemplate { get; set; }
    [Parameter] public RenderFragment? FilterHeader { get; set; }

   
    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }
    

    public void ShowModal()
    {
        IsVisible = true;
    }

    public void CloseModal()
    {
        IsVisible = false;
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

}
