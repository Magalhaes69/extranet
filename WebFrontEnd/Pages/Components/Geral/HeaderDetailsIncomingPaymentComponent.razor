<div class="summary-flex">
    <!-- DocType -->
    <div class="summary-item">
        <small class="text-muted d-block">@LanIncomingPayments["docType"]</small>
        <div class="d-flex align-items-center gap-2">
            <span class="fw-semibold">@UiConverters.ToDocType("rCustomer")</span>
        </div>
    </div>
    <!-- Cliente -->
    <div class="summary-item">
        <small class="text-muted d-block">@UiConverters.ToDocType("rCustomer")</small>
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-angle-right text-warning"></i>
            <span class="fw-semibold text-primary">@CardCode</span>
        </div>
        <small class="text-muted">@CardName</small>
    </div>
    <!-- Total Transfer-->
    @if (TotalTransfer != 0)
    {
        <div class="summary-item">
            <small class="text-muted d-block">@LanIncomingPayments["totalTransfere"]</small>
            <div class="fs-4 fw-semibold">
                @UiConverters.ToFormat(TotalTransfer ?? 0) <small class="text-muted">@DocCurrency</small>
            </div>
        </div>
    }

    <!-- Total Cash-->
    @if (TotalCash != 0)
    {
        <div class="summary-item">
            <small class="text-muted d-block">@LanIncomingPayments["totalCash"]</small>
        <div class="fs-4 fw-semibold">
                @UiConverters.ToFormat(TotalCash ?? 0) <small class="text-muted">@DocCurrency</small>
        </div>
    </div>
    }

</div>

<style>
    .summary-flex {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .summary-item {
        flex: 0 0 auto;
        min-width: 140px;
    }

        .summary-item:last-child {
            flex: 1;
        }

    .summary-flex small {
        font-size: 14px;
    }
</style>
@code {
    [Parameter]
    public string CardCode { get; set; } = string.Empty;
    [Parameter]
    public string CardName { get; set; } = string.Empty;


    [Parameter]
    public decimal? TotalCash { get; set; } = 0;
    [Parameter]
    public string DocCurrency { get; set; } = string.Empty;
    [Parameter]
    public string DocumentStatus { get; set; } = string.Empty;
    [Parameter]
    public string Cancelled { get; set; } = string.Empty;

    [Parameter]
    public decimal? TotalTransfer { get; set; } = 0;
}
