
@implements IDisposable

<li class="nav-item dropdown">
    <a class="nav-link position-relative" data-bs-toggle="dropdown" style="cursor:pointer;">
        <i class="bi bi-cart"></i>
        @if (ItemCount > 0)
        {
            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
                @ItemCount
            </span>
        }
    </a>

    <div class="dropdown-menu dropdown-menu-end p-0 shadow" style="width:340px;">

        <!-- Header -->
        <div class="p-2 border-bottom">
            <h6 class="mb-0">Cart</h6>
        </div>

        @if (CartServices.CurrentCart?.OrderLineCarts?.Any() == true)
        {
            <!-- Scrollable items -->
            <div style="max-height: 300px; overflow-y: auto;" class="p-2">

                @foreach (var item in CartServices.CurrentCart.OrderLineCarts)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">

                        <!-- Item info -->
                        <div style="flex:1;">
                            <strong>@item.ItemCode</strong><br />
                            <small class="text-muted">
                                @item.Quantity x @UiConverters.ToCurrency(item.UnitPrice, "MZM")
                            </small>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex align-items-center gap-1">

                            <button class="btn btn-sm py-1 btn-outline-secondary"
                                    @onclick="() => Increase(item)">
                                +
                            </button>

                            <button class="btn btn-sm py-1 btn-outline-secondary"
                                    @onclick="() => Decrease(item)">
                                -
                            </button>

                            <!-- Remove button -->
                            <button class="btn btn-sm py-1 btn-outline-danger"
                                    title="Remove item"
                                    @onclick="() => Remove(item)">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    </div>
                }

            </div>

            <!-- Footer -->
            <div class="p-2 border-top">

                <!-- Total -->
                <div class="d-flex justify-content-between mb-2">
                    <strong>Total:</strong>
                    <strong>@UiConverters.ToCurrency(Total, "MZM")</strong>
                </div>

                <!-- Buttons in same line -->
                <div class="d-flex justify-content-between gap-2">
                    <button class="btn btn-sm py-1 btn-outline-primary w-50" @onclick="ViewOrder">
                        View Order
                    </button>

                    <button class="btn btn-sm py-1 w-50 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-success")" 
                    @onclick="FinishOrder">
                        Finish Order
                    </button>
                </div>

            </div>
        }
        else
        {
            <div class="text-center text-muted p-3">
                Cart is empty
            </div>
        }
    </div>
</li>