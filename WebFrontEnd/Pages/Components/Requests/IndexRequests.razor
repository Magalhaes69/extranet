@page "/requests"
@attribute [Authorize]
@inject IRequestsService RequestsService
@inject NavigationManager Navigation
@using WebFrontEnd.Services.Requests
@using WebFrontEnd.Services.Requests.Dtos

<PageTitle>Minhas Solicitações</PageTitle>

<div class="@(ThemeService.CurrentTheme == "dark" ? "bg-dark" : "bg-white") mb-4">
    <div class="mb-4 position-relative">
        <AppContentHeader Title="Minhas Solicitações">
            <ButtonList>
                <button type="button"
                        class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-primary")"
                        @onclick="OpenNewRequestModal">
                    <i class="bi bi-plus-circle"></i> Nova Solicitação
                </button>
            </ButtonList>
        </AppContentHeader>

        <div class="app-content">
            <div class="container-fluid">
                <div class="row g-3 align-items-end pb-2">
                    <div class="col-md-4">
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Pesquisar..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" @bind="statusFilter">
                            <option value="">Todos os estados</option>
                            <option value="Submitted">Submetida</option>
                            <option value="InReview">Em análise</option>
                            <option value="AwaitingPayment">Aguardando pagamento</option>
                            <option value="Approved">Aprovada</option>
                            <option value="Rejected">Rejeitada</option>
                            <option value="Completed">Concluída</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (isLoading)
        {
            <LoadingPage />
        }
        else
        {
            <AppTableComponent TItem="RequestItem"
                               Items="FilteredRequests"
                               IsLoading="isLoading"
                               ColumnCount="5">

                <Header>
                    <tr class="total-row">
                        <th class="border-end">Produto</th>
                        <th class="border-end text-center">Quantidade</th>
                        <th class="border-end text-center">Estado</th>
                        <th class="border-end">Data Submissão</th>
                        <th class="text-end">Acções</th>
                    </tr>
                </Header>

                <RowTemplate Context="item">
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-center">
                            <span class="badge @GetStatusBadge(item.Status)">
                                @GetStatusLabel(item.Status)
                            </span>
                        </td>
                        <td>@item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light" : "btn-outline-primary")"
                                    @onclick="() => ViewDetails(item.Id)">
                                <i class="bi bi-eye"></i> Ver
                            </button>
                        </td>
                    </tr>
                </RowTemplate>

                <LoadingTemplate>
                    <LoadingPage />
                </LoadingTemplate>

                <EmptyTemplate>
                    Ainda não tem solicitações registadas.
                </EmptyTemplate>
            </AppTableComponent>
        }
    </div>
</div>

@* Modal Nova Solicitação *@
@if (showNewRequestModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.35);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content @(ThemeService.CurrentTheme == "dark" ? "modal-dark" : "")">
                <div class="modal-header py-1">
                    <h6 class="modal-title">Nova Solicitação</h6>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Produto / Serviço *</label>
                        <input type="text"
                               class="form-control form-control-sm"
                               @bind="newRequest.ProductName"
                               maxlength="150" />
                        <small class="text-muted">Ex: OneX ERP - Licença Adicional</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Quantidade *</label>
                        <input type="number"
                               class="form-control form-control-sm"
                               @bind="newRequest.Quantity"
                               min="1"
                               max="10000" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notas / Observações</label>
                        <textarea class="form-control form-control-sm"
                                  rows="3"
                                  @bind="newRequest.Notes"
                                  maxlength="500"></textarea>
                        <small class="text-muted">Informações adicionais sobre a solicitação</small>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger py-2">@errorMessage</div>
                    }
                </div>

                <div class="modal-footer py-1">
                    <button type="button"
                            class="btn btn-sm py-0 btn-secondary"
                            disabled="@isSaving"
                            @onclick="CloseNewRequestModal">
                        Cancelar
                    </button>
                    <button type="button"
                            class="btn btn-sm py-0 btn-primary"
                            disabled="@isSaving"
                            @onclick="SubmitNewRequest">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        Enviar Solicitação
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RequestListItemDto> requests = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string statusFilter = string.Empty;
    private bool showNewRequestModal;
    private bool isSaving;
    private string? errorMessage;
    private CreateRequestDto newRequest = new();

    private List<RequestListItemDto> FilteredRequests =>
        requests
            .Where(r => string.IsNullOrWhiteSpace(statusFilter) || r.Status == statusFilter)
            .Where(r => string.IsNullOrWhiteSpace(searchTerm) ||
                        r.ProductName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle("Minhas Solicitações");
        PageState.SetTitle("Minhas Solicitações");
        await LoadRequestsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LayoutState.SetSidebar(true);
    }

    private async Task LoadRequestsAsync()
    {
        isLoading = true;
        try
        {
            requests = await RequestsService.GetAllRequestsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar solicitações: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenNewRequestModal()
    {
        newRequest = new CreateRequestDto { Quantity = 1 };
        errorMessage = null;
        showNewRequestModal = true;
    }

    private void CloseNewRequestModal()
    {
        if (!isSaving)
            showNewRequestModal = false;
    }

    private async Task SubmitNewRequest()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newRequest.ProductName))
        {
            errorMessage = "Indique o produto ou serviço pretendido";
            return;
        }

        if (newRequest.Quantity < 1 || newRequest.Quantity > 10000)
        {
            errorMessage = "Quantidade inválida (1-10000)";
            return;
        }

        isSaving = true;
        try
        {
            var success = await RequestsService.CreateRequestAsync(newRequest);

            if (success)
            {
                ToastService.ShowSuccess("Solicitação enviada com sucesso!", ThemeService.CurrentTheme);
                showNewRequestModal = false;
                await LoadRequestsAsync();
            }
            else
            {
                errorMessage = "Erro ao enviar solicitação. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao enviar solicitação: {ex.Message}");
            errorMessage = "Erro ao enviar solicitação. Tente novamente.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/requests/{id}");
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Submitted" => "bg-info text-dark",
        "InReview" => "bg-warning text-dark",
        "AwaitingPayment" => "bg-warning text-dark",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Completed" => "bg-success",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "Submitted" => "Submetida",
        "InReview" => "Em análise",
        "AwaitingPayment" => "Aguardando pagamento",
        "Approved" => "Aprovada",
        "Rejected" => "Rejeitada",
        "Completed" => "Concluída",
        _ => status
    };
}
