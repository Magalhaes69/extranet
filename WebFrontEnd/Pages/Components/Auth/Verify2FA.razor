@page "/verify"

@using System.Globalization
@using WebFrontEnd.Services.Auth
@inject AuthenticationStateProvider authenticationState
@layout EmptyLayout


<div class="login-box">
    <div class="card card-outline card-warning">
        <div class="card-header">
            <a href="../index2.html"
               class="link-dark text-center link-offset-2 link-opacity-100 link-opacity-50-hover">
                <h1 class="mb-0">Login</h1>
            </a>
        </div>

        <div class="card-body login-card-body">
            <p class="login-box-msg">Digite o código de verificação.</p>
            <p class="login-box-msg">Enviamos um código para o seu e-mail. Digite-o abaixo para continuar.</p>
            <!-- API error alert -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger text-center mt-2">
                    @errorMessage
                </div>
            }

            <EditForm Model="verify" Enhance OnValidSubmit="OnVerify">

                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="input-group mb-1">
                    <div class="form-floating">
                        <InputText @bind-Value="verify.Code" id="code" class="form-control" placeholder="000000" />
                        <label for="code">Code</label>
                    </div>
                    <div class="input-group-text">
                        <span class="bi bi-lock-fill"></span>
                    </div>

                    <div class="invalid-feedback">
                        <ValidationMessage For="@(() => verify.Code)" />
                    </div>
                </div>
                <!--begin::Row-->
                <div class="row">
                    <div class="col-8 d-inline-flex align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" />
                            <label class="form-check-label" for="flexCheckDefault"> Remember Me </label>
                        </div>
                    </div>
                </div>
                <!--end::Row-->
                <div class="social-auth-links text-center mb-3 d-grid gap-2">
                    @if (MessageDialogService.ShowSaveButton)
                    {
                        <button type="submit" class="btn btn-warning fw-bold">
                            <i class="bi bi-box-arrow-in-right"></i> Entrar
                        </button>
                    }
                    <BusyButtonComponent ShowBusyButton="@MessageDialogService.ShowBusyButton" />
                </div>
            </EditForm>
        </div>
        <!-- /.login-card-body -->
    </div>
</div>

@code {
    Verify2FADto verify = new();
    private string? errorMessage;
    [Parameter][SupplyParameterFromQuery] public string returnUrl { get; set; }
    [Parameter][SupplyParameterFromQuery] public string email { get; set; }

    private async Task OnVerify()
    {
        MessageDialogService.ShowSaveButton = false;
        MessageDialogService.ShowBusyButton = !MessageDialogService.ShowSaveButton;
        verify.Email = email;

        var result = await authService.VerifyByCode(verify);

        if (result is not null)
        {
            var authStateProvider = (CustomAuthStateProvider)authenticationState;
            authStateProvider.SetUser(result);

            MessageDialogService.ShowSaveButton = true;
            MessageDialogService.ShowBusyButton = !MessageDialogService.ShowSaveButton;

            await AddTheme(result.Theme, result.Language!);
            if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                //nav.NavigateTo(returnUrl);
                nav.NavigateTo(returnUrl, forceLoad: true);
            }
            else
            {
                //nav.NavigateTo("/");
                nav.NavigateTo("/", forceLoad: true);
            }
        }
        else
        {
            MessageDialogService.ShowSaveButton = true;
            MessageDialogService.ShowBusyButton = !MessageDialogService.ShowSaveButton;
            errorMessage = "Código inválido ou expirado!";
        }
    }


    private async Task AddTheme(string? theme, string Languege)
    {
        // Read stored theme from localStorage or set default
        var storedTheme = await js.InvokeAsync<string>("localStorage.getItem", "theme");

        await js.InvokeVoidAsync("localStorage.setItem", "theme", theme ?? "light");
        await js.InvokeVoidAsync("localStorage.setItem", "blazorCulture.get", Languege ?? "pt-PT");

        string themeToApply = theme ?? "";
        if (storedTheme == "auto")
        {
            bool prefersDark = await js.InvokeAsync<bool>("eval",
                "window.matchMedia('(prefers-color-scheme: dark)').matches");
            themeToApply = prefersDark ? "dark" : "light";
        }

        // Set global theme
        ThemeService.SetTheme(themeToApply);
        await js.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", themeToApply);
        
    }
}
