@page "/login"

@using System.Globalization
@using Microsoft.Extensions.Localization
@using WebFrontEnd.Services.Auth
@inject AuthenticationStateProvider authenticationState
@inject IStringLocalizer<UserApp> UserLan

@layout EmptyLayout


<div class="login-box">
    <div class="card card-outline card-warning">
        <div class="card-header">
            <a href=""
               class="link-dark text-center link-offset-2 link-opacity-100 link-opacity-50-hover">
                <h1 class="mb-0">Login</h1>
            </a>
        </div>

        <div class="card-body login-card-body">
            <p class="login-box-msg">@UserLan["titleLogin"]</p>

            <!-- API error alert -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-2">
                    @errorMessage
                </div>
            }

            <EditForm Model="login" Enhance OnValidSubmit="OnLogin">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="input-group  has-validation mb-1">
                    <div class="form-floating">
                        <InputText type="email"  @bind-Value="login.email" id="loginEmail" class="form-control" placeholder="" />
                        <label for="loginEmail">@UserLan["email"]</label>
                    </div>
                    <div class="input-group-text">
                        <span class="bi bi-envelope"></span>
                    </div>

                    <div class="invalid-feedback">
                        <ValidationMessage For="@(() => login.email)" />
                    </div>
                </div>
                <div class="input-group mb-1">
                    <div class="form-floating">
                        <InputText @bind-Value="login.password" id="loginPassword" type="password" class="form-control" placeholder="" />
                        <label for="loginPassword">@UserLan["password"]</label>
                    </div>
                    <div class="input-group-text">
                        <span class="bi bi-lock-fill"></span>
                    </div>

                    <div class="invalid-feedback">
                        <ValidationMessage For="@(() => login.password)" />
                    </div>
                </div>
                <!--begin::Row-->
                <div class="row">
                    <div class="col-8 d-inline-flex align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" />
                            <label class="form-check-label" for="flexCheckDefault"> @UserLan["remember"] </label>
                        </div>
                    </div>
                </div>
                <!--end::Row-->

                <div class="social-auth-links text-center mb-3 d-grid gap-2">
                    @if (MessageDialogService.ShowSaveButton)
                    {
                        <button type="submit" class="btn btn-warning fw-bold">
                            <i class="bi bi-box-arrow-in-right"></i> @UserLan["btnLogin"]
                        </button>
                    }
                    <BusyButtonComponent cssBtn="btn-warning" ShowBusyButton="@MessageDialogService.ShowBusyButton" />
                </div>
            </EditForm>
            <p class="mb-1">
                <a href="forgot-password.html">@UserLan["forgotPassword"]?</a>
            </p>
           
        </div>
        <!-- /.login-card-body -->
    </div>
</div>



@code {
    LoginDto login = new();
    private string? errorMessage;
    [Parameter][SupplyParameterFromQuery] public string returnUrl { get; set; }
    private async Task OnLogin()
    {

        MessageDialogService.ShowSaveButton = false;
        MessageDialogService.ShowBusyButton = !MessageDialogService.ShowSaveButton;
        var result = await authService.Login(login);

        if (result is not null)
        {
            if (result.Requires2FA)
            {
                MessageDialogService.ShowSaveButton = true;
                MessageDialogService.ShowBusyButton = !MessageDialogService.ShowSaveButton;
                nav.NavigateTo($"/verify?email={result.Email}&returnUrl={returnUrl}");
            }
            else
            {
                var authStateProvider = (CustomAuthStateProvider)authenticationState;
                authStateProvider.SetUser(result);

                MessageDialogService.ShowSaveButton = true;
                MessageDialogService.ShowBusyButton = !MessageDialogService.ShowSaveButton;

                await AddTheme(result.Theme, result.Language!);

                
                if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    //nav.NavigateTo(returnUrl);
                    nav.NavigateTo(returnUrl, forceLoad: true);
                }
                else
                {
                   // nav.NavigateTo("/");
                    nav.NavigateTo("/", forceLoad: true);
                }
            }
        }
        else
        {
            MessageDialogService.ShowSaveButton = true;
            MessageDialogService.ShowBusyButton = !MessageDialogService.ShowSaveButton;
            errorMessage = "Invalid email or password!";
        }
    }

    private async Task AddTheme(string? theme, string Languege)
    {
        var storedTheme = await js.InvokeAsync<string>("localStorage.getItem", "theme");
        await js.InvokeVoidAsync("localStorage.setItem", "theme", theme ?? "light");
        await js.InvokeVoidAsync("localStorage.setItem", "blazorCulture.get", Languege ?? "pt-PT");
        string themeToApply = theme ?? "";
        if (storedTheme == "auto")
        {
            bool prefersDark = await js.InvokeAsync<bool>("eval",
                "window.matchMedia('(prefers-color-scheme: dark)').matches");
            themeToApply = prefersDark ? "dark" : "light";
        }
        // Set global theme
        ThemeService.SetTheme(themeToApply);
        await js.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", themeToApply);

    }
}
