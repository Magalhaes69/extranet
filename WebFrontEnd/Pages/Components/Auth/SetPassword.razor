@page "/set-password"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="card shadow-sm border-0 rounded-4" style="width:100%; max-width:420px;">
    <div class="card-body p-4">

        <h4 class="fw-semibold mb-1">Definir palavra-passe</h4>
        <p class="text-muted small mb-4">@Email</p>

        @if (success)
        {
            <div class="alert alert-success">@message</div>
            <button class="btn btn-primary w-100" @onclick="GoToLogin">Ir para o login</button>
        }
        else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <div class="alert alert-danger">Link inválido ou expirado.</div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Nova palavra-passe</label>
                    <InputText type="password" class="form-control" @bind-Value="model.Password" />
                    <ValidationMessage For="() => model.Password" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar palavra-passe</label>
                    <InputText type="password" class="form-control" @bind-Value="model.ConfirmPassword" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert alert-danger py-2 small">@message</div>
                }

                <button type="submit" class="btn btn-primary w-100" disabled="@busy">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Definir palavra-passe
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly SetPasswordModel model = new();
    private bool busy;
    private bool success;
    private string? message;

    private async Task SubmitAsync()
    {
        busy = true;
        message = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Users/set-password", new
            {
                Email,
                Token,
                model.Password
            });

            // O endpoint devolve sempre 200 com Flag = true: o SetPasswordHandler.Fail()
            // devolve um objecto (não null) e o controller só trata o caso null.
            // O erro real vem em Data.Token; no sucesso, Data.Email é que vem preenchido.
            var result = await response.Content
                .ReadFromJsonAsync<ServiceResponseGeneralPost<SetPasswordResultDto>>();

            var serverError = result?.Data?.Token;

            if (!response.IsSuccessStatusCode || result is null || !result.Flag ||
                !string.IsNullOrWhiteSpace(serverError))
            {
                success = false;
                message = !string.IsNullOrWhiteSpace(serverError)
                    ? serverError
                    : "Não foi possível definir a palavra-passe.";
                return;
            }

            success = true;
            message = string.IsNullOrWhiteSpace(result.Message)
                ? "Palavra-passe definida com sucesso."
                : result.Message;
        }
        catch
        {
            message = "Não foi possível contactar o servidor.";
        }
        finally
        {
            busy = false;
        }
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");

    /// <summary>Espelha o SetPasswordResponse da API: no sucesso vem Email, na falha vem Token com a mensagem.</summary>
    private sealed class SetPasswordResultDto
    {
        public string? Email { get; set; }
        public string? Token { get; set; }
    }

    private sealed class SetPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Indique a palavra-passe.")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "A palavra-passe deve ter pelo menos 6 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Confirme a palavra-passe.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "As palavras-passe não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}