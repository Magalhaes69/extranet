@page "/settings"
@using WebFrontEnd.Services.CultureServices
@using WebFrontEnd.Services.Enums
@inject IStringLocalizer<UserApp> UserLan
@inject IStringLocalizer<App> Lan
@implements IDisposable
@attribute [Authorize]

<div class="bg-body mb-4">
    <AppContentHeader Title="@UserLan["userSettings"]" />

    <div class="app-content">
        <div class="container-fluid">
            <div class="card @(ThemeService.CurrentTheme == "dark" ? "settings-dark" : "")">
                <EditForm Model="appUser" OnValidSubmit="HandleUpdateUser">
                    <!-- Body -->
                    <div class="card-body p-0">
                        <div class="container-fluid">
                            <div class="row g-0 settings-layout">

                                <!-- LEFT SIDEBAR -->
                                <div class="col-12 col-md-4 col-lg-3 @(ThemeService.CurrentTheme == "dark" ? "sidebar" : "")">
                                    <div class="p-1">
                                        <div class="menu-item  @(selectedMenu == MenuItem.Perfil ? (ThemeService.CurrentTheme == "dark" ? "text-light active" : "text-light active") : (ThemeService.CurrentTheme == "dark" ? "text-light" : "text-dark")) " @onclick="@(() => SelectMenu(MenuItem.Perfil))">
                                            <i class="bi bi-person"></i>
                                            <div>
                                                <div>@UserLan["perfilGroup"]</div>
                                                <small>
                                                    <span class="dropdown-item fa-bold">@appUser.FirstName</span>
                                                </small>
                                            </div>
                                        </div>

                                        <div class="menu-item  @(selectedMenu == MenuItem.Aspeto ? (ThemeService.CurrentTheme == "dark" ? "text-light active" : "text-light active") : (ThemeService.CurrentTheme == "dark" ? "text-light" : "text-dark")) " @onclick="@(() => SelectMenu(MenuItem.Aspeto))">
                                            <i class="bi bi-palette"></i>
                                            <div>
                                                <div>@UserLan["appearance"]</div>
                                                <small>@appUser.Theme</small>
                                            </div>
                                        </div>

                                        <div class="menu-item  @(selectedMenu == MenuItem.PaginaPrincipal ? (ThemeService.CurrentTheme == "dark" ? "text-light active" : "text-light active") : (ThemeService.CurrentTheme == "dark" ? "text-light" : "text-dark")) " @onclick="@(() => SelectMenu(MenuItem.PaginaPrincipal))">
                                            <i class="bi bi-house"></i>
                                            <span>
                                               @UserLan["homePage"]
                                               </span>
                                        </div>

                                        <div class="menu-item  @(selectedMenu == MenuItem.Atividades ? (ThemeService.CurrentTheme == "dark" ? "text-light active" : "text-light active") : (ThemeService.CurrentTheme == "dark" ? "text-light" : "text-dark")) " @onclick="@(() => SelectMenu(MenuItem.Atividades))">
                                            <i class="bi bi-activity"></i>
                                            <span>@UserLan["userActivities"]</span>
                                        </div>

                                        <div class="menu-item  @(selectedMenu == MenuItem.Idioma ? (ThemeService.CurrentTheme == "dark" ? "text-light active" : "text-light active") : (ThemeService.CurrentTheme == "dark" ? "text-light" : "text-dark")) " @onclick="@(() => SelectMenu(MenuItem.Idioma))">
                                            <i class="bi bi-globe"></i>
                                            <div>
                                                <div>@UserLan["languageRegion"]</div>
                                                <small>@appUser.Language</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- RIGHT CONTENT -->
                                <div class="col-12 col-md-8 col-lg-9 @(ThemeService.CurrentTheme == "dark" ? "content-area" : "")">
                                    <div class="p-3">
                                        @if (selectedMenu == MenuItem.Aspeto)
                                        {
                                            <h4 class="mb-3">@UserLan["appearance"]</h4>

                                            <ul class="nav nav-tabs mb-3">
                                                <li class="nav-item">
                                                    <button type="button" class="nav-link @(aspectTab == AspectTab.Theme ? "active" : "") @(ThemeService.CurrentTheme == "light" ? "text-dark" : "")"
                                                            @onclick="() => aspectTab = AspectTab.Theme">@UserLan["tabTheme"]</button>
                                                </li>
                                                <li class="nav-item">
                                                    <button type="button" class="nav-link @(aspectTab == AspectTab.View ? "active" : "") @(ThemeService.CurrentTheme == "light" ? "text-dark" : "")"
                                                            @onclick="() => aspectTab = AspectTab.View">@UserLan["tabView"]</button>
                                                </li>
                                            </ul>

                                            @if (aspectTab == AspectTab.Theme)
                                            {
                                                <!-- Theme list -->
                                            <div class="theme-item @(appUser.Theme == ThemeType.light.ToString() ? "selected text-light" : "")" @onclick="() => ChooseTheme(ThemeType.light)">
                                                <div class="circle"></div>
                                                <span>Claro</span>
                                                @if (appUser.Theme == ThemeType.light.ToString())
                                                {
                                                    <i class="bi bi-check-circle-fill check"></i>
                                                }
                                            </div>

                                            <div class="theme-item @(appUser.Theme == ThemeType.dark.ToString() ? "selected text-light" : "") " @onclick="() => ChooseTheme(ThemeType.dark)">
                                                <div class="circle dark"></div>
                                                <span>Escuro</span>
                                                @if (appUser.Theme == ThemeType.dark.ToString())
                                                {
                                                    <i class="bi bi-check-circle-fill check"></i>
                                                }
                                            </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted small mb-3">@UserLan["viewHint"]</p>

                                                <!-- Densidade -->
                                                <h6 class="mt-3">@UserLan["viewDensity"]</h6>
                                                <div class="d-flex flex-wrap gap-2 mb-4">
                                                    @foreach (var (value, key) in new[] { ("comfortable", "densityComfortable"), ("compact", "densityCompact") })
                                                    {
                                                        <button type="button" class="btn btn-sm @(viewDensity == value ? "btn-primary" : "btn-outline-secondary")"
                                                                @onclick="() => SetDensity(value)">
                                                            @UserLan[key]
                                                        </button>
                                                    }
                                                </div>

                                                <!-- Tamanho do texto -->
                                                <h6>@UserLan["viewFontSize"]</h6>
                                                <div class="d-flex flex-wrap gap-2 mb-4">
                                                    @foreach (var (value, key) in new[] { ("small", "fontSmall"), ("normal", "fontNormal"), ("large", "fontLarge") })
                                                    {
                                                        <button type="button" class="btn btn-sm @(viewFont == value ? "btn-primary" : "btn-outline-secondary")"
                                                                @onclick="() => SetFont(value)">
                                                            @UserLan[key]
                                                        </button>
                                                    }
                                                </div>

                                                <!-- Animações -->
                                                <h6>@UserLan["viewMotion"]</h6>
                                                <div class="form-check form-switch mb-1">
                                                    <input class="form-check-input" type="checkbox" role="switch" id="reduce-motion"
                                                           checked="@(viewMotion == "reduced")"
                                                           @onchange="OnMotionChanged" />
                                                    <label class="form-check-label" for="reduce-motion">@UserLan["viewReduceMotion"]</label>
                                                </div>

                                                <div class="mt-4">
                                                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>@UserLan["viewSavedHint"]</small>
                                                    <div class="mt-2">
                                                        <button type="button" class="btn btn-link btn-sm px-0" @onclick="ResetViewAsync">@UserLan["viewReset"]</button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else if (selectedMenu == MenuItem.Perfil)
                                        {
                                            <h4>@UserLan["userData"]</h4>

                                            <div class="card p-3">
                                                <div class="row">
                                                    <label for="inputEmail3" class="coll-12 col-sm-2 col-form-label">@UserLan["firstName"]<span class="text-danger fw-bold">*</span> </label>
                                                    <div class="col-12 col-sm-4">
                                                        <InputText class="form-control form-control-sm" @bind-Value="appUser.FirstName" />
                                                    </div>
                                                    <label for="inputEmail3" class="coll-12 col-sm-2 col-form-label">@UserLan["surname"] <span class="text-danger fw-bold">*</span>: </label>
                                                    <div class="col-12 col-sm-4">
                                                        <InputText class="form-control form-control-sm" @bind-Value="appUser.LastName" />
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <label for="inputNuit" class="coll-12 col-sm-2 col-form-label">@UserLan["nuit"] <span class="text-danger fw-bold">*</span> </label>
                                                    <div class="col-12 col-sm-4">
                                                        <InputText class="form-control form-control-sm" @bind-Value="appUser.Nuit" />
                                                    </div>
                                                    <label for="inputCardCode" class="coll-12 col-sm-2 col-form-label">
                                                        @UserLan["businessPartner"]
                                                         <span class="text-danger fw-bold">*</span>: </label>
                                                    <div class="col-12 col-sm-4">
                                                        <InputText class="form-control form-control-sm" @bind-Value="appUser.CardCode" readonly />
                                                    </div>
                                                </div>


                                                <div class="row">
                                                    <label for="inputEmail" class="coll-12 col-sm-2 col-form-label">@UserLan["email"] <span class="text-danger fw-bold">*</span> </label>
                                                    <div class="col-12 col-sm-4">
                                                        <InputText class="form-control form-control-sm" @bind-Value="appUser.Email" readonly />
                                                    </div>
                                                    <label for="inputCardCode" class="coll-12 col-sm-2 col-form-label">@UserLan["contact"]: </label>
                                                    <div class="col-12 col-sm-4">
                                                        <InputText class="form-control form-control-sm" @bind-Value="appUser.PhoneNumber" />
                                                    </div>
                                                </div>
                                                <div class="row mb-3">

                                                    <label class="col-sm-2 col-form-label">
                                                        @UserLan["img"]:
                                                    </label>

                                                    <div class="col-sm-4">
                                                        <InputFile class="form-control form-control-sm"
                                                                   OnChange="HandleFileSelected" />


                                                    </div>

                                                </div>
                                                <div class="row mb-2">
                                                    <label class="col-sm-2 col-form-label">

                                                    </label>
                                                    <!-- Preview -->
                                                    <div class="col-sm-6">
                                                        @if (!string.IsNullOrEmpty(ImagePreview))
                                                        {
                                                            <img src="@ImagePreview"
                                                                 class="img-fluid rounded border"
                                                                 style="max-height:100px;" />
                                                        }
                                                        else if (!string.IsNullOrEmpty(appUser.ImageUrl))
                                                        {
                                                            <img src="@($"{ApiBaseUrl}{appUser.ImageUrl}")"
                                                                 class="img-fluid rounded border"
                                                                 style="max-height:100px;" />
                                                        }
                                                        else
                                                        {
                                                            <img src="@($"{ApiBaseUrl}/images/users/default-user.png")"
                                                                 class="img-fluid rounded border"
                                                                 style="max-height:100px;" />
                                                        }
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-6 col-sm-4">
                                                        <span>@UserLan["twoFactorAuth"]</span>
                                                    </div>
                                                    <div class="col-6 col-sm-6">
                                                        <div class="form-check form-switch m-0">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   id="verify2FA"
                                                                   @bind="appUser.TwoFactorEnabled" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-12">
                                                        <small class="text-muted">
                                                            @(appUser.TwoFactorEnabled? UserLan["twoFactorMessage1"] : UserLan["twoFactorMessage2"])
                                                        </small>
                                                    </div>
                                                </div>
                                    </div>
                                        }
                                        else if (selectedMenu == MenuItem.Atividades)
                                        {
                                            <h4>
                                                @UserLan["userActivities"]</h4>
                                            <div class="card p-3">
                                                <p>@UserLan["userActivitiesDesc"]</p>
                                            </div>
                                        }
                                        else if (selectedMenu == MenuItem.PaginaPrincipal)
                                        {
                                            <h4>@UserLan["homePage"]</h4>
                                            <div class="card p-3">
                                                <p>Configurações da página inicial.</p>
                                            </div>
                                        }
                                        else if (selectedMenu == MenuItem.Idioma)
                                        {
                                            <h4>@UserLan["languageRegion"]</h4>
                                            <div class="card p-3">
                                                <p>@UserLan["languageRegionDesc"].</p>
                                                <div class="row mb-3">
                                                    <label for="inputIdiomaRegion" class="col-sm-2 col-form-label">@UserLan["idiomaRegion"]: </label>
                                                   
                                                    <div class="col-sm-8">
                                                        <InputSelect id="inputIdiomaRegion" class="form-select form-select-sm" @bind-Value="appUser.Language">
                                                            @foreach (var culture in LocalizerSettings.SupportedCultureWithName)
                                                            {
                                                                @if (appUser.Language != null && culture == SelectedCulture)
                                                                {
                                                                    <option value="@culture.Culture" selected>@culture.Name</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@culture.Culture">@culture.Name</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                        <small class="form-text text-muted">@UserLan["languageRegionNote"]</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Footer -->
                    <div class="card-footer d-flex justify-content-end gap-2 py-2">
                        <button class="btn py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-primary border border-white text-white" : "btn-secondary")  btn-sm rounded-1" @onclick="ShowFechar">@Lan["btnClose"]</button>
                        @if (ToastService.ShowSaveButton)
                        {
                            <button class="btn py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-primary border border-white text-white" : "btn-select-modal")  btn-sm rounded-1 ">@Lan["btnSave"]</button>
                        }
                        <BusyButtonComponent cssBtn=@($"btn-sm py-0 {GetWarningButtonClass()}")
                        ShowBusyButton="@ToastService.ShowBusyButton" />
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private AppUserCreateDto appUser = new();
    CultureWithName SelectedCulture = null!;
    private MenuItem selectedMenu = MenuItem.Perfil;
    private IBrowserFile? selectedFile;
    private string? ImagePreview;
    public enum MenuItem
    {
        Aspeto,
        PaginaPrincipal,
        Atividades,
        Idioma,
        Perfil
    }
    private string ApiBaseUrl => Config["ApiSettings:BaseUrl"]!;

    private void SelectMenu(MenuItem menu)
    {
        selectedMenu = menu;
    }

    private async Task LoadProfile()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        appUser.Email = user.GetEmail();

        var result = await authService.Profile(appUser.Email);

        if (result is not null)
        {
            appUser.FirstName = result.FirstName;
            appUser.LastName = result.LastName;
            appUser.Nuit = result.Nuit;
            appUser.CardCode = result.CardCode;
            appUser.PhoneNumber = result.PhoneNumber;
            appUser.Theme = result.Theme;
            appUser.Language = result.Language;
            appUser.TwoFactorEnabled = result.TwoFactorEnabled;
            appUser.Id = result.Id;
            appUser.ImageUrl = result.ImageUrl;
        }
        StateHasChanged();
    }

    // Fechar = voltar à página principal (as definições já não são uma janela).
    private void ShowFechar() => nav.NavigateTo("/");

    private string GetWarningButtonClass()
    {
        return ThemeService.CurrentTheme == "dark"
            ? "btn-outline-warning text-white border-white"
            : "btn-warning";
    }
    protected override async Task OnInitializedAsync()
    {

        PageTitleService.SetTitle(UserLan["userSettings"]);
        ToastService.OnChange += StateHasChanged;
        ThemeService.OnThemeChanged += StateHasChanged;
        await LoadProfile();
        await LoadViewAsync();
    }

    private async Task ChooseTheme(ThemeType theme)
    {
        appUser.Theme = theme.ToString();

        // Aplica já o tema escolhido; o botão Guardar grava-o no perfil.
        var value = theme.ToString();
        await js.InvokeVoidAsync("localStorage.setItem", "theme", value);
        await js.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", value);
        ThemeService.SetTheme(value);
    }

    // ---- Definições de visualização (guardadas no navegador e aplicadas a toda a aplicação)
    private enum AspectTab { Theme, View }
    private AspectTab aspectTab = AspectTab.Theme;
    private string viewDensity = "comfortable";
    private string viewFont = "normal";
    private string viewMotion = "normal";

    private async Task LoadViewAsync()
    {
        viewDensity = await js.InvokeAsync<string?>("localStorage.getItem", "view.density") ?? "comfortable";
        viewFont = await js.InvokeAsync<string?>("localStorage.getItem", "view.font") ?? "normal";
        viewMotion = await js.InvokeAsync<string?>("localStorage.getItem", "view.motion") ?? "normal";
    }

    private Task SetDensity(string value) => SetViewAsync("density", value);
    private Task SetFont(string value) => SetViewAsync("font", value);
    private Task OnMotionChanged(ChangeEventArgs e) =>
        SetViewAsync("motion", e.Value is true ? "reduced" : "normal");

    private async Task SetViewAsync(string name, string value)
    {
        switch (name)
        {
            case "density": viewDensity = value; break;
            case "font": viewFont = value; break;
            case "motion": viewMotion = value; break;
        }
        await js.InvokeVoidAsync("localStorage.setItem", $"view.{name}", value);
        await js.InvokeVoidAsync("applyViewSettings");
    }

    private async Task ResetViewAsync()
    {
        viewDensity = "comfortable";
        viewFont = "normal";
        viewMotion = "normal";
        foreach (var name in new[] { "density", "font", "motion" })
            await js.InvokeVoidAsync("localStorage.removeItem", $"view.{name}");
        await js.InvokeVoidAsync("applyViewSettings");
    }

    private async Task HandleUpdateUser()
    {
        ToastService.ShowSaveButton = false;
        ToastService.ShowBusyButton = !ToastService.ShowSaveButton;

        var response = await AuthService.UpdateProfile(appUser, selectedFile);
        if (response.Flag)
        {
            ToastService.ShowSuccess(Lan["successMessage"], ThemeService.CurrentTheme);

            var storedTheme = await js.InvokeAsync<string>("localStorage.getItem", "theme");

            if (storedTheme != appUser.Theme)
            {
                string themeToApply = appUser.Theme ?? "";
                await js.InvokeVoidAsync("localStorage.setItem", "theme", appUser.Theme ?? "light");
                ThemeService.SetTheme(themeToApply);
                await js.InvokeVoidAsync("document.documentElement.setAttribute", "data-bs-theme", themeToApply);

                StateHasChanged();
            }

            var culture = await js.InvokeAsync<string>("localStorage.getItem", "blazorCulture.get");
            if (culture != appUser.Language)
            {
                await js.InvokeAsync<string>("localStorage.setItem", "blazorCulture.get", appUser.Language);
                nav.NavigateTo(nav.Uri, forceLoad: true);
            }
        }
        else
            ToastService.ShowError(Lan["errorMessage"], ThemeService.CurrentTheme);
        return;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;

        // Preview
        using var stream = selectedFile.OpenReadStream(5 * 1024 * 1024);
        var buffer = new byte[selectedFile.Size];
        await stream.ReadAsync(buffer);

        ImagePreview = $"data:{selectedFile.ContentType};base64,{Convert.ToBase64String(buffer)}";
    }

    public void Dispose()
    {
        ToastService.OnChange -= StateHasChanged;
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}
