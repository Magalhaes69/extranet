@using WebFrontEnd.Services.Auth
<!--begin::Sidebar-->
<aside class="app-sidebar shadow bg-white" data-bs-theme="light">
    <!--begin::Sidebar Brand-->
    <div class="sidebar-brand">
        <!--begin::Brand Link-->
        <a href="#" class="brand-link">
            <!--begin::Brand Image-->
            <!--end::Brand Image-->
            <!--begin::Brand Text-->
            <span class="brand-text fw-light"></span>
            <!--end::Brand Text-->
        </a>
        <!--end::Brand Link-->
    </div>
    <!--end::Sidebar Brand-->
    <!--begin::Sidebar Wrapper-->
    <div class="sidebar-wrapper">
        <nav class="mt-2">
            <!--begin::Sidebar Menu-->
            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                role="navigation"
                aria-label="Main navigation"
                data-accordion="false"
                id="navigation">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item @(isSalesOpen ? "menu-open" : "")">

                            <NavLink href="" @onclick="ToggleSales" class="nav-link active" Match="NavLinkMatch.All">
                                <i class="nav-icon bi bi-cart"></i>
                                <p>
                                    Vendas
                                    <i class="nav-arrow bi bi-chevron-right "></i>
                                </p>
                            </NavLink>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <NavLink href="/list" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Cotações de vendas</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Pedido de cotação</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/orders" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Ordens de compra</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/add-orders" class="nav-link" Match="NavLinkMatch.All">
                                        <p> Criar ordens de compra</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p> Facturas de reserva d...</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Guias de remoessa</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/invoices" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Minhas faturas</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Solicitação de devoluções</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Criar solicitação de devoluções</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Devoluções</p>
                                    </NavLink>
                                </li>

                            </ul>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                <i class="nav-icon bi bi-palette"></i>
                                <p>Theme Generate</p>
                            </NavLink>
                        </li>
                        <li class="nav-item @(isPaymentOpen ? "menu-open" : "")">
                            <NavLink href="" @onclick="TogglePayment" class="nav-link" Match="NavLinkMatch.All">
                                <i class="nav-icon bi bi-credit-card-2-front"></i>
                                <p>
                                    Pagamentos
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </NavLink>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <NavLink href="/payments" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Pagamentos</p>
                                    </NavLink>
                                </li>
                                
                               
                            </ul>
                        </li>

                        <li class="nav-item @(isSettingsOpen ? "menu-open" : "")">
                            <NavLink href="/cotacao" @onclick="ToggleSettings" class="nav-link">
                                <i class="nav-icon bi bi-gear"></i>
                                <p>
                                    Administração
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </NavLink>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Utilizadores</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Criar utilizadores</p>
                                    </NavLink>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
            <!--end::Sidebar Menu-->
        </nav>
    </div>
    <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->
@code {
    private bool isSalesOpen = false;
    private bool isPaymentOpen = false;
    private bool isSettingsOpen = false;

    private void ToggleSales()
    {
        isSalesOpen = !isSalesOpen;
    }

    private void TogglePayment()
    {
        isPaymentOpen = !isPaymentOpen;
    }
    private void ToggleSettings()
    {
        isSettingsOpen = !isSettingsOpen;
    }
}
