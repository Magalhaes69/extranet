@code {
    private bool isSalesOpen = false;
    private bool isPaymentOpen = false;
    private bool isItemsOpen = false;
    private bool isSettingsOpen = false;


    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }
    private void ToggleSales()
    {
        isSalesOpen = !isSalesOpen;
    }

    private void TogglePayment()
    {
        isPaymentOpen = !isPaymentOpen;
    }
    private void ToggleItemExtensions()
    {
        isItemsOpen = !isItemsOpen;
    }
    private void ToggleSettings()
    {
        isSettingsOpen = !isSettingsOpen;
    }

    #region Menu

    private List<SidebarMenuItem> Menu = new()
{
    new SidebarMenuItem
    {
        Key = "menuVendasGroup",
        Icon = "nav-icon bi bi-cart",
        Children = new()
        {
            new() { Key = "menuQuotation", Url = "/quotations" },
            new() { Key = "menuOrder", Url = "/orders" },
            new() { Key = "createOrder", Url = "/add-orders" },
            new() { Key = "menuARReserve", Url = "/doesnotexist" },
            new() { Key = "menuDeliveries", Url = "/delivery" },
            new() { Key = "APInvoices", Url = "/invoices" },
            new() { Key = "menuReturns", Url = "/doesnotexist" },
            new() { Key = "menuCredit", Url = "/credits" },
        }
    },
    new SidebarMenuItem
    {
        Key = "menuPaymentGroup",
        Icon = "nav-icon bi bi-credit-card-2-front",
        Children = new()
        {
            new() { Key = "menuPayments", Url = "/payments" }
        }
    },
    new SidebarMenuItem
    {
        Key = "menuItemExtension",
        Icon = "nav-icon bi bi-box-seam",
        Children = new()
        {
            new() { Key = "menuListItemExtension", Url = "/extensions/list-item-extension" },
            new() { Key = "menuCreateItemExtension", Url = "/extensions/itemextension" }
        }
    },
    new SidebarMenuItem
    {
        Key="menuAdministratorGroup",
        Icon = "nav-icon bi bi-gear",
        Children = new()
        {
            new(){ Key = "menuUsers", Url = "/doesnotexist"},
            new(){ Key = "menuUserCreate", Url = "/doesnotexist"}
        }
    }
};

    private string SearchTerm = "";

    private List<SidebarMenuItem> FilteredMenu =>
        FilterMenu(Menu);

    private List<SidebarMenuItem> FilterMenu(List<SidebarMenuItem> menu)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
            return menu;

        var result = new List<SidebarMenuItem>();

        foreach (var item in menu)
        {
            // Get localized parent text
            var parentText = Lan[item.Key].Value;

            // Filter children
            var filteredChildren = item.Children
                .Where(c => Lan[c.Key].Value
                    .Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();

            // If parent matches OR any child matches → include parent
            if (parentText.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                || filteredChildren.Any())
            {
                result.Add(new SidebarMenuItem
                {
                    Key = item.Key,
                    Icon = item.Icon,
                    Url = item.Url,
                    Children = filteredChildren // ONLY matched children
                });
            }
        }

        return result;
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
    }
    #endregion

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
    }
}
