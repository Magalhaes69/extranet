@implements IDisposable
@inject IStringLocalizer<App> Language
@inject IStringLocalizer<MenuApp> Lan

@using WebFrontEnd.Services.Auth
<!--begin::Sidebar-->
<aside class="app-sidebar shadow @(ThemeService.CurrentTheme == "dark" ? "bg-dark" : "bg-light")" data-bs-theme="@ThemeService.CurrentTheme">
    <!--begin::Sidebar Brand-->
    <div class="sidebar-brand">
        <!--begin::Brand Link-->
        <a href="#" class="brand-link">
            <!--begin::Brand Image-->
            <!--end::Brand Image-->
            <!--begin::Brand Text-->
            <span class="brand-text fw-light"></span>
            <!--end::Brand Text-->
        </a>
        <!--end::Brand Link-->
    </div>
    <!--end::Sidebar Brand-->
    <!--begin::Sidebar Wrapper-->
    <div class="sidebar-wrapper ">
        <nav class="mt-2">
            <!--begin::Sidebar Menu-->
            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                role="navigation"
                aria-label="Main navigation"
                data-accordion="false"
                id="navigation">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item @(isSalesOpen ? "menu-open" : "")">

                            <NavLink href="" @onclick="ToggleSales" class="nav-link active" Match="NavLinkMatch.All">
                                <i class="nav-icon bi bi-cart"></i>
                                <p>
                                    @Lan["menuVendasGroup"]
                                    <i class="nav-arrow bi bi-chevron-right "></i>
                                </p>
                            </NavLink>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <NavLink href="/quotations" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuQuotation"]</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/orders" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuOrder"]</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/add-orders" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["createOrder"]</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuARReserve"]</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/delivery" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuDeliveries"]</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/invoices" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["APInvoices"]</p>
                                    </NavLink>
                                </li>

                              
                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuReturns"]</p>
                                    </NavLink>
                                </li>

                                <li class="nav-item">
                                    <NavLink href="/credits" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuCredit"]</p>
                                    </NavLink>
                                </li>

                            </ul>
                        </li>
                      
                        <li class="nav-item @(isPaymentOpen ? "menu-open" : "")">
                            <NavLink href="" @onclick="TogglePayment" class="nav-link" Match="NavLinkMatch.All">
                                <i class="nav-icon bi bi-credit-card-2-front"></i>
                                <p>
                                    @Lan["menuPaymentGroup"]
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </NavLink>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <NavLink href="/payments" class="nav-link" Match="NavLinkMatch.All">
                                        <p>Pagamentos</p>
                                    </NavLink>
                                </li>
                                
                               
                            </ul>
                        </li>

                        <li class="nav-item @(isSettingsOpen ? "menu-open" : "")">
                            <NavLink href="" @onclick="ToggleSettings" class="nav-link">
                                <i class="nav-icon bi bi-gear"></i>
                                <p>
                                    @Lan["menuAdministratorGroup"]
                                    <i class="nav-arrow bi bi-chevron-right"></i>
                                </p>
                            </NavLink>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuUsers"]</p>
                                    </NavLink>
                                </li>
                                <li class="nav-item">
                                    <NavLink href="/cotacao" class="nav-link" Match="NavLinkMatch.All">
                                        <p>@Lan["menuUserCreate"]</p>
                                    </NavLink>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
            <!--end::Sidebar Menu-->
        </nav>
    </div>
    <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->


@code {
    private bool isSalesOpen = false;
    private bool isPaymentOpen = false;
    private bool isSettingsOpen = false;


    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged); // force re-render
    }


    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }
    private void ToggleSales()
    {
        isSalesOpen = !isSalesOpen;
    }

    private void TogglePayment()
    {
        isPaymentOpen = !isPaymentOpen;
    }
    private void ToggleSettings()
    {
        isSettingsOpen = !isSettingsOpen;
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
    }
}
