@implements IDisposable
@inject IStringLocalizer<App> Language
@inject IStringLocalizer<MenuApp> Lan

@using WebFrontEnd.Services.Auth
@inject AccessService Access
<!--begin::Sidebar-->
<aside class="app-sidebar shadow @(ThemeService.CurrentTheme == "dark" ? "bg-dark" : "bg-light")" data-bs-theme="@ThemeService.CurrentTheme">
    <!--begin::Sidebar Brand-->
    <div class="sidebar-brand">
        <!--begin::Brand Link-->
        <a href="#" class="brand-link">
            <!--begin::Brand Image-->
            <i class="bi bi-hexagon-fill brand-icon"></i>
            <!--end::Brand Image-->
            <!--begin::Brand Text-->
            <span class="brand-text">Extranet <strong>SAP</strong></span>
            <!--end::Brand Text-->
        </a>
        <!--end::Brand Link-->
    </div>
    <!--end::Sidebar Brand-->
    <!--begin::Sidebar Wrapper-->
    <div class="sidebar-wrapper ">
        <nav class="mt-2">
            <!--begin::Sidebar Menu-->
            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                role="navigation"
                aria-label="Navegação principal"
                data-accordion="false"
                id="navigation">
                <AuthorizeView>
                    <Authorized>
                        <div class="position-relative mb-2">

                            <!--Input -->
                            <input type="text"
                                   class="form-control form-control-sm ps-2 pe-2"
                                   placeholder="@Lan["searchMenu"]"
                                   @bind="SearchTerm"
                                   @bind:event="oninput" />

                            @if (string.IsNullOrEmpty(SearchTerm))
                            {
                                <!-- Search icon (left) -->
                                <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-2 text-muted"></i>
                            }
                            else if(!string.IsNullOrEmpty(SearchTerm))
                            {
                        <!-- Clear button (right) -->
                                <i class="bi bi-x-circle position-absolute top-50 end-0 translate-middle-y me-2 text-muted"
                                   style="cursor:pointer;"
                                   @onclick="ClearSearch"></i>
                            }
                        </div>

                        <!-- Menu -->
                    <SidebarMenuComponent 
                        Items="FilteredMenu" />
                    </Authorized>
                </AuthorizeView>
            </ul>
            <!--end::Sidebar Menu-->
        </nav>
    </div>
    <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->


@code {
    private bool isSalesOpen = false;
    private bool isPaymentOpen = false;
    private bool isItemsOpen = false;
    private bool isSettingsOpen = false;


    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += Refresh;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationChanged;
        await BuildVisibleMenuAsync();
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }
    private void ToggleSales()
    {
        isSalesOpen = !isSalesOpen;
    }

    private void TogglePayment()
    {
        isPaymentOpen = !isPaymentOpen;
    }
    private void ToggleItemExtensions()
    {
        isItemsOpen = !isItemsOpen;
    }
    private void ToggleSettings()
    {
        isSettingsOpen = !isSettingsOpen;
    }

    #region Menu

    private List<SidebarMenuItem> Menu = new()
    {
        new SidebarMenuItem
        {
            Key = "menuPrincipal",
            Icon = "nav-icon bi bi-house-door-fill",
            Section = "menuSectionGeneral",
            Process = "dashboard",
            Url = "/"
        },
        new SidebarMenuItem
        {
            Key = "menuVendasGroup",
            Icon = "nav-icon bi bi-cart-fill",
            Process = "requests",
            Children = new()
            {
                new() { Key = "menuQuotation", Url = "/quotations" },
                new() { Key = "menuOrder", Url = "/orders" },
                new() { Key = "createOrder", Url = "/add-orders" },
                //new() { Key = "menucreateOrderByCat", Url = "/catalog-item" },
                new() { Key = "menuReturns", Url = "/returns" },
                new() { Key = "menuDeliveries", Url = "/delivery" },
                new() { Key = "APInvoices", Url = "/invoices" },
                new() { Key = "menuCredit", Url = "/credits" },
            }
        },
        new SidebarMenuItem
        {
            Key = "menuPaymentGroup",
            Icon = "nav-icon bi bi-credit-card-2-front-fill",
            Process = "payments",
            Children = new()
            {
                new() { Key = "menuPayments", Url = "/payments" }
            }
        },
        // new SidebarMenuItem
        // {
        //     Key = "menuItemExtension",
        //     Icon = "nav-icon bi bi-box-seam",
        //     Children = new()
        //     {
        //         new() { Key = "menuListItemExtension", Url = "/extensions/list-item-extension" },
        //         new() { Key = "menuCreateItemExtension", Url = "/extensions/itemextension" }
        //     }
        // },
        new SidebarMenuItem
        {
            Key = "menuUserManagementGroup",
            Icon = "nav-icon bi bi-people-fill",
            Section = "menuSectionAdmin",
            ManagerOnly = true,
            Url = "/company-users"
        },
        new SidebarMenuItem
        {
            Key="menuAdministratorGroup",
            Icon = "nav-icon bi bi-gear-fill",
            ManagerOnly = true,
            Children = new()
            {
                new(){ Key = "menuConfigure", Url = "/configure-app"},
            }
        },
        
    };

    private string SearchTerm = "";

    // Menu já filtrado pelas permissões do utilizador (gestor / processos atribuídos).
    private List<SidebarMenuItem> _visibleMenu = new();

    private List<SidebarMenuItem> FilteredMenu =>
        FilterMenu(_visibleMenu);

    private async Task BuildVisibleMenuAsync()
    {
        var isManager = await Access.IsManagerAsync();
        var result = new List<SidebarMenuItem>();
        string? pendingSection = null;

        foreach (var item in Menu)
        {
            if (item.Section is not null)
                pendingSection = item.Section;

            var visible = item.ManagerOnly
                ? isManager
                : item.Process is null || await Access.HasProcessAsync(item.Process);

            if (!visible)
                continue;

            // O cabeçalho da secção passa para o primeiro item visível dessa secção.
            result.Add(new SidebarMenuItem
            {
                Key = item.Key,
                Url = item.Url,
                Icon = item.Icon,
                Section = pendingSection,
                Process = item.Process,
                ManagerOnly = item.ManagerOnly,
                Children = item.Children
            });
            pendingSection = null;
        }

        _visibleMenu = result;
    }

    private void OnAuthenticationChanged(Task<AuthenticationState> authState) =>
        _ = InvokeAsync(async () =>
        {
            await BuildVisibleMenuAsync();
            StateHasChanged();
        });

    private List<SidebarMenuItem> FilterMenu(List<SidebarMenuItem> menu)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
            return menu;

        var result = new List<SidebarMenuItem>();

        foreach (var item in menu)
        {
            // Get localized parent text
            var parentText = Lan[item.Key].Value;

            // Filter children
            var filteredChildren = item.Children
                .Where(c => Lan[c.Key].Value
                    .Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();

            // If parent matches OR any child matches → include parent
            if (parentText.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                || filteredChildren.Any())
            {
                result.Add(new SidebarMenuItem
                {
                    Key = item.Key,
                    Icon = item.Icon,
                    Section = item.Section,
                    Url = item.Url,
                    Children = filteredChildren // ONLY matched children
                });
            }
        }

        return result;
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
    }
    #endregion

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationChanged;
    }
}
