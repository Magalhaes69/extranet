@implements IDisposable
@inject IStringLocalizer<App> Language
@inject IStringLocalizer<MenuApp> Lan

@using WebFrontEnd.Services.Auth
<!--begin::Sidebar-->
<aside class="app-sidebar shadow @(ThemeService.CurrentTheme == "dark" ? "bg-dark" : "bg-light")" data-bs-theme="@ThemeService.CurrentTheme">
    <!--begin::Sidebar Brand-->
    <div class="sidebar-brand">
        <!--begin::Brand Link-->
        <a href="#" class="brand-link">
            <!--begin::Brand Image-->
            <!--end::Brand Image-->
            <!--begin::Brand Text-->
            <span class="brand-text fw-light"></span>
            <!--end::Brand Text-->
        </a>
        <!--end::Brand Link-->
    </div>
    <!--end::Sidebar Brand-->
    <!--begin::Sidebar Wrapper-->
    <div class="sidebar-wrapper ">
        <nav class="mt-2">
            <!--begin::Sidebar Menu-->
            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                role="navigation"
                aria-label="Main navigation"
                data-accordion="false"
                id="navigation">
                <AuthorizeView>
                    <Authorized>
                        <div class="position-relative mb-2">

                            <!--Input -->
                            <input type="text"
                                   class="form-control form-control-sm ps-2 pe-2"
                                   placeholder="@Lan["searchMenu"]"
                                   @bind="SearchTerm"
                                   @bind:event="oninput" />

                            @if (string.IsNullOrEmpty(SearchTerm))
                            {
                                <!-- Search icon (left) -->
                                <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-2 text-muted"></i>
                            }
                            else if(!string.IsNullOrEmpty(SearchTerm))
                            {
                        <!-- Clear button (right) -->
                                <i class="bi bi-x-circle position-absolute top-50 end-0 translate-middle-y me-2 text-muted"
                                   style="cursor:pointer;"
                                   @onclick="ClearSearch"></i>
                            }
                        </div>

                        <!-- Menu -->
                    <SidebarMenuComponent 
                        Items="FilteredMenu" />
                    </Authorized>
                </AuthorizeView>
            </ul>
            <!--end::Sidebar Menu-->
        </nav>
    </div>
    <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->


@code {
    private bool isSalesOpen = false;
    private bool isPaymentOpen = false;
    private bool isItemsOpen = false;
    private bool isSettingsOpen = false;


    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }
    private void ToggleSales()
    {
        isSalesOpen = !isSalesOpen;
    }

    private void TogglePayment()
    {
        isPaymentOpen = !isPaymentOpen;
    }
    private void ToggleItemExtensions()
    {
        isItemsOpen = !isItemsOpen;
    }
    private void ToggleSettings()
    {
        isSettingsOpen = !isSettingsOpen;
    }

    #region Menu

    private List<SidebarMenuItem> Menu = new()
    {
        new SidebarMenuItem
        {
            Key = "menuPrincipal",
            Icon = "nav-icon bi bi-house",
            Url = "/"
        },
        new SidebarMenuItem
        {
            Key = "menuVendasGroup",
            Icon = "nav-icon bi bi-cart",
            Children = new()
            {
                new() { Key = "menuQuotation", Url = "/quotations" },
                new() { Key = "menuOrder", Url = "/orders" },
                new() { Key = "createOrder", Url = "/add-orders" },
                //new() { Key = "menucreateOrderByCat", Url = "/catalog-item" },
                new() { Key = "menuReturns", Url = "/returns" },
                new() { Key = "menuDeliveries", Url = "/delivery" },
                new() { Key = "APInvoices", Url = "/invoices" },
                new() { Key = "menuCredit", Url = "/credits" },
            }
        },
        new SidebarMenuItem
        {
            Key = "menuPaymentGroup",
            Icon = "nav-icon bi bi-credit-card-2-front",
            Children = new()
            {
                new() { Key = "menuPayments", Url = "/payments" }
            }
        },
        // new SidebarMenuItem
        // {
        //     Key = "menuItemExtension",
        //     Icon = "nav-icon bi bi-box-seam",
        //     Children = new()
        //     {
        //         new() { Key = "menuListItemExtension", Url = "/extensions/list-item-extension" },
        //         new() { Key = "menuCreateItemExtension", Url = "/extensions/itemextension" }
        //     }
        // },
        new SidebarMenuItem
        {
            Key="menuAdministratorGroup",
            Icon = "nav-icon bi bi-gear",
            Children = new()
            {
                new(){ Key = "menuConfigure", Url = "/configure-app"},
            }
        },
        
    };

    private string SearchTerm = "";

    private List<SidebarMenuItem> FilteredMenu =>
        FilterMenu(Menu);

    private List<SidebarMenuItem> FilterMenu(List<SidebarMenuItem> menu)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
            return menu;

        var result = new List<SidebarMenuItem>();

        foreach (var item in menu)
        {
            // Get localized parent text
            var parentText = Lan[item.Key].Value;

            // Filter children
            var filteredChildren = item.Children
                .Where(c => Lan[c.Key].Value
                    .Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();

            // If parent matches OR any child matches → include parent
            if (parentText.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)
                || filteredChildren.Any())
            {
                result.Add(new SidebarMenuItem
                {
                    Key = item.Key,
                    Icon = item.Icon,
                    Url = item.Url,
                    Children = filteredChildren // ONLY matched children
                });
            }
        }

        return result;
    }

    private void ClearSearch()
    {
        SearchTerm = string.Empty;
    }
    #endregion

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
    }
}
