@page "/"
@using WebFrontEnd.Services.Auth
@using WebFrontEnd.Services.Dashboard.Dtos
@implements IDisposable
@attribute [Authorize]

<div class="dashboard @(IsDark ? "dashboard-dark" : "")">

    <div class="app-content-header pt-2 pb-1">
        <div class="container-fluid">
            <div class="top-menu sticky-top d-flex justify-content-between align-items-center">
                <ul class="nav custom-tabs">
                    @foreach (var section in Sections)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(activeSection == section.Id ? "active" : "")"
                               @onclick="() => ScrollTo(section.Id)">@section.Title</a>
                        </li>
                    }
                </ul>
                <button class="btn btn-sm btn-outline-primary" @onclick="RefreshAll">
                    <i class="bi bi-arrow-clockwise"></i> Atualizar
                </button>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid" @key="refreshKey">

            <section id="home" class="dash-section">
                <h5 class="dash-section-title">Ações rápidas</h5>
                <div class="kpi-grid">
                    <a href="/add-orders" class="kpi-card kpi-action">
                        <span class="kpi-icon"><i class="bi bi-file-earmark-plus"></i></span>
                        <span class="kpi-title">Criar ordem de compra</span>
                    </a>
                </div>
            </section>

            @foreach (var section in Sections.Where(s => s.Cards.Count > 0))
            {
                <section id="@section.Id" class="dash-section">
                    <h5 class="dash-section-title">@section.Title</h5>
                    <div class="kpi-grid">
                        @foreach (var card in section.Cards)
                        {
                            <KpiCard MetricKey="@card.Key"
                                     Title="@card.Title"
                                     Icon="@card.Icon"
                                     Href="@card.Href"
                                     Accent="@card.Accent"
                                     Caption="@card.Caption" />
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</div>

<style>
    .dashboard {
        --dash-card-bg: #fff;
        --dash-border: #e9ecef;
        --dash-muted: #6c757d;
        --dash-skeleton: #e9ecef;
        --dash-skeleton-shine: #f8f9fa;
    }

    .dashboard-dark {
        --dash-card-bg: #1f2329;
        --dash-border: #2f353d;
        --dash-muted: #9aa4af;
        --dash-skeleton: #2a2f36;
        --dash-skeleton-shine: #353b44;
        color: #e9ecef;
    }

    .top-menu {
        z-index: 1000;
        border-bottom: 1px solid var(--dash-border);
    }

    .custom-tabs {
        border-bottom: none;
        cursor: pointer;
    }

        .custom-tabs .nav-link {
            border: none;
            color: inherit;
            font-weight: 500;
            padding: 10px 15px;
        }

            .custom-tabs .nav-link.active {
                border-bottom: 3px solid #0d6efd;
                color: #0d6efd;
                background: transparent;
            }

    .dash-section {
        margin-top: 1.5rem;
        scroll-margin-top: 70px;
    }

    .dash-section-title {
        font-weight: 600;
        margin-bottom: .75rem;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 1rem;
    }

    .kpi-card {
        display: flex;
        flex-direction: column;
        gap: .5rem;
        min-height: 170px;
        padding: 1rem;
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-border);
        border-left: 4px solid var(--kpi-accent, #0d6efd);
        border-radius: 12px;
        box-shadow: 0 3px 8px rgba(0,0,0,.06);
        color: inherit;
        text-decoration: none;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,.10);
        }

    .kpi-primary {
        --kpi-accent: #0d6efd;
    }

    .kpi-success {
        --kpi-accent: #198754;
    }

    .kpi-warning {
        --kpi-accent: #fd7e14;
    }

    .kpi-danger {
        --kpi-accent: #dc3545;
    }

    .kpi-info {
        --kpi-accent: #0dcaf0;
    }

    .kpi-action {
        --kpi-accent: #6f42c1;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .kpi-head {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--kpi-accent) 12%, transparent);
        color: var(--kpi-accent);
        font-size: 1.1rem;
    }

    .kpi-title {
        font-weight: 600;
        font-size: .9rem;
    }

    .kpi-body {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .kpi-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        color: var(--kpi-accent);
        text-decoration: none;
    }

    .kpi-amount {
        font-weight: 600;
        margin-top: .25rem;
    }

    .kpi-caption {
        font-size: .75rem;
        color: var(--dash-muted);
    }

    .kpi-error {
        color: var(--dash-muted);
        gap: .25rem;
        font-size: .85rem;
    }

    .kpi-foot {
        display: flex;
        justify-content: space-between;
        font-size: .75rem;
        color: var(--dash-muted);
    }

    .kpi-link {
        color: var(--kpi-accent);
        text-decoration: none;
        font-weight: 500;
    }

    .skeleton {
        border-radius: 6px;
        background: linear-gradient(90deg, var(--dash-skeleton) 25%, var(--dash-skeleton-shine) 50%, var(--dash-skeleton) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.2s infinite;
    }

    .skeleton-value {
        width: 45%;
        height: 30px;
    }

    .skeleton-amount {
        width: 70%;
        height: 14px;
        margin-top: .5rem;
    }

    .skeleton-foot {
        width: 35%;
        height: 10px;
    }

    @@keyframes shimmer {
        from {
            background-position: 200% 0;
        }

        to {
            background-position: -200% 0;
        }
    }
</style>

@code {
    private sealed record KpiDef(string Key, string Title, string Icon, string Href, string Accent, string? Caption = null);
    private sealed record SectionDef(string Id, string Title, List<KpiDef> Cards);

    private string activeSection = "home";
    private int refreshKey;
    private bool IsDark => ThemeService.CurrentTheme == "dark";

    private List<SectionDef> Sections => new()
    {
        new("home", LanGeneral["dashboardTitlePrincipalPage"], new()),

        new("vendas", "Vendas", new()
        {
            new("orders-open",     "Ordens em aberto",   "bi-receipt",           "/orders",     "primary", "Valor total"),
            new("quotations-open", "Cotações em aberto", "bi-file-earmark-text", "/quotations", "info",    "Valor total"),
            new("deliveries-open", "Guias de entrega",   "bi-truck",             "/delivery", "success", "Em aberto"),
        }),

        new("financeiro", "Financeiro", new()
        {
            new("invoices-open",    "Faturas em aberto", "bi-file-earmark-ruled", "/invoices",                "warning", "Valor em aberto"),
            new("invoices-overdue", "Faturas vencidas",  "bi-exclamation-octagon", "/invoices",      "danger",  "Valor vencido"),
            new("creditnotes-year", "Notas de crédito",  "bi-arrow-counterclockwise", "/credits",        "info",    "Este ano"),
            new("payments-year",    "Pagamentos",        "bi-cash-coin",          "/payments",                "success", "Este ano"),
        }),
    };

    protected override void OnInitialized()
    {
        PageTitleService.SetTitle(LanGeneral["homePageTitle"]);
        PageState.SetTitle(LanGeneral["homePageTitle"]);
        ThemeService.OnThemeChanged += Refresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LayoutState.SetSidebar(true);
            await js.InvokeVoidAsync("registerScrollSpy", DotNetObjectReference.Create(this));
        }
    }

    private void RefreshAll() => refreshKey++; // recreates every KpiCard -> each reloads

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task ScrollTo(string id)
    {
        activeSection = id;
        await js.InvokeVoidAsync("scrollToSection", id);
    }

    [JSInvokable]
    public void SetActiveSection(string section)
    {
        activeSection = section;
        StateHasChanged();
    }

    public void Dispose() => ThemeService.OnThemeChanged -= Refresh;
}