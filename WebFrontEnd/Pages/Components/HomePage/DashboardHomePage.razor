                <li class="nav-item">
                    <a class="nav-link @(activeSection == "compras" ? "active" : "") @(ThemeService.CurrentTheme == "dark" ? "text-white" : "text-dark")"
                       @onclick="@(() => ScrollTo("compras"))">Guias de entrega</a>
