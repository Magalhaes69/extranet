@page "/"
@using WebFrontEnd.Services.Auth
@using WebFrontEnd.Services.Licenses
@using WebFrontEnd.Services.Notifications
@using WebFrontEnd.Services.CompanyUsers
@using WebFrontEnd.Pages.Components.Licenses
@inject IStringLocalizer<DashboardApp> L
@inject IStringLocalizer<LicensesApp> LL
@inject ILicensesService LicensesApi
@inject INotificationsService NotificationsApi
@inject ICompanyUsersService CompanyUsersApi
@inject AccessService Access
@implements IDisposable
@attribute [Authorize]

<div class="dashboard">

    <div class="app-content-header pt-2 pb-1">
        <div class="container-fluid">
            <div class="top-menu sticky-top d-flex justify-content-between align-items-center">
                <ul class="nav custom-tabs">
                    @foreach (var section in VisibleSections)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(activeSection == section.Id ? "active" : "")"
                               @onclick="() => ScrollTo(section.Id)">@section.Title</a>
                        </li>
                    }
                </ul>
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadAsync" disabled="@loading">
                    <i class="bi bi-arrow-clockwise"></i> @L["btnRefresh"]
                </button>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">

            <!-- ============ A minha página principal ============ -->
            <section id="home" class="dash-section">
                <h4 class="mb-3">@string.Format(L["greeting"].Value, userName)</h4>

                @if (overview is { IsTrial: true, TrialEndDate: not null })
                {
                    var trialDays = LicenseRules.DaysLeft(overview.TrialEndDate);
                    <div class="alert @(trialDays <= 0 ? "alert-danger" : trialDays <= LicenseRules.ExpiringDays ? "alert-warning" : "alert-info") d-flex align-items-center py-2" role="alert">
                        <i class="bi bi-hourglass-split fs-5 me-2"></i>
                        <div class="small">
                            @(trialDays <= 0
                                ? string.Format(LL["trialEnded"].Value, overview.TrialEndDate.Value.ToLocalTime().ToString("dd/MM/yyyy"))
                                : string.Format(LL["trialEnds"].Value, overview.TrialEndDate.Value.ToLocalTime().ToString("dd/MM/yyyy"), trialDays))
                        </div>
                    </div>
                }
                @if (ExpiredCount > 0)
                {
                    <div class="alert alert-danger d-flex justify-content-between align-items-center py-2" role="alert">
                        <span><i class="bi bi-x-octagon me-2"></i>@string.Format(LL["alertExpired"].Value, ExpiredCount)</span>
                        <a class="btn btn-sm btn-outline-danger" href="/licenses">@LL["btnShow"]</a>
                    </div>
                }
                @if (ExpiringCount > 0)
                {
                    <div class="alert alert-warning d-flex justify-content-between align-items-center py-2" role="alert">
                        <span><i class="bi bi-exclamation-triangle me-2"></i>@string.Format(LL["alertExpiring"].Value, ExpiringCount, LicenseRules.ExpiringDays)</span>
                        <a class="btn btn-sm btn-outline-warning" href="/licenses">@LL["btnShow"]</a>
                    </div>
                }

                <h5 class="dash-section-title mt-3">@L["quickActions"]</h5>
                <div class="kpi-grid">
                    @if (hasLicenses && isManager)
                    {
                        <a href="/licenses/request" class="kpi-card kpi-action">
                            <span class="kpi-icon"><i class="bi bi-plus-circle"></i></span>
                            <span class="kpi-title">@L["actRequestLicense"]</span>
                        </a>
                    }
                    @if (hasLicenses)
                    {
                        <a href="/licenses" class="kpi-card kpi-action">
                            <span class="kpi-icon"><i class="bi bi-patch-check"></i></span>
                            <span class="kpi-title">@L["actMyLicenses"]</span>
                        </a>
                        <a href="/license-requests" class="kpi-card kpi-action">
                            <span class="kpi-icon"><i class="bi bi-inboxes"></i></span>
                            <span class="kpi-title">@L["actMyRequests"]</span>
                        </a>
                    }
                    @if (isManager)
                    {
                        <a href="/company-users" class="kpi-card kpi-action">
                            <span class="kpi-icon"><i class="bi bi-people"></i></span>
                            <span class="kpi-title">@L["actUsers"]</span>
                        </a>
                    }
                    <a href="/settings" class="kpi-card kpi-action">
                        <span class="kpi-icon"><i class="bi bi-gear"></i></span>
                        <span class="kpi-title">@L["actSettings"]</span>
                    </a>
                </div>

                <h5 class="dash-section-title mt-4">@L["summary"]</h5>
                <div class="kpi-grid">
                    @if (hasLicenses)
                    {
                        <StatCard Title="@L["kpiActiveLicenses"]" Icon="bi-check-circle" Accent="success" Loading="@loading"
                                  Value="@(overview is null ? null : CountState(LicenseStatus.Active).ToString("N0"))"
                                  Caption="@L["kpiActiveLicensesCaption"]" Href="/licenses" LinkText="@L["see"]" Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiExpiring"]" Icon="bi-exclamation-triangle" Accent="warning" Loading="@loading"
                                  Value="@(overview is null ? null : ExpiringCount.ToString("N0"))"
                                  Caption="@string.Format(L["kpiExpiringCaption"].Value, LicenseRules.ExpiringDays)" Href="/licenses" LinkText="@L["see"]" Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiOpenRequests"]" Icon="bi-hourglass-split" Accent="info" Loading="@loading"
                                  Value="@(requests is null ? null : requests.Count(LicenseRules.IsOpen).ToString("N0"))"
                                  Caption="@L["kpiOpenRequestsCaption"]" Href="/license-requests" LinkText="@L["see"]" Unavailable="@L["unavailable"]" />
                    }
                    <StatCard Title="@L["kpiUnread"]" Icon="bi-bell" Accent="primary" Loading="@loading"
                              Value="@(unread is null ? null : unread.Value.ToString("N0"))"
                              Caption="@L["kpiUnreadCaption"]" Unavailable="@L["unavailable"]" />
                    @if (isManager)
                    {
                        <StatCard Title="@L["kpiUsers"]" Icon="bi-people" Accent="success" Loading="@loading"
                                  Value="@(usersCount is null ? null : usersCount.Value.ToString("N0"))"
                                  Caption="@L["kpiUsersCaption"]" Href="/company-users" LinkText="@L["see"]" Unavailable="@L["unavailable"]" />
                    }
                </div>
            </section>

            @if (hasLicenses)
            {
                <!-- ============ Licenças ============ -->
                <section id="licencas" class="dash-section">
                    <h5 class="dash-section-title">@L["secLicenses"]</h5>
                    <div class="kpi-grid">
                        <StatCard Title="@L["kpiTotal"]" Icon="bi-patch-check" Accent="primary" Loading="@loading"
                                  Value="@(overview is null ? null : overview.Licenses.Count.ToString("N0"))"
                                  Href="/licenses" LinkText="@L["see"]" Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiActiveLicenses"]" Icon="bi-check-circle" Accent="success" Loading="@loading"
                                  Value="@(overview is null ? null : CountState(LicenseStatus.Active).ToString("N0"))"
                                  Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiExpiring"]" Icon="bi-exclamation-triangle" Accent="warning" Loading="@loading"
                                  Value="@(overview is null ? null : ExpiringCount.ToString("N0"))" Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiExpired"]" Icon="bi-x-circle" Accent="danger" Loading="@loading"
                                  Value="@(overview is null ? null : ExpiredCount.ToString("N0"))" Unavailable="@L["unavailable"]" />
                    </div>

                    <div class="dash-list">
                        <div class="dash-list-title"><i class="bi bi-calendar-event me-2"></i>@L["nextExpiries"]</div>
                        @if (loading)
                        {
                            <div class="p-3"><div class="skeleton skeleton-amount"></div></div>
                        }
                        else if (overview is null)
                        {
                            <div class="p-3 text-muted small"><i class="bi bi-exclamation-triangle me-1"></i>@L["unavailable"]</div>
                        }
                        else if (UpcomingLicenses.Count == 0)
                        {
                            <div class="p-3 text-muted small">@L["noExpiries"]</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <tbody>
                                        @foreach (var license in UpcomingLicenses)
                                        {
                                            var state = LicenseRules.StateOf(license);
                                            <tr>
                                                <td><a href="/licenses/details/@license.Id" class="font-monospace text-decoration-none"><i class="bi bi-key me-1"></i>@license.MaskedKey</a></td>
                                                <td><span class="badge @LicenseRules.BadgeClass(state)">@LL[LicenseRules.StateKey(state)]</span></td>
                                                <td><LicenseExpiry Date="@LicenseRules.NextExpiry(license)" /></td>
                                                <td class="text-end">
                                                    @if (isManager && LicenseRules.CanRenew(license))
                                                    {
                                                        <a class="btn btn-outline-primary btn-sm py-0" href="/licenses/renew/@license.Id"><i class="bi bi-arrow-repeat me-1"></i>@LL["btnRenew"]</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </section>

                <!-- ============ Pedidos ============ -->
                <section id="pedidos" class="dash-section">
                    <h5 class="dash-section-title">@L["secRequests"]</h5>
                    <div class="kpi-grid">
                        <StatCard Title="@L["kpiInReview"]" Icon="bi-hourglass-split" Accent="info" Loading="@loading"
                                  Value="@(requests is null ? null : requests.Count(r => r.Status is 1 or 2).ToString("N0"))"
                                  Href="/license-requests" LinkText="@L["see"]" Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiApproved"]" Icon="bi-check2-circle" Accent="success" Loading="@loading"
                                  Value="@(requests is null ? null : requests.Count(r => r.Status == 3).ToString("N0"))" Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiCompleted"]" Icon="bi-check-all" Accent="primary" Loading="@loading"
                                  Value="@(requests is null ? null : requests.Count(r => r.Status == 5).ToString("N0"))" Unavailable="@L["unavailable"]" />
                        <StatCard Title="@L["kpiRejected"]" Icon="bi-x-circle" Accent="danger" Loading="@loading"
                                  Value="@(requests is null ? null : requests.Count(r => r.Status == 4).ToString("N0"))" Unavailable="@L["unavailable"]" />
                    </div>

                    <div class="dash-list">
                        <div class="dash-list-title"><i class="bi bi-clock-history me-2"></i>@L["recentRequests"]</div>
                        @if (loading)
                        {
                            <div class="p-3"><div class="skeleton skeleton-amount"></div></div>
                        }
                        else if (requests is null)
                        {
                            <div class="p-3 text-muted small"><i class="bi bi-exclamation-triangle me-1"></i>@L["unavailable"]</div>
                        }
                        else if (requests.Count == 0)
                        {
                            <div class="p-3 text-muted small">@L["noRequests"]</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <tbody>
                                        @foreach (var r in requests.OrderByDescending(x => x.SubmittedAt).Take(5))
                                        {
                                            <tr>
                                                <td class="text-nowrap">@r.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <i class="bi @(r.Type == 2 ? "bi-arrow-repeat" : "bi-plus-circle") me-1"></i>
                                                    @LL[r.Type == 2 ? "typeRenewal" : "typeNew"]
                                                    <span class="text-muted"> · @(r.Type == 2 ? r.MaskedKey : r.ProductName)</span>
                                                </td>
                                                <td><span class="badge @LicenseRules.RequestBadgeClass(r.Status)">@LL[LicenseRules.RequestStatusKey(r.Status)]</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</div>

<style>
    .dashboard {
        --dash-card-bg: var(--bs-body-bg);
        --dash-border: var(--bs-border-color);
        --dash-muted: var(--bs-secondary-color);
        --dash-skeleton: var(--bs-tertiary-bg);
        --dash-skeleton-shine: var(--bs-secondary-bg);
    }

    .top-menu {
        z-index: 1000;
        border-bottom: 1px solid var(--dash-border);
    }

    .custom-tabs {
        border-bottom: none;
        cursor: pointer;
    }

        .custom-tabs .nav-link {
            border: none;
            color: inherit;
            font-weight: 500;
            padding: 10px 15px;
        }

            .custom-tabs .nav-link.active {
                border-bottom: 3px solid #0d6efd;
                color: #0d6efd;
                background: transparent;
            }

    .dash-section {
        margin-top: 1.5rem;
        scroll-margin-top: 70px;
    }

    .dash-section-title {
        font-weight: 600;
        margin-bottom: .75rem;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 1rem;
    }

    .kpi-card {
        display: flex;
        flex-direction: column;
        gap: .5rem;
        min-height: 170px;
        padding: 1rem;
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-border);
        border-left: 4px solid var(--kpi-accent, #0d6efd);
        border-radius: 12px;
        box-shadow: 0 3px 8px rgba(0,0,0,.06);
        color: inherit;
        text-decoration: none;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,.10);
        }

    .kpi-primary {
        --kpi-accent: #0d6efd;
    }

    .kpi-success {
        --kpi-accent: #198754;
    }

    .kpi-warning {
        --kpi-accent: #fd7e14;
    }

    .kpi-danger {
        --kpi-accent: #dc3545;
    }

    .kpi-info {
        --kpi-accent: #0dcaf0;
    }

    .kpi-action {
        --kpi-accent: #6f42c1;
        justify-content: center;
        align-items: center;
        text-align: center;
        min-height: 130px;
    }

    .dash-list {
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        box-shadow: 0 3px 8px rgba(0,0,0,.06);
        margin-top: 1rem;
        overflow: hidden;
    }

    .dash-list-title {
        font-weight: 600;
        font-size: .9rem;
        padding: .75rem 1rem;
        border-bottom: 1px solid var(--dash-border);
    }

    .kpi-head {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--kpi-accent) 12%, transparent);
        color: var(--kpi-accent);
        font-size: 1.1rem;
    }

    .kpi-title {
        font-weight: 600;
        font-size: .9rem;
    }

    .kpi-body {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .kpi-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        color: var(--kpi-accent);
        text-decoration: none;
    }

    .kpi-amount {
        font-weight: 600;
        margin-top: .25rem;
    }

    .kpi-caption {
        font-size: .75rem;
        color: var(--dash-muted);
    }

    .kpi-error {
        color: var(--dash-muted);
        gap: .25rem;
        font-size: .85rem;
    }

    .kpi-foot {
        display: flex;
        justify-content: space-between;
        font-size: .75rem;
        color: var(--dash-muted);
    }

    .kpi-link {
        color: var(--kpi-accent);
        text-decoration: none;
        font-weight: 500;
    }

    .skeleton {
        border-radius: 6px;
        background: linear-gradient(90deg, var(--dash-skeleton) 25%, var(--dash-skeleton-shine) 50%, var(--dash-skeleton) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.2s infinite;
    }

    .skeleton-value {
        width: 45%;
        height: 30px;
    }

    .skeleton-amount {
        width: 70%;
        height: 14px;
        margin-top: .5rem;
    }

    .skeleton-foot {
        width: 35%;
        height: 10px;
    }

    @@keyframes shimmer {
        from {
            background-position: 200% 0;
        }

        to {
            background-position: -200% 0;
        }
    }
</style>

@code {
    private sealed record SectionDef(string Id, string Title);

    private string activeSection = "home";
    private bool loading = true;
    private bool isManager;
    private bool hasLicenses;
    private string userName = string.Empty;

    private LicenseOverviewDto? overview;
    private List<LicenseRequestDto>? requests;
    private int? unread;
    private int? usersCount;

    private List<SectionDef> VisibleSections
    {
        get
        {
            var list = new List<SectionDef> { new("home", LanGeneral["dashboardTitlePrincipalPage"]) };
            if (hasLicenses)
            {
                list.Add(new("licencas", L["secLicenses"]));
                list.Add(new("pedidos", L["secRequests"]));
            }
            return list;
        }
    }

    private int CountState(LicenseStatus s) => overview?.Licenses.Count(l => LicenseRules.StateOf(l) == s) ?? 0;
    private int ExpiringCount => CountState(LicenseStatus.Expiring);
    private int ExpiredCount => CountState(LicenseStatus.Expired);

    // Licenças em uso por ordem de expiração (as mais urgentes primeiro).
    private List<LicenseDto> UpcomingLicenses =>
        (overview?.Licenses ?? new())
            .Where(l => LicenseRules.NextExpiry(l).HasValue &&
                        LicenseRules.StateOf(l) is LicenseStatus.Active or LicenseStatus.Expiring or LicenseStatus.Expired)
            .OrderBy(l => LicenseRules.NextExpiry(l))
            .Take(5)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle(LanGeneral["homePageTitle"]);
        PageState.SetTitle(LanGeneral["homePageTitle"]);
        ThemeService.OnThemeChanged += Refresh;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userName = auth.User.Identity?.Name ?? string.Empty;

        isManager = await Access.IsManagerAsync();
        hasLicenses = await Access.HasProcessAsync("licenses");

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LayoutState.SetSidebar(true);
            await js.InvokeVoidAsync("registerScrollSpy", DotNetObjectReference.Create(this));
        }
    }

    /// <summary>Carrega todos os indicadores em paralelo; cada um falha de forma independente.</summary>
    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();

        var overviewTask = hasLicenses ? LicensesApi.GetOverviewAsync() : Task.FromResult<LicenseOverviewDto?>(null);
        var requestsTask = hasLicenses ? LicensesApi.GetRequestsAsync() : Task.FromResult<List<LicenseRequestDto>?>(null);
        var notificationsTask = NotificationsApi.GetAsync();
        var usersTask = isManager ? CompanyUsersApi.GetAllAsync() : Task.FromResult<List<CompanyUserDto>?>(null);

        overview = await overviewTask;
        requests = await requestsTask;
        unread = (await notificationsTask)?.Unread;
        usersCount = (await usersTask)?.Count(u => u.IsActive);

        loading = false;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task ScrollTo(string id)
    {
        activeSection = id;
        await js.InvokeVoidAsync("scrollToSection", id);
    }

    [JSInvokable]
    public void SetActiveSection(string section)
    {
        activeSection = section;
        StateHasChanged();
    }

    public void Dispose() => ThemeService.OnThemeChanged -= Refresh;
}
