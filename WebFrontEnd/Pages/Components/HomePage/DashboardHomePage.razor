<style>
    .custom-tabs {
        border-bottom: none;
        cursor: pointer
    }

        .custom-tabs .nav-link {
            border: none;
            color: #333;
            font-weight: 500;
            padding: 10px 15px;
        }

            .custom-tabs .nav-link.active {
                border-bottom: 3px solid #0d6efd;
                color: #0d6efd;
                background: transparent;
            }

    .top-menu {
        z-index: 1000;
        border-bottom: 1px solid #dee2e6;
    }

    .custom-tile {
        height: 180px;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.08);
    }

    /* Icon box */
    .icon-box {
        width: 25px;
        height: 25px;
        border-radius: 10px;
        background: #f4f6f9;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .icon-box i {
            font-size: 20px;
            color: #6c757d;
        }

    /* Value */
    .value-link {
        font-size: 28px;
        font-weight: 600;
        text-decoration: none;
        color: #0d6efd;
    }

    /* Status */
    .status-open {
        color: #0d6efd;
        font-weight: 500;
    }

</style>


@code {
    private string activeSection = "home";
    private GetCountDto getCountDto = new();
    private string CardCode = string.Empty;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("registerScrollSpy",
                DotNetObjectReference.Create(this));
        }
    }

    protected override async Task OnInitializedAsync()
    {

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        CardCode = user.GetCardCode();
      
        getCountDto = await DashboardService.GetCountOrderAsync(CardCode, "");
        PageState.SetTitle(LanGeneral["homePageTitle"]);
        ThemeService.OnThemeChanged += Refresh;
    }
    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }
    private async Task ScrollTo(string id)
    {
        activeSection = id;
        await js.InvokeVoidAsync("scrollToSection", id);
    }

    [JSInvokable]
    public void SetActiveSection(string section)
    {
        activeSection = section;
        StateHasChanged();
    }
    public void Dispose()
    {
        ThemeService.OnThemeChanged -= Refresh;
    }
}
