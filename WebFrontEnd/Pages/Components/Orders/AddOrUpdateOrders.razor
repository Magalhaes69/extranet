    private void ApplyFiltersDynamic()
    {
        try
        {
            var get = filterTax;

            filterTax.DynamicFilters!.RemoveAll(f => f.Field == CurrentField);
            foreach (var f in dynamicFilters)
            {
                f.Field = CurrentField!;
                filterTax.DynamicFilters.Add(f);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        ModalDynamic!.CloseModal();
    }


