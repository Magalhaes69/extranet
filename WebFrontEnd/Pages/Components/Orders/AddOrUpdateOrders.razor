    private void AddFilterDynamic(string? field)
    {
        dynamicFilters.Add(new DynamicFilter { Field = field! });
    }
    private void ApplyFiltersDynamic()
    {
        try
        {
            if (CurrentField.Equals("ItemCode") || CurrentField.Equals("ItemName"))
            {
                Filter.DynamicFilters!.RemoveAll(f => f.Field == CurrentField);

                foreach (var f in dynamicFilters)
                {
                    f.Field = CurrentField!;
                    Filter.DynamicFilters.Add(f);
                }
            }
            else if (CurrentField.Equals("Code") || CurrentField.Equals("Name"))
            {
                filterVat.DynamicFilters!.RemoveAll(f => f.Field == CurrentField);
                foreach (var f in dynamicFilters)
                {
                    f.Field = CurrentField!;
                    filterVat.DynamicFilters.Add(f);
                }
            }
            else if (CurrentField.Equals("WarehouseName") || CurrentField.Equals("WarehouseCode") || CurrentField.Equals("Location"))
            {
                filterWarehouse.DynamicFilters!.RemoveAll(f => f.Field == CurrentField);
                foreach (var f in dynamicFilters)
                {
                    f.Field = CurrentField!;
                    filterWarehouse.DynamicFilters.Add(f);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        ModalDynamic!.CloseModal();
    }
