    private List<SelectItem<OperatorType>> GetOperators(string field)
    {
        var selectedField = AvailableFields.FirstOrDefault(f => f.Name == field);

        if (selectedField == null)
            return new();

        return selectedField.AllowedOperators
            .Select(op => new SelectItem<OperatorType>
            {
                Value = op,
                Text = GetOperatorText(op)
            })
            .ToList();
    }
    private string GetOperatorText(OperatorType op)
    {
        return op switch
        {
            OperatorType.Iqual => "Igual",
            OperatorType.NotIqual => "Diferente",
            OperatorType.GreaterThan => "Maior",
            OperatorType.GreaterThanOrEqual => "Maior ou igual",
            OperatorType.LessThan => "Menor",
            OperatorType.LessThanOrEqual => "Menor ou igual",
            OperatorType.Between => "Intervalo",
            OperatorType.Contains => "Contém",
            OperatorType.StartsWith => "Começa por",
            OperatorType.EndsWith => "Termina com",
            _ => op.ToString()
        };
    }
    private List<SelectItem<string>> GetFieldOption(string field)
    {
        var f = AvailableFields.FirstOrDefault(x => x.Name == field);

        if (f == null)
            return new();

        return new List<SelectItem<string>>
    {
        new SelectItem<string>
        {
            Value = f.Name,
            Text = f.Label
        }
    };
    }
    
    private string RenderFilterTextDynamic(DynamicFilter f)
    {
        codeFilter = LanInva["code"];
        var fieldLabel = AvailableFields
            .FirstOrDefault(x => x.Name == f.Field)?.Label ?? f.Field;

        return f.Operator switch
        {
            OperatorType.Iqual => $"{fieldLabel} = {f.Value1}",
            OperatorType.NotIqual => $"{fieldLabel} ≠ {f.Value1}",
            OperatorType.GreaterThan => $"{fieldLabel} > {f.Value1}",
            OperatorType.GreaterThanOrEqual => $"{fieldLabel} >= {f.Value1}",
            OperatorType.LessThan => $"{fieldLabel} < {f.Value1}",
            OperatorType.LessThanOrEqual => $"{fieldLabel} <= {f.Value1}",

            OperatorType.Between => $"{fieldLabel}: {f.Value1} - {f.Value2}",

            _ => $"{fieldLabel}: {f.Value1}"
        };
    }
    
    private void RemoveFilterDynamic(DynamicFilter item)
    {
        filterTax.DynamicFilters!.Remove(item);



        StateHasChanged();
    }
   
    private string GetNameOfField(string? field)
    {
        if (string.IsNullOrEmpty(field))
            return string.Empty;

        var selectedField = AvailableFields.FirstOrDefault(f => f.Name == field);

        if (selectedField == null)
            return string.Empty;

        return selectedField.Label;
    }
    private bool RequiresTwoValues(OperatorType op)
    {
        return op == OperatorType.Between;
    }
    private string GetInputType(string field)
    {
        return field switch
        {
            "Code" => "text",
            "Name" => "text",
            _ => "text"
        };
    }
    private bool IsBetween(DynamicFilter f)
    {
        return f.Operator == OperatorType.Between;
    }
