    #region Move Methods
    private List<int> GetSelectedIndexes()
    {
        return orderRequest.DocumentLines
            .Select((line, index) => new { line, index })
            .Where(x => x.line.Selected)
            .Select(x => x.index)
            .ToList();
    }

    private void MoveUp()
    {
        var selectedIndexes = GetSelectedIndexes();

        if(!selectedIndexes.Any() || selectedIndexes.Min() == 0)
        {
            ToastService.ShowWarning(LanGeneral["selectLineToMove"], ThemeService.CurrentTheme);
            return;
        }

        foreach (var index in selectedIndexes.OrderBy(i => i))
        {
            var temp = orderRequest.DocumentLines[index - 1];
            orderRequest.DocumentLines[index - 1] = orderRequest.DocumentLines[index];
            orderRequest.DocumentLines[index] = temp;
        }
        ReorderLines();
        StateHasChanged();

    }

    private void MoveDown()
    {
        var indexes = GetSelectedIndexes();

        if(!indexes.Any() || indexes.Max() == orderRequest.DocumentLines.Count - 1)
        {
            ToastService.ShowWarning(LanGeneral["selectLineToMove"], ThemeService.CurrentTheme);
            return;
        }

        foreach (var index in indexes.OrderByDescending(i => i))
        {
            var temp = orderRequest.DocumentLines[index + 1];
            orderRequest.DocumentLines[index + 1] = orderRequest.DocumentLines[index];
            orderRequest.DocumentLines[index] = temp;
        }
        ReorderLines();
        StateHasChanged();
    }
