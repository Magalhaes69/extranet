    private List<SelectItem<OperatorType>> GetOperators(string field)
    {
        var selectedField = AvailableFields.FirstOrDefault(f => f.Name == field);

        if (selectedField == null)
            return new();

        return selectedField.AllowedOperators
            .Select(op => new SelectItem<OperatorType>
            {
                Value = op,
                Text = GetOperatorText(op)
            })
            .ToList();
    }
    private string GetOperatorText(OperatorType op)
    {
        return op switch
        {
            OperatorType.Iqual => "Igual",
            OperatorType.NotIqual => "Diferente",
            OperatorType.GreaterThan => "Maior",
            OperatorType.GreaterThanOrEqual => "Maior ou igual",
            OperatorType.LessThan => "Menor",
            OperatorType.LessThanOrEqual => "Menor ou igual",
            OperatorType.Between => "Intervalo",
            OperatorType.Contains => "Contém",
            OperatorType.StartsWith => "Começa por",
            OperatorType.EndsWith => "Termina com",
            _ => op.ToString()
        };
    }
    private List<SelectItem<string>> GetFieldOption(string field)
    {
        var f = AvailableFields.FirstOrDefault(x => x.Name == field);

        if (f == null)
            return new();

        return new List<SelectItem<string>>
    {
        new SelectItem<string>
        {
            Value = f.Name,
            Text = f.Label
        }
    };
    }
    private void OpenCodeModal()
    {
        CurrentField = "Code";

        dynamicFilters = (filterTax.DynamicFilters ?? Enumerable.Empty<DynamicFilter>())
        .Where(f => f.Field == CurrentField)
            .Select(f => new DynamicFilter
            {
                Field = f.Field,
                Operator = f.Operator,
                Value1 = f.Value1,
                Value2 = f.Value2,
                Logic = f.Logic
            })
            .ToList();

        if (!dynamicFilters.Any())
            dynamicFilters.Add(new DynamicFilter { Field = CurrentField });

        ShowCodeDropdown = false;
        ModalDynamic!.Show();
    }

    private void OpenNameModal()
    {
