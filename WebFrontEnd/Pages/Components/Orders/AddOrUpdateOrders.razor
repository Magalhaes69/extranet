    private void ReorderLines()
    {
        for (int i = 0; i < orderRequest.DocumentLines.Count; i++)
        {
            orderRequest.DocumentLines[i].Line = i + 1;
        }
    }
    private void RemoveSelectedLines()
    {
        if(orderRequest.DocumentLines.Where(x => x.Selected).Any())
            ConfirmModalRef.Show();
        else
            ToastService.ShowWarning(LanGeneral["selectLineToRemove"], ThemeService.CurrentTheme);

    }
    private void Remove()
    {
        orderRequest.DocumentLines = orderRequest.DocumentLines.Where(l => !l.Selected).ToList();
        ReorderLines();
        EnsureEmptyLine();
        ConfirmModalRef.Hide();
    }
    private void ToggleAllLines()
    {
        bool allSelected = orderRequest.DocumentLines.All(l => l.Selected);
        foreach (var line in orderRequest.DocumentLines)
        {
            line.Selected = !allSelected;
        }
    }
    private async Task HandleSaveOrder()
    {
        ToastService.ShowSaveButton = false;
        ToastService.ShowBusyButton = true;

        try
        {
            var response = await OrderService.CreateAsync(orderRequest);

            if (response.Flag)
            {
                ToastService.ShowSuccess(LanGeneral["successMessage"], ThemeService.CurrentTheme);
                var docEntry = response.DocEntry;
                // e.g. NavigationManager.NavigateTo($"/orders/{docEntry}");
            }
            else
            {
                var message = string.IsNullOrWhiteSpace(response.Message)
                    ? LanGeneral["errorMessage"]
                    : response.Message; // SAP's text, e.g. "Item is inactive [RDR1.ItemCode][line: 1]"

                ToastService.ShowError(message, ThemeService.CurrentTheme);
            }
        }
        finally
        {
            ToastService.ShowSaveButton = true;
            ToastService.ShowBusyButton = false;
        }
    }
    private bool IsLineEmpty(OrderLineDto line)
    {
        return string.IsNullOrEmpty(line.ItemCode) && string.IsNullOrEmpty(line.ItemDescription);
    }

    private void EnsureEmptyLine()
    {
        if (!orderRequest.DocumentLines.Any() || !IsLineEmpty(orderRequest.DocumentLines.Last()))
        {
            orderRequest.DocumentLines.Add(new OrderLineDto()
            {
                Quantity = 1
            });

            ReorderLines();
            return;
        }

        var lastline = orderRequest.DocumentLines.Last();
        if (!IsLineEmpty(lastline))
        {
            orderRequest.DocumentLines.Add(new OrderLineDto());
        }

        ReorderLines();
    }
    private async Task LoadBusinessPartners()
    {
        IsLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            CardCode = authState.User.GetCardCode();
            CardType = "cCustomer";

            var getBus = await BusinessPartnersService.GetBusinessPartnersAsync(CardCode, CardType, true);
            if (getBus is null)
                return; // or show a "business partner not found" message

            orderRequest.CardCode = getBus.CardCode;
            orderRequest.CardName = getBus.CardName ?? string.Empty;
            orderRequest.Address = getBus.BilltoDefault ?? getBus.Address;
            orderRequest.MailAddress = getBus.MailAddress;
            orderRequest.MailZipCode = getBus.MailZipCode;
            orderRequest.Phone1 = getBus.Phone1;
            orderRequest.Phone2 = getBus.Phone2;
            orderRequest.Fax = getBus.Fax;
            orderRequest.CreditLimit = getBus.CreditLimit;
            orderRequest.PriceListNum = getBus.PriceListNum;
            TPriceBusiness = getBus.PriceListNum;
            orderRequest.DocDate = DateTime.UtcNow;
            orderRequest.TaxDate = DateTime.UtcNow;
            orderRequest.DocDueDate = null;

            orderRequest.DocumentLines.Add(new OrderLineDto { Quantity = 1, Line = 1 });

            
            contactEmployeesDtos = getBus.ContactEmployees ?? new List<ContactEmployeesDto>();
            allcontactEmployeesDtos = contactEmployeesDtos.ToList();
            orderRequest.CntctCode = contactEmployeesDtos.FirstOrDefault()?.Name ?? string.Empty;

            bPAddresses = getBus.BPAddresses?.ToList() ?? new List<BPAddressesDto>();
        }
        finally
        {
            IsLoading = false; // runs even if something throws
        }
    }

