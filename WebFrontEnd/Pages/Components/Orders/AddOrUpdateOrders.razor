    private void OnItemsSelected(List<ItemsDto> selectedItems)
    {
        if(!selectedItems.Any())
            return;

        var first = selectedItems.First();

        var getPriceLine = first.ItemPrices!.FirstOrDefault(x => x.PriceList == TPriceBusiness);

        CurrentLine.ItemCode = first.ItemCode;
        CurrentLine.ItemDescription = first.ItemName;
        CurrentLine.Quantity = 1;
        CurrentLine.UnitPrice = getPriceLine!.Price ?? 0;
        CurrentLine.LineTotal = CurrentLine.Quantity * CurrentLine.UnitPrice;

        CurrentLine.Currency = getPriceLine!.Currency;

        int insertIndex = CurrentIndex + 1;

        foreach(var item in selectedItems.Skip(1))
        {
            var getPriceLineItem = item.ItemPrices!.FirstOrDefault(x => x.PriceList == TPriceBusiness);
            var newLine = new OrderLineDto
            {
                ItemCode = item.ItemCode,
                ItemDescription = item.ItemName,
                Quantity = 1,
                UnitPrice = getPriceLineItem!.Price ?? 0,
                LineTotal = CurrentLine.Quantity * getPriceLineItem!.Price ?? 0,
                Currency = getPriceLineItem!.Currency
            };
            orderRequest.DocumentLines.Insert(insertIndex, newLine);

            insertIndex++;
        }
        ReorderLines();
        EnsureEmptyLine();
        CloseModalItem();
        StateHasChanged();
    }
