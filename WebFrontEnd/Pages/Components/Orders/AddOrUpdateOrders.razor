@page "/add-orders"
@inject IStringLocalizer<TaxIVAApp> LanInva
@inject IStringLocalizer<ItemInvoiceModal> LanItem
@inject IStringLocalizer<WarehouseApp> LanWarehouse
@inject IStringLocalizer<ContactEmployeesApp> LanContact

@attribute [Authorize]
@implements IDisposable

<!--begin::App Content Header-->
<AppContentHeader Title="@TitleOrder" />
<!--end::App Content Header-->

<div class="app-content">
    <div class="container-fluid">
        <EditForm Model="orderRequest" Enhance OnValidSubmit="HandleSaveOrder">
             <DataAnnotationsValidator />
             <ValidationSummary />

            <div class="card mb-5" >
                <div class="card-body">
                    <div class="row mb-3">

                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["custumerCode"] <span class="text-danger fw-bold">*</span>:</label>
                        <div class="col-sm-4">
                            <InputText class="form-control form-control form-control-sm" @bind-Value="orderRequest.CardCode" disabled />
                        </div>

                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["salesSeries"]:</label>
                        <div class="col-sm-4">
                            <InputNumber class="form-control form-control form-control-sm" @bind-Value="orderRequest.Series" readonly/>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["customerName"]:</label>
                        <div class="col-sm-4">
                            <InputText class="form-control form-control-sm" @bind-Value="orderRequest.CardName" disabled />
                        </div>
                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["launchDate"]</label>
                        <div class="col-sm-4">
                            <InputDate class="form-control form-control-sm" @bind-Value="orderRequest.DocDate" @bind-Value:format="dd/MM/yyyy" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">
                            @LanSales["numAtCard"]:</label>
                        <div class="col-sm-4">
                            <div class="position-relative">
                                <InputText class="form-control form-control-sm" @bind-Value="orderRequest.CntctCode" />

                                <button type="button" @onclick="OpenModalContactEmployees"
                                        class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                        style="border: none; background: transparent;">
                                    <i class="bi bi-copy"></i>
                                </button>

                            </div>
                        </div>
                       
                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["deliveryDate"] <span class="text-danger fw-bold">*</span>:</label>
                        <div class="col-sm-4">
                            <InputDate class="form-control form-control-sm" @bind-Value="orderRequest.DocDueDate" />

                            <div class="text-danger">
                                <ValidationMessage For="@(() => orderRequest.DocDueDate)" />
                            </div>
                        </div>
                    </div>


                    <div class="row mb-3">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["customerRefNo"]:</label>
                        <div class="col-sm-4">
                            <InputText class="form-control form-control-sm" @bind-Value="orderRequest.Referencia" />
                        </div>
                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["documentDate"]:</label>
                        <div class="col-sm-4">
                            <InputDate class="form-control form-control-sm" @bind-Value="orderRequest.TaxDate" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["remarks"]:</label>
                        <div class="col-sm-4">
                            <InputTextArea rows="3" class="form-control form-control-sm" @bind-Value="orderRequest.NumAtCard" />
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="mt-3">@LanSales["contentsTitle"]</h4>
            <div class="card" >
                <div class="card-body">
                    <h6 class="mt-3">@LanSales["preferences"]</h6>

                    <div class="row mb-3">
                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["currency"]: </label>
                        <div class="col-sm-4">
                            <InputText class="form-control form-control-sm" @bind-Value="orderRequest.DocCurrency" />
                        </div>

                        <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["itemserviceType"]:</label>
                        <div class="col-sm-4">
                            <InputSelect id="itemSelect" class="form-select form-select-sm" @bind-Value="orderRequest.DocType">
                                @foreach (var item in docTypeDtos)
                                {
                                    <option value="@item.Code">@item.Description</option>
                                }
                            </InputSelect>
                        </div>
                    </div>


                    <h6 class="mt-3 fw-bold">@LanSales["detailsSubTitle"]</h6>

                    <!-- Top grid options -->
                    <div class="mb-2 d-flex justify-content-start grid-options">
                        <!-- Right aligned icons -->
                        <div class="ms-auto d-flex">
                            <button type="button" class="btn btn-link btn-sm custom-btn text-decoration-none">Criar</button>
                            <button type="button" class="btn btn-link btn-sm custom-btn text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">Copiar para</button>
                            
                            <button type="button" class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"> <i class="fa-solid fa-gear"></i></button>
                            <button type="button" @onclick="RemoveSelectedLines" class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>

                    <div class="row mb-0">
                        <div class="col-sm-12" >
                            <!--Inicio da Tabela-->
                            <div class="table-wrapper">
                                <table class="table table-hover align-middle" id="resizable-table">
                                    <thead class="@(ThemeService.CurrentTheme == "ligth" ? "table-light" : "table-dark") sticky-top">
                                        <tr>
                                            <th scope="col"><input type="checkbox" @bind="AllSelected" @bind:event="oninput"></th>
                                            <th scope="col">#</th>
                                            <th scope="col" style="position: relative;">@LanSales["itemCode"]<div class="resizer"></div></th>
                                            <th scope="col" style="position: relative;">@LanSales["itemDscription"]<div class="resizer"></div></th>
                                            <th class="text-end" scope="col" style="position: relative;">@LanSales["quantity"] <div class="resizer"></div></th>
                                            <th class="text-end" scope="col" style="position: relative;">@LanSales["unitPrice"]</th>
                                            <th class="text-end" scope="col" style="position: relative;">@LanSales["taxCode"]</th>
                                            <th class="text-end" scope="col" style="position: relative;">@LanSales["totalLC"]</th>
                                            <th scope="col" style="position: relative;">@LanSales["whse"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in orderRequest.DocumentLines)
                                        {
                                            <tr>
                                                <td><InputCheckbox @bind-Value="line.Selected" /></td>
                                                <td><label class="col-form-label">@line.Line</label></td>
                                                <td class="">
                                                    <div class="position-relative" style="max-width: 200px;">

                                                        <InputText class="form-control form-control-sm pe-5 w-100" @bind-Value="line.ItemCode" />

                                                        <button type="button"
                                                                class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                                                @onclick="() => OpenModalItems(line)"
                                                                style="border: none; background: transparent;">
                                                            <i class="bi bi-copy"></i>
                                                        </button>

                                                    </div>
                                                </td>
                                                <td><InputText class="form-control form-control-sm  w-100" @bind-Value="line.ItemDescription" /></td>
                                                <td><InputNumber step="0.01" class="form-control form-control-sm  w-100 text-end" @bind-Value="line.Quantity" /></td>
                                                <td><InputText step="0.01" class="form-control form-control-sm  w-100 text-end" @bind-Value="line._UnitPrice" disabled /></td>
                                                <td class="">
                                                    <div class="position-relative" style="max-width: 200px;">

                                                        <InputText class="form-control form-control-sm pe-5 w-100" @bind-Value="line.VatGroup" />

                                                        <button type="button"
                                                                class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                                                @onclick="() => OpenModalVat(line)"
                                                                style="border: none; background: transparent;">
                                                            <i class="bi bi-copy"></i>
                                                        </button>

                                                    </div>
                                                </td>
                                                <td><InputText step="0.01" class="form-control form-control-sm  w-100 text-end" @bind-Value="line._LineTotal" disabled /></td>
                                                <td class="">
                                                    <div class="position-relative" style="max-width: 200px;">

                                                        <InputText class="form-control form-control-sm pe-5 w-100" @bind-Value="line.WarehouseCode" />

                                                        <button type="button"
                                                                class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                                                @onclick="() => OpenModalWarehouses(line)"
                                                                style="border: none; background: transparent;">
                                                            <i class="bi bi-copy"></i>
                                                        </button>

                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row pt-0">
                        <div class="col-md-6">
                        </div>
                        <div class="col-md-6 mt-2">
                            <div class="">
                                <div class="card-header">
                                    <h5 class="card-title mb-0"><b>@LanSales["totalSubtitle"]</b></h5>
                                </div>

                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <span>@LanSales["totalBeforeDiscount"]:</span>
                                        <span>@orderRequest.DocumentLines.Sum(x => x.LineTotal).ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @orderRequest.DocCurrency</span>
                                    </div>

                                    <div class="d-flex justify-content-between mt-2">
                                        <span>@LanSales["discountPercent"]:</span>
                                        <span>0 %</span>
                                        <span>0 @orderRequest.DocCurrency</span>
                                    </div>

                                    <div class="d-flex justify-content-between mt-2">
                                        <span>@LanSales["rounding"]:</span>
                                        <span>0 @orderRequest.DocCurrency</span>
                                    </div>


                                    <div class="d-flex justify-content-between mt-2">
                                        <span>@LanSales["vatSum"]:</span>
                                        <span>0 @orderRequest.DocCurrency</span>
                                    </div>

                                    <hr />

                                    <div class="d-flex justify-content-between">
                                        <strong>@LanSales["docTotal"]:</strong>
                                        <strong>@orderRequest.DocumentLines.Sum(x => x.LineTotal).ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @orderRequest.DocCurrency</strong>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Logistic-->
            <h4 class="mt-3">@LanSales["tabDetailsLogistics"]</h4>
            <div id="logisticaQuotation" style="margin-bottom: 45px">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <h5 class="mb-2 ">@LanSales["bpAddress"]:</h5>
                            <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["addressSummary"]:</label>
                            <div class="col-sm-4">
                                <InputText class="form-control form-control form-control-sm" @bind-Value="orderRequest.Address" disabled="@controlAddNewAddress" />

                                <button class="btn btn-sm py-0 mt-2 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white text-light" : "btn-secondary")" type="button"
                                @onclick="EditAddressToShip">@LanSales["btnNewAddress"]</button>
                            </div>

                            <label for="inputEmail3" class="col-sm-2 col-form-label">@LanSales["addressSummary"]:</label>
                            <div class="col-sm-4">
                                <InputSelect id="itemSelect" class="form-select form-select-sm" @bind-Value="orderRequest.PayToCode">
                                    @foreach (var item in bPAddresses)
                                    {
                                        <option value="@item.AddressName">@item.AddressName</option>
                                    }
                                </InputSelect>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--Fim -->
            <!-- Fixed bottom footer inside wrapper -->
            <div class="position-fixed bottom-0 p-2 @(ThemeService.CurrentTheme == "dark" ? "bg-dark border border-white" : "border bg-light") shadow-sm rounded-1 mb-2"
                 style="z-index:1050; width:calc(100% - 250px); left:200px; right: 15px!important" id="bottom-footer">

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white text-light" : "btn-secondary") rounded-1">@LanGeneral["btnCancel"]</button>
                    @if (ToastService.ShowSaveButton)
                    {
                        <button type="submit" class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white text-light" : "btn-primary") rounded-1">@LanGeneral["btnSave"]</button>
                    }
                    <BusyButtonComponent cssBtn=@($"btn-sm py-0 {GetWarningButtonClass()}")
                                         ShowBusyButton="@ToastService.ShowBusyButton" />
                </div>

            </div>
        </EditForm>
    </div>
</div>
<MessageDialog @ref="MessageDialogService.messageDialog" />
<style>
    .table-scroll-container {
    max-height: 400px;
    overflow-y: auto;
}

    .table-wrapper {
        overflow-x: auto;
        width: 100%;
    }
</style>

@if (IsLoading)
{
    <LoadingPage />
}

@* ======== Modal Items ============= *@
<ModalChooseGlobal TITem="ItemsDto"
    @ref="ModalShowItems"
    TitleModal=@TitleItem
    IsLoding="IsLoading"
    Items="allItemsDtos">
    <FilterHeader>
        <div class="card-body pb-2">
            <div class="row g-3 align-items-end">
                <!-- Filtro por code -->
                <div class="col-md-4">
                    <label class="form-label">@LanItem["itemCode"]:</label>
                    <div class="position-relative">

                        <div class="form-control form-control-sm d-flex align-items-center gap-1 pe-5 filter-input-container">
                            <!-- Scrollable tags -->
                            <div class="d-flex gap-1 flex-nowrap overflow-auto filter-tags">
                                @if (filterTax.DynamicFilters is not null)
                                {
                                    @foreach (var f in filterTax.DynamicFilters!.Where(x => x.Field == "ItemCode"))
                                    {
                                        <span class="badge muilt-tag d-flex align-items-center pointer-filter" @onclick="ToggleItemCoderopdown">
                                            @RenderFilterTextDynamic(f)

                                            <span class="ms-1"
                                                  style="cursor:pointer"
                                                  @onclick:stopPropagation
                                                  @onclick="() => RemoveFilterDynamic(f)">
                                                <i class="bi bi-x-circle"></i>
                                            </span>
                                        </span>
                                    }
                                }
                                <!-- Input -->
                                <input class="border-0 filter-input"
                                       @bind="InputValue"
                                       @onclick="ToggleItemCoderopdown" />
                                @if (ShowItemCodeDropdown)
                                {
                                    <div class="dropdown-filter shadow-sm px-2 @(ThemeService.CurrentTheme == "dark" ? "bg-dark text-light" : "bg-light text-dark") ">

                                        @if (filterTax.DynamicFilters?.Any(x => x.Field == "ItemCode") == true)
                                        {
                                            @foreach (var f in filterTax.DynamicFilters.Where(x => x.Field == "ItemCode"))
                                            {
                                                <div class="dropdown-item @(ThemeService.CurrentTheme == "dark" ? " dropdown-item-dark " : "")  d-flex justify-content-between align-items-center">

                                                    <span>@RenderFilterTextDynamic(f)</span>

                                                    <i class="bi bi-x-circle text-danger"
                                                       style="cursor:pointer"
                                                       @onclick="() => RemoveFilterDynamic(f)">
                                                    </i>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="dropdown-item @(ThemeService.CurrentTheme == "light" ? " text-muted" : "text-light  dropdown-item-dark") ">
                                                @LanGeneral["noFilter"]
                                            </div>
                                        }

                                        <div class="dropdown-divider"></div>

                                        <!-- Open modal -->
                                        <div class="dropdown-item text-primary"
                                             style="cursor:pointer"
                                             @onclick="OpenItemCodeModal">
                                            <i class="bi bi-funnel"></i> @LanGeneral["btnAddFilter"]
                                        </div>

                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Button -->
                        <button type="button"
                                @onclick="OpenItemCodeModal"
                                class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                style="border: none; background: transparent;">
                            <i class="bi bi-filter"></i>
                        </button>
                    </div>
                </div>
                <!--Fim-->
                <!-- Filter by Name -->
                <div class="col-md-4">
                    <label class="form-label">@LanItem["itemDescription"]:</label>
                    <div class="position-relative">

                        <div class="form-control form-control-sm d-flex align-items-center gap-1 pe-5 filter-input-container">
                            <!-- Scrollable tags -->
                            <div class="d-flex gap-1 flex-nowrap overflow-auto filter-tags">
                                @if (filterTax.DynamicFilters is not null)
                                {
                                    @foreach (var f in filterTax.DynamicFilters!.Where(x => x.Field == "ItemName"))
                                    {
                                        <span class="badge muilt-tag d-flex align-items-center pointer-filter" @onclick="ToggleItemNameDropdown">
                                            @RenderFilterTextDynamic(f)

                                            <span class="ms-1"
                                                  style="cursor:pointer"
                                                  @onclick:stopPropagation
                                                  @onclick="() => RemoveFilterDynamic(f)">
                                                <i class="bi bi-x-circle"></i>
                                            </span>
                                        </span>
                                    }
                                }
                                <!-- Input -->
                                <input class="border-0 filter-input"
                                       @bind="InputValue"
                                       @onclick="ToggleItemNameDropdown" />
                                @if (ShowNameDropdown)
                                {
                                    <div class="dropdown-filter shadow-sm px-2 @(ThemeService.CurrentTheme == "dark" ? "bg-dark text-light" : "bg-light text-dark") ">

                                        @if (filterTax.DynamicFilters?.Any(x => x.Field == "ItemName") == true)
                                        {
                                            @foreach (var f in filterTax.DynamicFilters.Where(x => x.Field == "ItemName"))
                                            {
                                                <div class="dropdown-item @(ThemeService.CurrentTheme == "dark" ? " dropdown-item-dark " : "")  d-flex justify-content-between align-items-center">

                                                    <span>@RenderFilterTextDynamic(f)</span>

                                                    <i class="bi bi-x-circle text-danger"
                                                       style="cursor:pointer"
                                                       @onclick="() => RemoveFilterDynamic(f)">
                                                    </i>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="dropdown-item @(ThemeService.CurrentTheme == "light" ? " text-muted" : "text-light  dropdown-item-dark") ">
                                                @LanGeneral["noFilter"]
                                            </div>
                                        }

                                        <div class="dropdown-divider"></div>

                                        <!-- Open modal -->
                                        <div class="dropdown-item text-primary"
                                             style="cursor:pointer"
                                             @onclick="OpenItemNameModal">
                                            <i class="bi bi-funnel"></i> @LanGeneral["btnAddFilter"]
                                        </div>

                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Button -->
                        <button type="button"
                                @onclick="OpenItemNameModal"
                                class="btn position-absolute top-50 end-0 translate-middle-y me-1 p-1"
                                style="border: none; background: transparent;">
                            <i class="bi bi-filter"></i>
                        </button>
                    </div>
                </div>
                <!--Fim-->
                <div class="col-md-1">
                    <button class="btn btn-sm  @(ThemeService.CurrentTheme == "light" ? "btn-primary" : "btn-outline-light border border-white")"
                            @onclick="getFilterItems">
                        @LanGeneral["btnOkFilterModal"]
                    </button>
                </div>
            </div>
        </div>
    </FilterHeader>

    <Options>
        <GridOptionsComponent>
            <TotalFacturas>
                @TitleItem (@allItemsDtos.Count())
            </TotalFacturas>

            <ButtonOptions>
                <button class="btn btn-icon @(ThemeService.CurrentTheme == "light" ? "btn-link" : "btn-outline-light border border-white") btn-sm text-decoration-none"><i class="fa-solid fa-gear"></i></button>
            </ButtonOptions>
        </GridOptionsComponent>
    </Options>

    <Header>
    <tr>
        <th scope="col"><input type="checkbox" @bind="AllSelectedItem" @bind:event="oninput"></th>
        <th scope="col">@LanItem["itemCode"]</th>
        <th scope="col">@LanItem["itemDescription"]</th>
        <th class="text-end" scope="col">@LanItem["itemStock"]</th>
        <th class="text-end" scope="col">@LanItem["itemPrice"]</th>
        <th scope="col">@LanItem["itemGroup"]</th>
    </tr>
    </Header>

    <RowTemplate Context="items">
        <tr>
            <td><InputCheckbox @bind-Value="items.Selected" /></td>
            <td style="cursor:pointer" @onclick="() => ToggleRowItem(items)">@items.ItemCode</td>
            <td style="cursor:pointer" @onclick="() => ToggleRowItem(items)">@items.ItemName</td>
            <td class="text-end" style="cursor:pointer" @onclick="() => ToggleRowItem(items)">@items.Quatity</td>
            <td class="text-end" style="cursor:pointer" @onclick="() => ToggleRowItem(items)">@items.ItemPrices!.FirstOrDefault(x => x.PriceList == TPriceBusiness)?.Price?.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @items.ItemPrices!.FirstOrDefault(x => x.PriceList == 1)?.Currency</td>
            <td>@items.ItemsGroupCode</td>
        </tr>
    </RowTemplate>

    <LoadingTemplate>
        <LoadingPage />
    </LoadingTemplate>
    <Footer>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-primary border border-white text-white" : "btn-secondary") rounded-1"
                @onclick="CloseModalItem">Fechar</button>
        <button class="btn btn-sm py-0 rounded-1 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-primary border border-white text-white" : "btn-select-modal")"
                @onclick="() => OnItemsSelected(itemsDtos.Where(i => i.Selected).ToList())"> Selecionar </button>
    </Footer>
</ModalChooseGlobal>
@* ========= Fim modal items ============ *@

@* ========= Modal Vat Groups ============= *@
<ModalChooseGlobal TITem="VatGroupsDto"
                   @ref="ModalShowIva"
                   TitleModal=@TitleIva
                   IsLoding="IsLoading"
                   Items="allVatGroupDto">

    <FilterHeader>
        <div class="card-body pb-2">
            <div class="row g-3 align-items-end">
                <!-- Filtro por code -->
                <div class="col-md-4">
                    <label class="form-label">@LanInva["code"]:</label>
                    <div class="position-relative">

                        <div class="form-control form-control-sm d-flex align-items-center gap-1 pe-5 filter-input-container">
                            <!-- Scrollable tags -->
                            <div class="d-flex gap-1 flex-nowrap overflow-auto filter-tags">
                                @if (filterTax.DynamicFilters is not null)
                                {
                                    @foreach (var f in filterTax.DynamicFilters!.Where(x => x.Field == "Code"))
                                    {
                                        <span class="badge muilt-tag d-flex align-items-center pointer-filter" @onclick="ToggleCodeDropdown">
                                            @RenderFilterTextDynamic(f)

                                            <span class="ms-1"
                                                  style="cursor:pointer"
                                                  @onclick:stopPropagation
                                                  @onclick="() => RemoveFilterDynamic(f)">
                                                <i class="bi bi-x-circle"></i>
                                            </span>
                                        </span>
                                    }
                                }
                                <!-- Input -->
                                <input class="border-0 filter-input"
                                       @bind="InputValue"
                                       @onclick="ToggleCodeDropdown" />
                                @if (ShowCodeDropdown)
                                {
                                    <div class="dropdown-filter shadow-sm px-2 @(ThemeService.CurrentTheme == "dark" ? "bg-dark text-light" : "bg-light text-dark") ">

                                        @if (filterTax.DynamicFilters?.Any(x => x.Field == "Code") == true)
                                        {
                                            @foreach (var f in filterTax.DynamicFilters.Where(x => x.Field == "Code"))
                                            {
                                                <div class="dropdown-item @(ThemeService.CurrentTheme == "dark" ? " dropdown-item-dark " : "")  d-flex justify-content-between align-items-center">

                                                    <span>@RenderFilterTextDynamic(f)</span>

