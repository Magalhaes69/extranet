    #region Modal Items
    // ========================
    // Modal Items
    // ========================
    private string TitleItem = string.Empty;
    private async Task LoadItems()
    {
        IsLoading = true;
        if (itemsDtos.Where(x => x.Selected).Any())
        {
            foreach (var item in itemsDtos.Where(x => x.Selected))
            {
                item.Selected = false;
            }
            StateHasChanged();
        }
        Filter = new GetAllItemsRequest
        {
            Page = 1,
            PageSize = 20,
            Valid = "tYES",
            DynamicFilters = new List<DynamicFilter>()
        };


        var itemsResult = await ItemsService.GetItemsAsync(Filter);
        itemsDtos = itemsResult.Items;
        totalCount = itemsResult.TotalCount;
        HasMore = itemsDtos.Count < totalCount;


        IsLoading = false;
    }
    private async Task OpenModalItems(OrderLineDto line)
    {
        await LoadItems();
        CurrentLine = line;
        CurrentIndex = orderRequest.DocumentLines.IndexOf(line);
        ModalShowItems.ShowModal();
    }
    private void CloseModalItem()
    {
        ModalShowItems.CloseModal();
    }
    private void ToggleRowItem(ItemsDto item)
    {
        item.Selected = !item.Selected;
    }
    private void OnItemsSelected(List<ItemsDto> selectedItems)
    {
        if(!selectedItems.Any())
            return;

        var first = selectedItems.First();

        var getPriceLine = first.ItemPrices!.FirstOrDefault(x => x.PriceList == TPriceBusiness);

        CurrentLine.WarehouseCode = first.DefaultWarehouse!;
        CurrentLine.ItemDescription = first.ItemName;
        CurrentLine.Quantity = 1;
        CurrentLine.UnitPrice = getPriceLine!.Price ?? 0;


        CurrentLine.VatGroup = first.SalesVATGroup!;
        CurrentLine.VatRate = first.Rate ?? 0;
        CurrentLine.Currency = getPriceLine!.Currency;

        CurrentLine.ItemCode = first.ItemCode;

        int insertIndex = CurrentIndex + 1;

        foreach(var item in selectedItems.Skip(1))
        {
            var getPriceLineItem = item.ItemPrices!.FirstOrDefault(x => x.PriceList == TPriceBusiness);
            var newLine = new OrderLineDto
            {
                WarehouseCode = item.DefaultWarehouse!,
                ItemDescription = item.ItemName,
                Quantity = 1,
                UnitPrice = getPriceLineItem!.Price ?? 0,
                LineTotal = CurrentLine.Quantity * getPriceLineItem!.Price ?? 0,
                Currency = getPriceLineItem!.Currency,
                VatGroup = item.SalesVATGroup!,
                VatRate = item.Rate ?? 0,
                ItemCode = item.ItemCode
            };
            orderRequest.DocumentLines.Insert(insertIndex, newLine);

            insertIndex++;
        }
        ReorderLines();
        EnsureEmptyLine();
        CloseModalItem();
        StateHasChanged();
    }

    private async Task LoadMore()
    {
        if (IsLoadingMore || !HasMore)
            return;

        IsLoadingMore = true;

        var nextPage = Filter.Page + 1; //

        var request = new GetAllItemsRequest
        {
            Page = nextPage,
            PageSize = 20,
            Valid = "tYES"
        };

        var result = await ItemsService.GetItemsAsync(request, true);

        if (result.Items == null || result.Items.Count == 0)
        {
            HasMore = false;
        }
        else
        {
            itemsDtos.AddRange(result.Items);
            Filter.Page = nextPage;
            HasMore = itemsDtos.Count < totalCount;
        }

        IsLoadingMore = false;

        StateHasChanged();
    }

