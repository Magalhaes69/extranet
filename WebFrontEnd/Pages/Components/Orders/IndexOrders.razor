@page "/orders"
@attribute [Authorize]
@implements IDisposable

<div class="bg-white mb-4 ">
    <div class="mb-4 position-relative">
        <AppContentHeader Title="Minhas ordens de compra" />

        <div class="app-content">
            <div class="container-fluid">
                <!-- Filter Section -->
                @if (isOpen)
                {
                    <div class="pb-4">
                        <form class="row g-3 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label">Nº do documento</label>
                                <input type="text" class="form-control" placeholder="Nº do documento">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Código do cliente</label>
                                <input type="text" class="form-control" placeholder="Código do cliente">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Nome do cliente</label>
                                <input type="text" class="form-control" placeholder="Nome do cliente">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Data de entrega</label>
                                <input type="date" class="form-control">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select class="form-select">
                                    <option selected>Em aberto</option>
                                    <option>Fechado</option>
                                    <option>Cancelado</option>
                                </select>
                            </div>
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-sm btn-primary">Ir</button>
                            </div>
                        </form>
                    </div>
                }

                <!-- Floating toggle button -->
                <div class="card-floating-btn">
                    <button type="button" class="btn btn-light shadow" @onclick="ToggleCard">
                        <i class="bi @(isOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <GridOptionsComponent>
            <TotalFacturas>
                @DescpTotal (@orders!.Where(x => x.Selected).Count()/@orders!.Count())
            </TotalFacturas>

            <ButtonOptions>
                <a href="/add-orders" class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none @(ThemeService.CurrentTheme == "dark" ? "btn-outline-primary border border-white text-light" : "")">
                    @LanGeneral["btnCreateNew"]
                 </a>

                <button class="btn btn-link btn-sm custom-btn text-decoration-none dropdown-toggle  @(ThemeService.CurrentTheme == "dark" ? "btn-outline-primary border border-white text-light" : "")"
                        data-bs-toggle="dropdown" disabled="@(!orders!.Any(s => s.Selected))">
                    @LanGeneral["preview"]
                </button>
                <ul class="dropdown-menu @(ThemeService.CurrentTheme == "dark" ? " dropdown-dark" : "")">
                    <li>
                        <a class="dropdown-item" href="https://localhost:7118/api/Attachments2/getattachment?AbsoluteEntry=223">
                            @LanGeneral["preview"]
                        </a>
                    </li>
                </ul>
                <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-gear"></i></button>
                <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-table-cells"></i></button>
                <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-chart-column"></i></button>
                <button class="btn btn-icon btn-link btn-sm custom-btn text-decoration-none"><i class="fa-solid fa-list"></i></button>
            </ButtonOptions>
        </GridOptionsComponent>


        <!-- Table -->
        <AppTableComponent TItem="OrderViewDto"
                           Items="orders"
                           IsLoading="isLoading"
                           ColumnCount="10">

            <Header>
            <tr>
                <th><input type="checkbox" @bind="AllSelected" @bind:event="oninput"></th>
                <th>@LanSales["docmentNo"]</th>
                <th>@LanSales["custumerCode"]</th>
                <th>@LanSales["customerName"]</th>
                <th> @LanSales["reference"]</th>
                <th class="text-end">@LanSales["launchDate"]</th>
                <th class="text-end"> @LanSales["validUntil"]</th>
                <th class="text-end">@LanSales["totalLine"]</th>
                <th>@LanSales["ststusLine"]</th>
                <th class="text-end">@LanSales["actions"]</th>
            </tr>
            </Header>

            <RowTemplate Context="item">
                <tr>
                    <td><InputCheckbox @bind-Value="item.Selected" /></td>

                    <td>@item.DocNum</td>

                    <td>
                        <a href="#" class="customer-link">
                            <i class="bi bi-chevron-right"></i> @item.CardCode
                        </a>
                    </td>

                    <td>@item.CardName</td>
                    <td>@item.Reference1</td>

                    <td class="text-end">
                        @(item.DocDate.ToString("dd/MM/yyyy"))
                    </td>

                    <td class="text-end">
                        @(item.DocDueDate.ToString("dd/MM/yyyy"))
                    </td>

                    <td class="text-end">
                        @(item.DocTotal.ToString("N2", new System.Globalization.CultureInfo("pt-PT"))) @item.DocCurrency
                    </td>

                    <td>
                        @UiConverters.ToDocStatus(item.DocumentStatus!, item.Cancelled!)
                    </td>

                    <td class="text-end">
                        <button class="btn btn-sm custom-btn"
                                @onclick="() => SelectOrders(item)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </td>
                </tr>
            </RowTemplate>

            <Footer>
            <tr>
                <td colspan="7" class="text-end">@LanSales["totalGrid"]</td>
                <td class="text-end">
                    @total.ToString("N2", new System.Globalization.CultureInfo("pt-PT")) @orders?.FirstOrDefault()?.DocCurrency
                </td>
            </tr>
            </Footer>

            <LoadingTemplate>
                <LoadingPage />
            </LoadingTemplate>

            <EmptyTemplate>
                @LanSales["noRegister"]
            </EmptyTemplate>

        </AppTableComponent>
    </div>
</div>


@code {
    List<OrderViewDto>? orders = new();
    private bool isOpen = true;
    private decimal total;
    private bool isLoading;
    private string CardCode = string.Empty;
    private bool isCollapsed = true;
    private string DescpTotal = default!;
    private bool AllSelected
    {
        get => orders!.All(l => l.Selected);
        set
        {
            foreach (var line in orders!)
            {
                line.Selected = value;
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("layoutHelper.toggleSidebar", isCollapsed);
            await js.InvokeVoidAsync("preventDropdownClose");

            ThemeService.OnThemeChanged += StateHasChanged;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        DescpTotal = LanSales["descriptionTotOrder"];
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        CardCode = user.GetCardCode();
        isLoading = true;
        orders = await OrderService.GetOrdersAsync(CardCode);
        total = orders.Sum(x => x.DocTotal);

        isLoading = false;
    }

    private async Task Refresh()
    {
        orders = await OrderService.GetOrdersAsync(CardCode, true);
    }

    private void ToggleCard()
    {
        isOpen = !isOpen;
    }

    private void Recalculate()
    {
        total = orders?.Sum(x => x.DocTotal) ?? 0;
    }

    private void SelectOrders(OrderViewDto item)
    {
        nav.NavigateTo($"/orders-details/{item.DocEntry}");
    }



    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

}
