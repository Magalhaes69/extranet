        }
        nav.NavigateTo($"/invoices-details/{selectedInvoiceId}");
        await Task.CompletedTask;
    }

    private async Task ShowDetails(ElementReference element, int docEntry)
    {
        selectedInvoiceId = docEntry;

       // invoicesDto = await InvoicesService.GetByDocEntryInvoicesAsync(CardCode, selectedInvoiceId);

        var pos = await js.InvokeAsync<DomRect>("getElementPosition", element);

        showDetailsModal = true;
        await Task.Yield();
        if (pos is null)
        {
            return;
        }
        const double modalWidth = 320; // Set the width of the modal
        const double modalHeight = 300; // Set the height of the modal

        double viewportHeight = await js.InvokeAsync<double>("getWindowHeight");
        modalLeft = pos.Left + 5;
        modalTop = pos.Top;

        var windowSize = await js.InvokeAsync<WindowSize>("getWindowSize");

        if (modalLeft + modalWidth > windowSize.Width)
        {
            modalLeft = pos.Left - modalWidth - 10; // open left side instead
        }

        // Fix vertical overflow (IMPORTANT)
        if (modalTop + modalHeight > viewportHeight)
        {
            modalTop = viewportHeight - modalHeight - 10; // push upward
        }

        
    }
