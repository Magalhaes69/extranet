@code {
    List<GetAllInvoicesDto>? invoicesDtos = new();
    private bool isOpen = true;
    private decimal total;
    private bool isLoading;
    private string CardCode = string.Empty;
    private bool isCollapsed = true;
    private int DocNum;
    private DateTime? SelectedDate { get; set; }= null;
    private List<string> DocumentStatuses { get; set; } = new();
    List<MultiSelect.OptionItem> Items = new();
    List<MultiSelect.OptionItem> StatusCancelled = new();
    List<string> Cancelled = new();
    private InvoiceRequest Filter = new();
    private bool ShowDocDueDateDropdown = false;
    private bool ShowDocNumDropdown = false;
    private bool ShowDocDateDropdown = false;
    private string Title = default!;
    private string DescpTotal = default!;

    private bool showDetailsModal = false;
    private double modalTop;
    private double modalLeft;
    private int selectedInvoiceId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LayoutState.SetSidebar(true);
            await js.InvokeVoidAsync("preventDropdownClose");

            ThemeService.OnThemeChanged += StateHasChanged;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.SetTitle(LanGeneral["invoiceTitleNavbar"]);
        Title = LanSales["invoices"];
        DescpTotal = LanSales["descriptionTotSelected"];
        PageState.SetTitle(LanGeneral["invoiceTitleNavbar"]);
        Items = new()
        {
           new() { Value = "bost_Open", Text =  LanGeneral["DocStatus_Open"]},
            new() { Value = "bost_Close", Text =  LanGeneral["DocStatus_Closed"] }
        };

        StatusCancelled = new()
        {
           new() { Value = "tNO", Text = LanGeneral["status_No"] },
            new() { Value = "tYES", Text = LanGeneral["status_Yes"] }
        };
        Filter = new InvoiceRequest
        {
            DocumentStatus = new List<string> { "bost_Open" },
            Cancelled = new List<string>(),
            DynamicFilters = new List<DynamicFilter>()
        };

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        CardCode = user.GetCardCode();
        isLoading = true;
        Filter.CardCode = CardCode;

        invoicesDtos = await InvoicesService.GetInvoicesAsync(Filter, false);

        total = invoicesDtos.Sum(x => x.DocTotal ?? 0);

        isLoading = false;
    }

    private void ToggleCard()
    {
        isOpen = !isOpen;
    }

    private void Recalculate()
    {
        total = invoicesDtos?.Sum(x => x.DocTotal) ?? 0;
    }


    private void SelectInvoices(GetAllInvoicesDto item)
    {
        nav.NavigateTo($"/invoices-details/{item.DocEntry}");
    }

    private async Task ExecuteFilter()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            CardCode = user.GetCardCode();
            isLoading = true;

            invoicesDtos = await InvoicesService.GetInvoicesAsync(Filter, true);


            total = invoicesDtos.Sum(x => x.DocTotal ?? 0);

            isLoading = false;
        }
        catch
        {

        }
    }

    public void OnDocumentStatusesChanged(List<string> selectedValues)
    {
        Filter.DocumentStatus = selectedValues;
    }

    public void OnCancelledStatusesChanged(List<string> selectedValues)
    {
        Filter.Cancelled = selectedValues;
    }

    private bool AllSelected
    {
        get => invoicesDtos!.All(l => l.SelectedInvoices);
        set
        {
            foreach (var line in invoicesDtos!)
            {
                line.SelectedInvoices = value;
            }
        }
    }

    private void OnDateChanged()
    {
        // This method can be used to trigger any additional logic when the date changes, if necessary.

    }
    private ModelToFilter<DynamicFilter>? ModalDynamic;

    private string? SelectedValue;
    private string? InputValue;
    private List<SelectItem<OperatorType>> OperatorNumber = new()
    {
        new SelectItem<OperatorType> { Value = OperatorType.Iqual, Text = "Igual a" },
        new SelectItem<OperatorType> { Value = OperatorType.NotIqual, Text = "Não Igual a" },
        new SelectItem<OperatorType> { Value = OperatorType.Between, Text = "No intervalo" },
        new SelectItem<OperatorType> { Value = OperatorType.LessThan, Text = "Menor que" },
        new SelectItem<OperatorType> { Value = OperatorType.LessThanOrEqual, Text = "Menor do que ou igual a" },
        new SelectItem<OperatorType> { Value = OperatorType.GreaterThan, Text = "Maior que" },
        new SelectItem<OperatorType> { Value = OperatorType.GreaterThanOrEqual, Text = "Maior do que ou igual a" },
    };


    private string? CurrentField;
    private List<DynamicFilter> dynamicFilters = new()
        {
            new DynamicFilter()
        };
    private List<FilterField> AvailableFields = new()
    {
        new()
        {
            Name = "DocNum",
            Label = "Nº Documento",
            DataType = typeof(int),
            AllowedOperators = new()
            {
                OperatorType.Iqual,
                OperatorType.NotIqual,
                OperatorType.GreaterThan,
                OperatorType.GreaterThanOrEqual,
                OperatorType.LessThan,
                OperatorType.LessThanOrEqual,
                OperatorType.Between
            }
        },
        new()
        {
            Name = "DocDueDate",
            Label = "Válido até",
            DataType = typeof(DateTime),
            AllowedOperators = new()
            {
                OperatorType.Iqual,
                OperatorType.Between
            }
        },
        new()
        {
