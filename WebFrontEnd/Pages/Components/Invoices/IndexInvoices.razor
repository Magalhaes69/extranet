<ModelToFilter TITem="DynamicFilter"
               @ref="ModalDynamic"
               Title="@GetNameOfField(CurrentField)"
               ITems="@dynamicFilters">

    <Rows Context="item">
        <div class="d-flex gap-2 mb-2">

            <!-- Field -->
            <CustomSelect TItem="string"
                          Items="GetFieldOption(CurrentField!)"
                          @bind-SelectedValue="item.Field" />

            <!-- Operator -->
            <CustomSelect TItem="OperatorType"
                          Items="GetOperators(CurrentField!)"
                          @bind-SelectedValue="item.Operator" />

            <!-- Value -->
            @if (RequiresTwoValues(item.Operator))
            {
               
                    <input type="@GetInputType(item.Field)"
                           class="form-control"
                           @bind="item.Value1" />


                    <input type="@GetInputType(item.Field)"
                           class="form-control"
                           @bind="item.Value2" />
                
            }
            else
            {
   
                <input type="@GetInputType(item.Field)"
                       class="form-control"
                    @bind="item.Value1" />

              
            }

            <!-- Logic -->
           @*  <CustomSelect TItem="LogicalOperator"
                          Items="LogicOptions"
                          @bind-SelectedValue="item.Logic" /> *@

            <!-- Remove -->
            <button class="btn btn-sm"
                    @onclick="() => RemoveFilterOnDynamic(item)">
                <i class="bi bi-x-circle"></i>
            </button>
        </div>
    </Rows>

    <AddButton>
        <button class="btn btn-sm py-0  @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-success")" @onclick="() => AddFilterDynamic(CurrentField)">
            @LanGeneral["btnAddFilter"]
        </button>
    </AddButton>

    <Footer>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-secondary") rounded-1" @onclick="CloseModalDynamic">@LanGeneral["btnClose"]</button>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? " btn-outline-light border border-white" : "btn-outline-primary") rounded-1" @onclick="ApplyFiltersDynamic">@LanGeneral["btnOkFilter"]</button>
    </Footer>

</ModelToFilter>

@* ======== Modal Details ============ *@
<DetailsModal IsVisible="@showDetailsModal"
                     Title="A/R Invoice"
                     Top="modalTop"
                     Left="modalLeft"
                     IsVisibleChanged="@((v) => showDetailsModal = v)"
                     OnViewMore="ViewInvoiceDetails">
    <BodyDetails>
        <div class="field-label">@LanSales["docmentNo"]:</div>
        <div class="field-value"></div>

        <div class="field-label">@LanSales["custumerCode"]:</div>
        <div class="field-value"></div>

        <div class="field-label">@LanSales["customerName"]:</div>
        <div class="field-value"></div>

        <div class="field-label">@LanSales["launchDate"]:</div>
        <div class="field-value"></div>

        <div class="field-label">@LanSales["validUntil"]:</div>
        <div class="field-value"></div>

        <div class="field-label">@LanSales["ststusLine"]:</div>
        <div class="field-value"></div>

        <div class="field-label">@LanSales["docTotal"]:</div>
        <div class="field-value text-end"></div>
    </BodyDetails>
    <Footer>
        <button class="btn btn-sm py-0 @(ThemeService.CurrentTheme == "dark" ? "btn-outline-light border border-white" : "btn-outline-primary")" @onclick="ViewInvoiceDetails">
            View More
        </button>
    </Footer>

</DetailsModal>
